<style>
:root {
  --gold: #A37729;
  --gold-light: #c49535;
  --cta-blue: #0071e3;
  --cta-blue-light: #0077ed;
  --gold-tint: rgba(163,119,41,.1);
  --text: #1d1d1f;
  --text-sub: #6e6e73;
  --bg-white: #ffffff;
  --bg-gray: #f5f5f7;
  --bg-dark: #1d1d1f;
  --bg-darkest: #0a0a0f;
  --line: #e5e5e7;
  --shadow-soft: 0 2px 20px rgba(0,0,0,.06);
}
.lp-wrapper .icon-badge {
  width: 40px; height: 40px; border-radius: 11px; background: var(--gold-tint);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.lp-wrapper .icon-badge svg { width: 20px; height: 20px; stroke: var(--gold); fill: none; }
.lp-wrapper .icon-badge.on-dark { background: rgba(255,255,255,.08); }
.lp-wrapper .icon-badge.on-dark svg { stroke: #fff; }
.lp-wrapper .stat-figure { font-weight: 800; letter-spacing: -0.035em; }
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
.lp-wrapper { scroll-behavior: smooth; overflow-x: hidden; }
.lp-wrapper {
  font-family: Helvetica, Arial, "Hiragino Sans", "Yu Gothic", sans-serif;
  color: var(--text); font-size: 17px; line-height: 1.8; overflow-x: hidden;
  background: var(--bg-white);
}
.lp-wrapper img { max-width: 100%; height: auto; display: block; }
.lp-wrapper a { color: inherit; text-decoration: none; }
.lp-wrapper section { width: 100%; position: relative; }
.lp-wrapper .container { max-width: 1520px; margin: 0 auto; padding: 0 64px; }
.lp-wrapper .section-padding { padding: 100px 0; }
/* 見出しは常にコンテナの色を継承（Shopifyテーマの h1{color:#1d1d1f} 等の直接指定に負けて黒くなるのを防ぐ） */
.lp-wrapper h1, .lp-wrapper h2, .lp-wrapper h3, .lp-wrapper h4, .lp-wrapper h5, .lp-wrapper h6 { color: inherit; }
.lp-wrapper h2.section-title { font-size: 36px; font-weight: 700; line-height: 1.4; letter-spacing: -0.01em; margin-bottom: 20px; }
.lp-wrapper h3.block-title { font-size: clamp(28px, 4.2vw, 46px); font-weight: 700; line-height: 1.4; letter-spacing: -0.02em; margin-bottom: 22px; }
.lp-wrapper p.lead { font-size: 17px; line-height: 2; color: var(--text-sub); margin-bottom: 16px; }
.lp-wrapper .eyebrow-label { display: inline-block; font-size: 16px; font-weight: 700; letter-spacing: 0.12em; color: var(--gold); margin-bottom: 14px; }
@media (max-width: 768px) {
  .lp-wrapper { font-size: 16px; }
  .lp-wrapper .container { padding: 0 20px; }
  .lp-wrapper .section-padding { padding: 64px 0; }
  .lp-wrapper h2.section-title { font-size: 26px; }
  .lp-wrapper h3.block-title { font-size: 21px; }
}

/* ===== アニメーション ===== */
.lp-wrapper .fade-in { opacity: 0; transform: translateY(24px); transition: opacity .6s ease, transform .6s ease; }
.lp-wrapper .fade-in.visible { opacity: 1; transform: translateY(0); }
.lp-wrapper .slide-left { opacity: 0; transform: translateX(-48px); transition: opacity .8s ease, transform .8s ease; }
.lp-wrapper .slide-right { opacity: 0; transform: translateX(48px);  transition: opacity .8s ease, transform .8s ease; }
.lp-wrapper .slide-up { opacity: 0; transform: translateY(32px);  transition: opacity .7s ease, transform .7s ease; }
.lp-wrapper .slide-left.visible, .lp-wrapper .slide-right.visible, .lp-wrapper .slide-up.visible { opacity: 1; transform: none; }
.lp-wrapper .delay-1 { transition-delay: .1s; }
.lp-wrapper .delay-2 { transition-delay: .2s; }
.lp-wrapper .delay-3 { transition-delay: .32s; }
.lp-wrapper .delay-4 { transition-delay: .44s; }

/* ===== ボタン ===== */
.lp-wrapper .btn-primary {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--cta-blue); color: #fff;
  font-size: 18px; font-weight: 700; padding: 18px 40px;
  border-radius: 50px; cursor: pointer;
  transition: background .2s, transform .1s;
  border: none; letter-spacing: 0.02em;
}
.lp-wrapper .btn-primary:hover { background: var(--cta-blue-light); transform: translateY(-1px); }
.lp-wrapper .btn-secondary {
  display: inline-block; color: var(--gold); font-size: 15px; font-weight: 500;
  margin-top: 16px; border-bottom: 1px solid currentColor; padding-bottom: 2px;
}

/* ===== ヒーロー ===== */
.lp-wrapper .hero { height: 100vh; min-height: 640px; display: flex; align-items: flex-end; overflow: hidden; }
.lp-wrapper .hero-media { position: absolute; inset: 0; overflow: hidden; height: 130%; top: -15%; }
.lp-wrapper .hero-media img { width: 100%; height: 100%; object-fit: cover; object-position: center center; }
.lp-wrapper .hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.88) 0%, rgba(0,0,0,.35) 55%, rgba(0,0,0,.2) 100%);
}
.lp-wrapper .hero-content { position: relative; z-index: 2; color: #fff; padding-bottom: 120px; padding-top: 160px; }
.lp-wrapper .hero-content .eyebrow-label { color: #f0d9a8; }
.lp-wrapper .hero-content h1 {
  color: #fff;
  font-size: clamp(32px, 5.2vw, 58px); font-weight: 700; line-height: 1.4; letter-spacing: -0.02em; margin-bottom: 22px;
}
.lp-wrapper .hero-content .subheadline { font-size: clamp(16px, 2vw, 20px); line-height: 1.9; color: rgba(255,255,255,.9); margin-bottom: 32px; max-width: 560px; }
.lp-wrapper .hero-social-proof { display: flex; align-items: center; gap: 8px; margin-top: 16px; color: #fff; font-size: 14px; }
.lp-wrapper .hero-social-proof .stars { color: #f5c518; letter-spacing: 2px; font-size: 16px; }
.lp-wrapper .hero-cta-sub { font-size: 13px; color: rgba(255,255,255,.7); margin-top: 10px; }
@media (max-width: 768px) {
  .lp-wrapper .hero { min-height: 92vh; }
  .lp-wrapper .hero-content { padding-bottom: 88px; padding-top: 110px; }
}

.lp-wrapper .scroll-hint {
  position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%); z-index: 2;
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  color: rgba(255,255,255,.6); font-size: 10px; letter-spacing: .15em;
  text-transform: uppercase; animation: scroll-bounce 2.2s infinite;
}
.lp-wrapper .scroll-hint svg { width: 20px; height: 20px; }
@keyframes scroll-bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); opacity: .55; }
  50%       { transform: translateX(-50%) translateY(8px); opacity: .9; }
}

/* ===== 汎用ブロック（共感・気づき・解決 等） ===== */
.lp-wrapper .content-block { max-width: 820px; margin: 0 auto; }
.lp-wrapper .content-card {
  background: #fff; padding: 36px 40px; border-radius: 22px;
  border: 1px solid var(--line); box-shadow: var(--shadow-soft);
}
.lp-wrapper .content-card p { font-size: 17px; line-height: 2; margin-bottom: 18px; color: var(--text); }
.lp-wrapper .voice {
  background: var(--bg-gray); padding: 18px 24px; border-left: 3px solid var(--gold);
  border-radius: 0 8px 8px 0; margin: 20px 0; font-size: 15px; line-height: 1.9; color: var(--text-sub);
}
.lp-wrapper .bridge { font-weight: 700; color: var(--gold); }
.lp-wrapper .rule-line { width: 48px; height: 3px; background: var(--gold); margin: 22px auto 0; border: none; }

/* ===== 共感ビジュアルバナー（写真＋大見出し） ===== */
.lp-wrapper .empathy-visual { position: relative; overflow: hidden; }
.lp-wrapper .empathy-visual-type {
  background: #0d0d14; min-height: 56vh; display: flex; align-items: center;
}
.lp-wrapper .empathy-visual-inner { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: center; padding-top: 80px; padding-bottom: 80px; }
.lp-wrapper .empathy-visual-quote {
  color: #fff; font-size: clamp(30px, 5.4vw, 68px); font-weight: 800; line-height: 1.4; letter-spacing: -0.03em; max-width: 860px;
}
@media (max-width: 768px) { .lp-wrapper .empathy-visual-type { min-height: 46vh; } }

/* ===== 2カラム（画像＋テキスト） ===== */
.lp-wrapper .two-col-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
.lp-wrapper .two-col-image-wrap { border-radius: 22px; overflow: hidden; }
.lp-wrapper .two-col-image-wrap img { width: 100%; height: 420px; object-fit: cover; display: block; }
@media (max-width: 900px) {
  .lp-wrapper .two-col-inner { grid-template-columns: 1fr; gap: 28px; }
  .lp-wrapper .two-col-image-wrap { order: -1; }
  .lp-wrapper .two-col-image-wrap img { height: 260px; }
}

/* ===== テーブル ===== */
.lp-wrapper table.data-table { width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 14px; }
.lp-wrapper table.data-table th, .lp-wrapper table.data-table td { text-align: left; padding: 14px 12px; border-bottom: 1px solid var(--line); line-height: 1.7; }
.lp-wrapper table.data-table th { font-weight: 700; color: var(--gold); border-bottom: 2px solid var(--gold); background: var(--bg-gray); }
.lp-wrapper table.data-table .sub-note { display: block; font-size: 10px; color: #999; font-weight: 400; margin-top: 3px; }
.lp-wrapper table.data-table.on-dark th, .lp-wrapper table.data-table.on-dark td { border-bottom-color: rgba(255,255,255,.12); color: #fff; }
.lp-wrapper table.data-table.on-dark th { background: rgba(255,255,255,.06); color: var(--gold); border-bottom-color: var(--gold); }
.lp-wrapper table.data-table.on-dark .sub-note { color: rgba(255,255,255,.45); }

/* ===== フルブリード分割レイアウト（image col + text col） ===== */
.lp-wrapper .split-section { display: grid; grid-template-columns: 1fr 1fr; min-height: 560px; }
.lp-wrapper .split-image-col { position: relative; overflow: hidden; min-height: 320px; }
.lp-wrapper .split-image-col img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
.lp-wrapper .split-text-col { padding: 80px 64px; display: flex; flex-direction: column; justify-content: center; }
@media (max-width: 900px) {
  .lp-wrapper .split-section { grid-template-columns: 1fr; min-height: 0; }
  .lp-wrapper .split-image-col { min-height: 280px; }
  .lp-wrapper .split-text-col { padding: 48px 24px; }
}

/* ===== 中間CTA ===== */
.lp-wrapper #sec-cta-mid { background: var(--bg-dark); color: #fff; padding: 72px 0; text-align: center; }
.lp-wrapper #sec-cta-mid .mid-cta-inner { max-width: 560px; margin: 0 auto; }
.lp-wrapper #sec-cta-mid .mid-cta-title { font-size: 26px; font-weight: 700; line-height: 1.5; margin-bottom: 12px; }
.lp-wrapper #sec-cta-mid .mid-cta-sub { font-size: 14px; opacity: .7; margin-bottom: 30px; }
.lp-wrapper #sec-cta-mid .mid-cta-note { font-size: 12px; opacity: .55; margin-top: 12px; }
@media (max-width: 768px) { .lp-wrapper #sec-cta-mid { padding: 56px 0; } }

/* ===== 誰でも使える（ステップ） ===== */
.lp-wrapper .howto-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin: 36px 0; }
.lp-wrapper .howto-step { text-align: center; }
.lp-wrapper .howto-step img { width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 12px; margin-bottom: 14px; }
.lp-wrapper .howto-step .step-num {
  display: inline-flex; align-items: center; justify-content: center;
  width: 26px; height: 26px; border-radius: 50%; background: var(--gold); color: #fff;
  font-size: 13px; font-weight: 700; margin-bottom: 8px;
}
.lp-wrapper .howto-step p { font-size: 14px; color: var(--text-sub); }
@media (max-width: 768px) { .lp-wrapper .howto-steps { grid-template-columns: 1fr; } }

/* ===== これ1台で（フルワイド＋アイコングリッド） ===== */
.lp-wrapper .compatible-hero {
  position: relative; width: 100%; aspect-ratio: 3/2; max-height: 560px; overflow: hidden; margin-bottom: 56px;
}
.lp-wrapper .compatible-hero img { width: 100%; height: 100%; object-fit: cover; object-position: center center; }
.lp-wrapper .compatible-hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,.05) 30%, rgba(0,0,0,.72));
  display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; padding: 40px 48px;
}
.lp-wrapper .compatible-hero-eyebrow { font-size: 13px; font-weight: 600; letter-spacing: .12em; color: rgba(255,255,255,.75); margin-bottom: 10px; }
.lp-wrapper .compatible-hero-text { color: #fff; font-size: clamp(26px, 3.6vw, 38px); font-weight: 700; line-height: 1.4; letter-spacing: -0.02em; }
@media (max-width: 768px) { .lp-wrapper .compatible-hero { aspect-ratio: 4/3; } }

.lp-wrapper .icon-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; margin-bottom: 20px; }
.lp-wrapper .icon-card { background: #fff; border-radius: 20px; padding: 24px 14px; text-align: center; box-shadow: var(--shadow-soft); }
.lp-wrapper .icon-card img { width: 56px; height: 56px; margin: 0 auto 12px; display: block; object-fit: contain; }
.lp-wrapper .icon-card .icon-h { font-size: 14px; font-weight: 700; margin-bottom: 6px; }
.lp-wrapper .icon-card .icon-list { font-size: 11px; color: var(--text-sub); line-height: 1.7; }
@media (max-width: 768px) { .lp-wrapper .icon-grid { grid-template-columns: repeat(2, 1fr); } }

/* ===== 特徴カード（小さい／速さ／電池） ===== */
.lp-wrapper .feature-note { display: block; text-align: center; margin: 24px 0 0; font-size: 13px; color: #999; }

/* ===== まとめ ===== */
.lp-wrapper .summary-block .split-text-col p { font-size: 17px; line-height: 2; margin-bottom: 16px; }

/* ===== 証拠エリア（プロ・専門家・品質） ===== */
.lp-wrapper .authority-sub { margin: 48px 0; }
.lp-wrapper .authority-sub:first-of-type { margin-top: 0; }
.lp-wrapper .authority-sub h4 { font-size: 20px; font-weight: 700; margin-bottom: 14px; color: var(--text); }
.lp-wrapper .authority-sub p { font-size: 15px; line-height: 1.95; color: var(--text-sub); margin-bottom: 10px; }
.lp-wrapper .quality-inset-image { float: right; width: 220px; margin: 4px 0 16px 24px; border-radius: 16px; }
@media (max-width: 640px) { .lp-wrapper .quality-inset-image { float: none; width: 100%; margin: 0 0 16px; } }
.lp-wrapper .medal-row { display: flex; gap: 24px; flex-wrap: wrap; margin: 24px 0; justify-content: center; }
.lp-wrapper .evidence-note { font-size: 11px; color: #999; text-align: right; margin-top: 10px; }
.lp-wrapper .laurel-card-wrap { background: #fff; border-radius: 20px; padding: 24px; display: inline-flex; justify-content: center; box-shadow: var(--shadow-soft); }

/* ===== 正直に音 ===== */
.lp-wrapper .honest-voices { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 28px; }
@media (max-width: 768px) { .lp-wrapper .honest-voices { grid-template-columns: 1fr; } }

/* ===== 10万人（実績） ===== */
.lp-wrapper .stat-label { font-size: 13px; color: rgba(255,255,255,.65); margin-top: 4px; }

/* ===== 実績セクション（10万人）専用グリッド ===== */
.lp-wrapper .proof-scale-grid {
  display: grid; grid-template-columns: 1fr 1fr 1.3fr; gap: 24px; align-items: stretch;
  margin: 56px 0 40px; max-width: 1100px; margin-left: auto; margin-right: auto;
}
.lp-wrapper .proof-scale-stats { display: contents; }
.lp-wrapper .mini-stat-card {
  background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08);
  border-radius: 22px; padding: 32px 28px; text-align: center;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.lp-wrapper .mini-stat-card .icon-badge { margin-bottom: 16px; width: 48px; height: 48px; border-radius: 13px; }
.lp-wrapper .mini-stat-card .icon-badge svg { width: 24px; height: 24px; }
.lp-wrapper .proof-scale-badge {
  background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08);
  border-radius: 22px; padding: 32px 28px; display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.lp-wrapper .proof-scale-badge .laurel-card-wrap { padding: 16px; box-shadow: none; }
@media (max-width: 900px) {
  .lp-wrapper .proof-scale-grid { grid-template-columns: 1fr; }
  .lp-wrapper .proof-scale-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
}
@media (max-width: 560px) { .lp-wrapper .proof-scale-stats { grid-template-columns: 1fr; } }

/* ===== お客様の声 ===== */
.lp-wrapper .testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 32px; }
.lp-wrapper .testi-card { background: #fff; border-radius: 20px; padding: 22px 20px; box-shadow: var(--shadow-soft); }
.lp-wrapper .testi-card .stars { color: var(--gold); font-size: 14px; margin-bottom: 8px; display: block; }
.lp-wrapper .testi-card p { font-size: 14px; line-height: 1.85; color: var(--text); }
@media (max-width: 900px) { .lp-wrapper .testi-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 600px) { .lp-wrapper .testi-grid { grid-template-columns: 1fr; } }

/* ===== 価格 ===== */
.lp-wrapper .pricing-card {
  background: var(--bg-gray); border-radius: 20px; padding: 48px 44px; text-align: center; max-width: 620px; margin: 0 auto 40px;
}
.lp-wrapper .pricing-card .price-num { font-size: clamp(40px, 6vw, 64px); font-weight: 800; letter-spacing: -0.03em; color: var(--text); }
.lp-wrapper .pricing-card .price-num span { font-size: 20px; font-weight: 500; letter-spacing: normal; }
.lp-wrapper .pricing-card .price-note { font-size: 13px; color: var(--text-sub); margin-top: 8px; }
.lp-wrapper .roi-compare { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin: 32px 0; }
.lp-wrapper .roi-compare .roi-card { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 24px; }
.lp-wrapper .roi-compare .roi-card .roi-h { font-size: 14px; font-weight: 700; color: var(--gold); margin-bottom: 8px; }
.lp-wrapper .roi-compare .roi-card .roi-num { font-size: clamp(22px, 2.6vw, 28px); font-weight: 800; letter-spacing: -0.02em; color: var(--gold); margin-bottom: 6px; }
.lp-wrapper .roi-compare .roi-card p { font-size: 13px; color: var(--text-sub); line-height: 1.8; }
@media (max-width: 768px) { .lp-wrapper .roi-compare { grid-template-columns: 1fr; } }

/* ===== 安心3カード ===== */
.lp-wrapper .trust-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 32px; }
.lp-wrapper .trust-card { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 30px 26px; }
.lp-wrapper .trust-card .icon-badge { margin-bottom: 16px; }
.lp-wrapper .trust-card h4 { font-size: 18px; font-weight: 700; margin-bottom: 12px; color: var(--gold); }
.lp-wrapper .trust-card p { font-size: 14px; line-height: 1.9; color: var(--text-sub); }
.lp-wrapper .trust-card ul { margin: 10px 0 0 18px; font-size: 13px; color: var(--text-sub); line-height: 1.9; }
@media (max-width: 900px) { .lp-wrapper .trust-cards { grid-template-columns: 1fr; } }

/* ===== 作り手 ===== */
.lp-wrapper .brand-block { display: grid; grid-template-columns: 220px 1fr; gap: 44px; align-items: flex-start; }
.lp-wrapper .brand-block .brand-photo { border-radius: 20px; overflow: hidden; }
.lp-wrapper .brand-block .brand-photo img { width: 100%; object-fit: cover; aspect-ratio: 1/1; }
.lp-wrapper .brand-block .brand-name { font-size: 14px; font-weight: 700; color: var(--gold); margin-bottom: 4px; }
@media (max-width: 768px) { .lp-wrapper .brand-block { grid-template-columns: 120px 1fr; gap: 24px; } }

/* ===== 最終CTA ===== */
.lp-wrapper .final-cta { position: relative; color: #fff; text-align: center; overflow: hidden; height: 100vh; min-height: 560px; display: flex; align-items: center; }
.lp-wrapper .final-cta-media { position: absolute; inset: 0; overflow: hidden; height: 130%; top: -15%; }
.lp-wrapper .final-cta-media img { width: 100%; height: 100%; object-fit: cover; }
.lp-wrapper .final-cta-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.85) 0%, rgba(0,0,0,.4) 55%, rgba(0,0,0,.25) 100%); }
.lp-wrapper .final-cta-content { position: relative; z-index: 2; padding-top: 120px; padding-bottom: 120px; }
.lp-wrapper .final-cta-content .eyebrow-label { color: #f0d9a8; }
.lp-wrapper .final-cta-content h2 { color: #fff; font-size: clamp(30px, 5vw, 54px); font-weight: 700; line-height: 1.4; letter-spacing: -0.02em; margin: 18px 0 26px; }
.lp-wrapper .final-cta-content .cta-body-text { max-width: 560px; margin: 0 auto 36px; font-size: 16px; line-height: 1.95; color: rgba(255,255,255,.85); }
.lp-wrapper .cta-voice { max-width: 560px; margin: 0 auto 36px; text-align: center; }
.lp-wrapper .cta-voice blockquote {
  font-size: 15px; line-height: 1.8; color: rgba(255,255,255,.85); font-style: italic; margin: 0 0 8px;
  border-left: 2px solid var(--gold); padding-left: 14px; text-align: left;
}
.lp-wrapper .final-cta-content .btn-primary { font-size: 19px; padding: 20px 46px; }
@media (max-width: 768px) {
  .lp-wrapper .final-cta-content { padding-top: 88px; padding-bottom: 88px; }
  .lp-wrapper .final-cta { text-align: left; }
  .lp-wrapper .final-cta-content .cta-body-text { margin: 0 0 36px; }
  .lp-wrapper .cta-voice { margin: 0 0 36px; text-align: left; }
}

/* ===== FAQ（アコーディオン） ===== */
.lp-wrapper .faq-list details {
  background: #fff; border-radius: 14px; margin-bottom: 12px; overflow: hidden; box-shadow: var(--shadow-soft);
}
.lp-wrapper .faq-list summary {
  cursor: pointer; list-style: none; padding: 20px 24px; font-size: 15px; font-weight: 700;
  display: flex; justify-content: space-between; align-items: center; gap: 12px;
}
.lp-wrapper .faq-list summary::-webkit-details-marker { display: none; }
