<!-- ========================================================
     JavaScript
     ======================================================== -->
<script>
(function () {
  var targets = document.querySelectorAll('.slide-left, .slide-right, .slide-up, .fade-in');
  if (!('IntersectionObserver' in window)) {
    targets.forEach(function (el) { el.classList.add('visible'); }); return;
  }
  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.15 });
  targets.forEach(function (el) { obs.observe(el); });
})();
</script>

<script>
(function () {
  if (window.matchMedia('(max-width: 768px)').matches) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var els = Array.prototype.slice.call(document.querySelectorAll('.parallax-bg'));
  var STRENGTH = 40; var ticking = false;
  function update() {
    var vh = window.innerHeight;
    els.forEach(function (img) {
      var section = img.closest('section');
      if (!section) return;
      var rect = section.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > vh) return;
      var offset = (rect.top + rect.height / 2 - vh / 2) / (vh + rect.height) * STRENGTH * 2;
      img.style.transform = 'translateY(' + offset.toFixed(2) + 'px)';
    });
    ticking = false;
  }
  window.addEventListener('scroll', function () {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
  update();
})();
</script>

<script>
(function () {
  var el = document.getElementById('sticky-cta');
  if (!el) return;
  var pastTrigger = false;
  var inFinalCta = false;
  var lastScrollY = window.scrollY;

  function update() {
    var scrollY = window.scrollY;
    var scrollingDown = scrollY > lastScrollY;
    lastScrollY = scrollY;
    if (!pastTrigger || inFinalCta) { el.style.display = 'none'; return; }
    el.style.display = scrollingDown ? 'block' : 'none';
  }

  var trigger = document.getElementById('sec-solution');
  if (trigger && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting && window.scrollY > trigger.offsetTop) { pastTrigger = true; }
      });
      update();
    }, { threshold: 0 }).observe(trigger);
  }
  var finalCta = document.getElementById('sec-cta');
  if (finalCta && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { inFinalCta = e.isIntersecting; });
      update();
    }, { threshold: 0.1 }).observe(finalCta);
  }
  var stickyTicking = false;
  window.addEventListener('scroll', function () {
    if (!stickyTicking) {
      requestAnimationFrame(function () { update(); stickyTicking = false; });
      stickyTicking = true;
    }
  }, { passive: true });
})();
</script>
