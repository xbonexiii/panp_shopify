/* LP固有スタイル（タイポグラフィ再定義なし / レイアウト・色オーバーライドのみ） */

/* count-up section */
.lp-wrapper .count-up-section{ padding: var(--section-pad) 0; background: var(--color-bg-section); }
.lp-wrapper .count-up-grid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; max-width: 980px; margin: 0 auto; padding: 0 40px; }
.lp-wrapper .count-up-item{ text-align: center; }
.lp-wrapper .count-up-value{ font-size: 72px; font-weight: 700; line-height: 1.0; color: var(--color-text); font-variant-numeric: tabular-nums; display: inline; }
.lp-wrapper .count-up-unit{ font-size: 24px; font-weight: 600; color: var(--color-text); }
.lp-wrapper .count-up-label{ font-size: 17px; font-weight: 600; color: var(--color-text); margin-top: 12px; }
.lp-wrapper .count-up-sub{ font-size: 14px; color: var(--color-text-sub); margin-top: 4px; }
@media (max-width: 1068px) {
  .lp-wrapper .count-up-grid{ padding: 0 24px; gap: 24px; }
  .lp-wrapper .count-up-value{ font-size: 56px; }
}
@media (max-width: 734px) {
  .lp-wrapper .count-up-grid{ grid-template-columns: 1fr; gap: 40px; padding: 0 16px; }
  .lp-wrapper .count-up-value{ font-size: 48px; }
}

/* pain cards */
.lp-wrapper .pain-cards{ display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 980px; margin: 48px auto 0; padding: 0 40px; }
.lp-wrapper .pain-card{ background: var(--color-bg-section); border-radius: var(--tile-radius); padding: 32px; }
.lp-wrapper .pain-card__icon{ font-size: 32px; margin-bottom: 12px; }
.lp-wrapper .pain-card__title{ font-weight: 600; font-size: 17px; color: var(--color-text); }
.lp-wrapper .pain-card__desc{ font-size: 15px; color: var(--color-text-sub); margin-top: 8px; line-height: 1.6; }
@media (max-width: 734px) {
  .lp-wrapper .pain-cards{ grid-template-columns: 1fr; padding: 0 16px; }
}

/* quality pillars */
.lp-wrapper .quality-pillars{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 980px; margin: 48px auto 0; padding: 0 40px; }
.lp-wrapper .quality-pillar{ text-align: center; padding: 32px 20px; }
.lp-wrapper .quality-pillar__number{ font-size: 48px; font-weight: 700; color: var(--color-air-green); line-height: 1; }
.lp-wrapper .quality-pillar__title{ font-size: 17px; font-weight: 600; color: var(--color-text); margin-top: 16px; }
.lp-wrapper .quality-pillar__desc{ font-size: 15px; color: var(--color-text-sub); margin-top: 8px; line-height: 1.6; }
@media (max-width: 734px) {
  .lp-wrapper .quality-pillars{ grid-template-columns: 1fr; padding: 0 16px; gap: 16px; }
}

/* compare tile height sync + manual pump muted style */
.lp-wrapper .compare-tile-set{ align-items: stretch; }
.lp-wrapper .compare-tile{ display: flex; flex-direction: column; }
.lp-wrapper .compare-tile .compare-tout-group{ margin-top: auto; }
.lp-wrapper .compare-tile--muted .compare-headline{ color: var(--color-text-sub); }
.lp-wrapper .compare-tile--muted .compare-subheading{ color: #aaa; }
.lp-wrapper .compare-tile--muted .compare-positioning{ color: #bbb; }
.lp-wrapper .compare-tile--muted .compare-price{ color: #aaa; }
.lp-wrapper .compare-tile--muted .compare-tout__subheading{ color: #aaa; font-weight: 400; }
.lp-wrapper .compare-tile--muted .compare-tout__copy{ color: #aaa; }
.lp-wrapper .compare-tile--muted .compare-stat__value{ color: #aaa; }

/* speed stats row */
.lp-wrapper .speed-stats{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 980px; margin: 48px auto 0; padding: 0 40px; }
.lp-wrapper .speed-stat{ background: var(--color-bg-section); border-radius: var(--tile-radius); padding: 32px; text-align: center; }
.lp-wrapper .speed-stat__time{ font-size: 48px; font-weight: 700; color: var(--color-air-green); line-height: 1; font-variant-numeric: tabular-nums; }
.lp-wrapper .speed-stat__time .count-up{ display: inline; font-size: inherit; font-weight: inherit; color: inherit; }
.lp-wrapper .speed-stat__unit{ font-size: 17px; font-weight: 600; color: var(--color-text); margin-top: 4px; }
.lp-wrapper .speed-stat__label{ font-size: 15px; color: var(--color-text-sub); margin-top: 8px; }
@media (max-width: 734px) {
  .lp-wrapper .speed-stats{ grid-template-columns: 1fr; padding: 0 16px; }
  .lp-wrapper .speed-stat__time{ font-size: 40px; }
}


