<style>
/* ============================================================
   global.css — Apple Design System 完全準拠 共通スタイル
   参照: apple.com/jp/macbook-neo 実CSSファイルより抽出
   更新: 2026-03-29（スクレイピング結果を反映）
   ============================================================ */

/* ─── CSS カスタムプロパティ（デザイントークン） ─────────── */
:root {
  /* ── ライトモード テキスト ── */
  --color-text:          #1d1d1f;
  --color-text-sub:      #6e6e73;
  --color-text-tertiary: #86868b;
  --color-text-quat:     #37373a;

  /* ── ダークモード テキスト（視認性4段階） ── */
  --color-text-dark:         #f5f5f7;                  /* 見出し・強調 */
  --color-text-dark-body:    rgba(255, 255, 255, 0.8); /* 本文（Apple公式値） */
  --color-text-dark-sub:     #a1a1a6;                  /* 補足テキスト */
  --color-text-dark-caption: #86868b;                  /* 注記・出典のみ */

  /* ── 背景 ── */
  --color-bg:         #fff;
  --color-bg-section: #f5f5f7;
  --color-bg-dark:    #000;
  --color-bg-dark-el: #1d1d1f;   /* ダーク elevated */

  /* ── アクション ── */
  --color-cta:        #0071e3;
  --color-cta-hover:  #0076DF;
  --color-cta-active: #006EDB;
  --color-link:       #0066cc;
  --color-link-dark:  #2997ff;

  /* ── Fill ── */
  --fill-gray-quat:      rgba(0,0,0,0.08);
  --fill-gray-quat-dark: rgba(255,255,255,0.08);

  /* ── ボーダー ── */
  --border-light: rgba(0,0,0,0.1);
  --border-dark:  rgba(255,255,255,0.1);

  /* ── フォーカスリング ── */
  --focus-color:  #0071e3;
  --focus-offset: 1px;

  /* ── タイル・カード ── */
  --tile-radius: 28px;
  --pill-radius: 980px;

  /* ── セクションパディング ── */
  --section-pad:         144px;
  --section-pad-reduced: 120px;
  --section-header-gap:  48px;

  /* ── ブランドカラー（PANP） ── */
  --color-air-green:  #416923;
  --color-ride-gold:  #A37729;

  /* ── グラデーション（Apple Intelligence） ── */
  --gt-rainbow: #0090f7, #ba62fc, #f2416b, #f55600;
  --gt-green:   #0a861a;
  --gt-magenta: #cc29bc;
  --gt-blue:    #2535e0;
  --gt-purple:  #882ff4;

  /* ── アニメーション ── */
  --ease-apple:    cubic-bezier(0.4, 0, 0.2, 1);
  --ease-out:      cubic-bezier(0, 0, 0.6, 1);
  --ease-spring:   cubic-bezier(0.28, 0.11, 0.32, 1);
  --duration-fast: 0.32s;
  --duration-base: 0.55s;
  --duration-slow: 0.8s;
}

@media (max-width: 1068px) {
  :root {
    --section-pad: 120px;
    --section-pad-reduced: 80px;
    --section-header-gap: 40px;
  }
}
@media (max-width: 734px) {
  :root {
    --section-pad: 112px;
    --section-pad-reduced: 56px;
    --section-header-gap: 32px;
  }
}

/* ─── リセット ───────────────────────────────────────────── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ─── HTML / Body ────────────────────────────────────────── */
.lp-wrapper html{
  font-size: 106.25%; /* Apple 公式準拠（= 17px） */
  font-family: SF Pro JP, SF Pro Text, SF Pro Icons,
               Hiragino Kaku Gothic Pro, ヒラギノ角ゴ Pro W3,
               メイリオ, Meiryo, ＭＳ Ｐゴシック,
               Helvetica Neue, Helvetica, Arial, sans-serif;
  -webkit-text-size-adjust: 100%;
  -ms-text-size-adjust: 100%;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  scroll-behavior: smooth;
}

.lp-wrapper body{
  font-size: 17px;
  font-weight: 400;
  line-height: 1.47059;
  letter-spacing: -0.022em;
  font-feature-settings: "palt";
  color: var(--color-text);
  background-color: var(--color-bg);
  -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
}

/* ─── 見出し ─────────────────────────────────────────────── */
.lp-wrapper h1,  .lp-wrapper h2,  .lp-wrapper h3,  .lp-wrapper h4,  .lp-wrapper h5,  .lp-wrapper h6{
  font-weight: 600;
  letter-spacing: -0.009em;
  line-height: 1.05;
  margin: 0;
  padding: 0;
}

/* 見出し直後の段落、段落直後の見出しに余白 */
.lp-wrapper h1 + p,  .lp-wrapper h2 + p,  .lp-wrapper h3 + p,  .lp-wrapper h4 + p,  .lp-wrapper h5 + p,  .lp-wrapper h6 + p{ margin-top: 16px; }
.lp-wrapper p + h1,  .lp-wrapper p + h2,  .lp-wrapper p + h3,  .lp-wrapper p + h4,  .lp-wrapper p + h5,  .lp-wrapper p + h6{ margin-top: 24px; }

/* ─── テキスト要素 ───────────────────────────────────────── */
.lp-wrapper p{ margin: 0; padding: 0; }

/* ─── リンク ─────────────────────────────────────────────── */
.lp-wrapper a{
  color: inherit;
  text-decoration: none;
}
.lp-wrapper a:hover{
  text-decoration: none;
}

/* ─── メディア ───────────────────────────────────────────── */
.lp-wrapper img,  .lp-wrapper video,  .lp-wrapper picture{
  display: block;
  max-width: 100%;
  height: auto;
}

/* ─── ボタンリセット ─────────────────────────────────────── */
.lp-wrapper button{
  font-family: inherit;
  font-size: inherit;
  cursor: pointer;
  border: none;
  background: none;
  padding: 0;
}

/* ─── リストリセット ─────────────────────────────────────── */
.lp-wrapper ul,  .lp-wrapper ol{ list-style: none; }

/* ─── フォーカスリング（アクセシビリティ） ──────────────── */
.lp-wrapper :focus-visible{
  outline: 2px solid var(--focus-color);
  outline-offset: var(--focus-offset);
}

/* ─── セクション共通レイアウト ───────────────────────────── */
.lp-wrapper .section-content{
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
}

@media (max-width: 1068px) {
  .lp-wrapper .section-content{ padding: 0 24px; }
}
@media (max-width: 734px) {
  .lp-wrapper .section-content{ padding: 0 16px; }
}

/* ─── Apple 標準ユーティリティ ───────────────────────────── */

/* テキスト非表示（アクセシビリティ用） */
.lp-wrapper .visually-hidden{
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* 改行禁止 */
.lp-wrapper .nowrap{ white-space: nowrap; }

/* ─── スクロールフェードイン（IntersectionObserver 用） ──── */
.lp-wrapper.js-active .fade-in{
  opacity: 0;
  transform: translateY(20px);
  transition:
    opacity  var(--duration-base) var(--ease-apple),
    transform var(--duration-base) var(--ease-apple);
}

.lp-wrapper .fade-in.is-visible{
  opacity: 1;
  transform: translateY(0);
}

/* モーション感度への配慮（UI Pro Max: Severity High） */
@media (prefers-reduced-motion: reduce) {
  .lp-wrapper .fade-in{
    opacity: 1;
    transform: none;
    transition: none;
  }
}

/* ─── ダークセクション共通 ───────────────────────────────── */
.lp-wrapper .section-dark{
  background-color: var(--color-bg-dark);
  color: var(--color-text-dark);
}

/* ダークモードのテキスト階層 */
.lp-wrapper .section-dark .text-body{ color: var(--color-text-dark-body); }
.lp-wrapper .section-dark .text-sub{ color: var(--color-text-dark-sub); }
.lp-wrapper .section-dark .text-caption{ color: var(--color-text-dark-caption); }
.lp-wrapper .section-dark a{ color: var(--color-link-dark); }

/* ─── Apple 標準ボタン ───────────────────────────────────── */
/* Apple実測: transition background-color 100ms linear
   hover/active色は --sk-button-background-hover/active から抽出 */

/* プライマリ（青）#0071e3 → hover:#0076DF → active:#006EDB */
.lp-wrapper .btn-primary{
  display: inline-block;
  min-height: 44px;
  padding: 11px 22px;
  font-size: 17px;
  font-weight: 400;
  line-height: 1.24;
  letter-spacing: -0.022em;
  color: #fff;
  background: var(--color-cta);
  border-radius: var(--pill-radius);
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  transition: background-color 200ms ease, backdrop-filter 200ms ease;
}
.lp-wrapper .btn-primary:hover{
  background: rgba(0,113,227,0.72);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  text-decoration: none;
  color: #fff;
}
.lp-wrapper .btn-primary:active{
  background: var(--color-cta-active);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

/* セカンダリ（ダーク）#1d1d1f → hover:#272729 → active:#18181A */
.lp-wrapper .btn-dark{
  display: inline-block;
  min-height: 44px;
  padding: 11px 22px;
  font-size: 17px;
  font-weight: 400;
  line-height: 1.24;
  letter-spacing: -0.022em;
  color: #fff;
  background: var(--color-text);
  border-radius: var(--pill-radius);
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  transition: background-color 200ms ease, backdrop-filter 200ms ease;
}
.lp-wrapper .btn-dark:hover{
  background: rgba(29,29,31,0.72);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  text-decoration: none;
  color: #fff;
}
.lp-wrapper .btn-dark:active{
  background: #18181A;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

/* アウトライン（セカンダリ）transparent → hover:背景+白文字 → active */
.lp-wrapper .btn-outline{
  display: inline-block;
  min-height: 44px;
  padding: 11px 22px;
  font-size: 17px;
  font-weight: 400;
  line-height: 1.24;
  letter-spacing: -0.022em;
  color: var(--color-link);
  background: transparent;
  border: 1px solid var(--color-link);
  border-radius: var(--pill-radius);
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  transition: background-color 200ms ease, backdrop-filter 200ms ease, color 200ms ease, border-color 200ms ease;
}
.lp-wrapper .btn-outline:hover{
  background: rgba(0,113,227,0.72);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  color: #fff;
  border-color: transparent;
  text-decoration: none;
}
.lp-wrapper .btn-outline:active{
  background: var(--color-cta-active);
  border-color: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

/* アウトライン ダーク（neutral-secondary）*/
.lp-wrapper .btn-outline-dark{
  display: inline-block;
  min-height: 44px;
  padding: 11px 22px;
  font-size: 17px;
  font-weight: 400;
  line-height: 1.24;
  letter-spacing: -0.022em;
  color: var(--color-text);
  background: transparent;
  border: 1px solid var(--color-text);
  border-radius: var(--pill-radius);
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  transition: background-color 200ms ease, backdrop-filter 200ms ease, color 200ms ease;
}
.lp-wrapper .btn-outline-dark:hover{
  background: rgba(29,29,31,0.72);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  color: #fff;
  text-decoration: none;
}
.lp-wrapper .btn-outline-dark:active{
  background: #18181A;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

/* ダーク反転（ダーク背景上） */
.lp-wrapper .btn-dark-inv{
  display: inline-block;
  min-height: 44px;
  padding: 11px 22px;
  font-size: 17px;
  font-weight: 400;
  line-height: 1.24;
  color: var(--color-text);
  background: var(--color-bg-section);
  border-radius: var(--pill-radius);
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  transition: background-color 200ms ease, backdrop-filter 200ms ease;
}
.lp-wrapper .btn-dark-inv:hover{
  background: rgba(245,245,247,0.72);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  color: var(--color-text);
}

/* テキストリンク風（青字） */
.lp-wrapper .btn-link{
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 17px;
  font-weight: 400;
  color: var(--color-link);
  text-decoration: none;
  cursor: pointer;
}
.lp-wrapper .btn-link:hover{
  opacity: 0.72;
}
.lp-wrapper .section-dark .btn-link{
  color: var(--color-link-dark);
}

/* ─── グラデーションテキスト ─────────────────────────────── */
.lp-wrapper .gt-rainbow{
  background: linear-gradient(90deg, var(--gt-rainbow));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.lp-wrapper .gt-green{
  background: linear-gradient(180deg, var(--gt-green), #0a861a);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.lp-wrapper .gt-magenta{
  background: linear-gradient(180deg, var(--gt-magenta), #a01f95);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.lp-wrapper .gt-blue{
  background: linear-gradient(180deg, var(--gt-blue), #1a28b0);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.lp-wrapper .gt-purple{
  background: linear-gradient(180deg, var(--gt-purple), #6e2bc7);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ─── タイル / カード ────────────────────────────────────── */
.lp-wrapper .tile{
  background: var(--color-bg);
  border-radius: var(--tile-radius);
  overflow: hidden;
}
.lp-wrapper .tile--alt{
  background: var(--color-bg-section);
}
.lp-wrapper .tile--dark{
  background: var(--fill-gray-quat-dark);
  border: 1px solid var(--border-dark);
}
.lp-wrapper .tile__body{
  padding: 32px;
}
@media (max-width: 1068px) { .tile__body { padding: 28px; } }
@media (max-width: 734px) { .tile__body { padding: 24px; } }

/* ─── ブレークポイント別ユーティリティ ───────────────────── */
@media (max-width: 1068px) {
  .lp-wrapper .hide-medium{ display: none !important; }
}
@media (max-width: 734px) {
  .lp-wrapper .hide-small{ display: none !important; }
}
@media (min-width: 735px) {
  .lp-wrapper .show-small{ display: none !important; }
}

/* ═══════════════════════════════════════════════════════════════
   共通デザインシステム — タイポグラフィ・レイアウト・コンポーネント
   全セクションで統一的に使用する共通クラス
   ═══════════════════════════════════════════════════════════════ */

/* ─── タイポグラフィ（Apple overview.built.css 実測値 2026-03-30）─── */
/* 注: 日本語(ja)版の値。英語版とはサイズ・letter-spacingが異なる */

/* t-headline: セクション主見出し
   56px / 600 / 1.12 / -0.005em → 40px → 28px */
.lp-wrapper .t-headline{
  font-size: 56px;
  font-weight: 600;
  line-height: 1.12;
  letter-spacing: -0.005em;
  color: var(--color-text);
}

/* t-headline-xl: ヒーロー見出し
   64px / 600 / 1.08 / -0.009em → 48px → 32px */
.lp-wrapper .t-headline-xl{
  font-size: 64px;
  font-weight: 600;
  line-height: 1.08;
  letter-spacing: -0.009em;
  color: var(--color-text);
}

/* t-callout: 章タイトル / コピー
   21px / 600 / 1.29 / 0em → 19px */
.lp-wrapper .t-callout{
  font-size: 21px;
  font-weight: 600;
  line-height: 1.29;
  letter-spacing: 0em;
  color: var(--color-text);
}

/* t-body: 本文 / 説明文
   17px / 400 / 1.47 / -0.022em → 15px */
.lp-wrapper .t-body{
  font-size: 17px;
  font-weight: 400;
  line-height: 1.47;
  letter-spacing: -0.022em;
  color: var(--color-text);
}

/* t-eyebrow-sm: セクションeyebrow
   12px / 600 / 1.33 / -0.01em / uppercase */
.lp-wrapper .t-eyebrow-sm{
  font-size: 12px;
  font-weight: 600;
  line-height: 1.33;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--color-text-sub);
}

/* t-caption: キャプション / 脚注
   12px / 400 / 1.33 */
.lp-wrapper .t-caption{
  font-size: 12px;
  font-weight: 400;
  line-height: 1.33;
  color: var(--color-text-sub);
}

/* ─── スタット数値（Apple stat-value 実測値）──────────────── */

/* t-stat-super: 大型数値
   64px / 600 / 1.0 / 0em → 56px → 40px */
.lp-wrapper .t-stat-super{
  font-size: 64px;
  font-weight: 600;
  line-height: 1.0;
  letter-spacing: 0em;
  color: var(--color-text);
}

/* t-stat-caption: スタットキャプション
   Apple: stat-caption 17px / 400 / 1.24 / -0.022em → 14px */
.lp-wrapper .t-stat-caption{
  font-size: 17px;
  font-weight: 400;
  line-height: 1.24;
  letter-spacing: -0.022em;
  color: var(--color-text);
}

/* ─── タイポグラフィ レスポンシブ ──────────────────────────── */
@media (max-width: 1068px) {
  .lp-wrapper .t-headline-xl{ font-size: 48px; }
  .lp-wrapper .t-headline{ font-size: 40px; }
  .lp-wrapper .t-callout{ font-size: 19px; }
  .lp-wrapper .t-body{ font-size: 15px; }
  .lp-wrapper .t-stat-super{ font-size: 56px; }
  .lp-wrapper .t-stat-caption{ font-size: 14px; }
}

@media (max-width: 734px) {
  .lp-wrapper .t-headline-xl{ font-size: 32px; }
  .lp-wrapper .t-headline{ font-size: 28px; }
  .lp-wrapper .t-callout{ font-size: 17px; }
  .lp-wrapper .t-body{ font-size: 15px; }
  .lp-wrapper .t-stat-super{ font-size: 40px; }
  .lp-wrapper .t-stat-caption{ font-size: 12px; }
}

/* ─── gradient-text: span内にグラデーション適用 ────────────── */
.lp-wrapper .gradient-text span{
  background: linear-gradient(90deg, var(--gt-rainbow));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* AIR グリーン グラデーション */
.lp-wrapper .gradient-text--air span{
  background: linear-gradient(135deg, var(--color-air-green), #5a8f30);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ─── セクションヘッダー（中央揃え型）─────────────────────── */
.lp-wrapper .section-header{
  text-align: center;
  max-width: 980px;
  margin: 0 auto;
  padding: 0 40px;
  margin-bottom: var(--section-header-gap);
}

@media (max-width: 1068px) {
  .lp-wrapper .section-header{ padding: 0 24px; }
}
@media (max-width: 734px) {
  .lp-wrapper .section-header{ padding: 0 16px; }
}

/* ─── コンテナ幅 ───────────────────────────────────────────── */

/* 980px: Apple標準コンテンツ幅 */
.lp-wrapper .container{
  max-width: 980px;
  margin: 0 auto;
  padding: 0 40px;
}

/* 1200px: ワイドコンテンツ */
.lp-wrapper .container-wide{
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
}

/* 740px: ナローコンテンツ */
.lp-wrapper .container-narrow{
  max-width: 740px;
  margin: 0 auto;
  padding: 0 40px;
}

@media (max-width: 1068px) {
  .container,
  .lp-wrapper .container-narrow{ padding: 0 24px; }
}
@media (max-width: 734px) {
  .container,
  .lp-wrapper .container-narrow{ padding: 0 16px; }
}

/* ─── pill型タブボタン（共通コンポーネント）──────────────── */
.lp-wrapper .pill-tab{
  border: none;
  border-radius: var(--pill-radius);
  padding: 10px 24px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--duration-fast) var(--ease-apple);
  white-space: nowrap;
}

.lp-wrapper .pill-tab.is-active{
  background: var(--color-text);
  color: #fff;
}

.lp-wrapper .pill-tab:not(.is-active){
  background: var(--fill-gray-quat);
  color: var(--color-text);
}

.lp-wrapper .pill-tab:not(.is-active):hover{
  background: rgba(0, 0, 0, 0.12);
}

/* ─── 交互配置ブロック（2カラム + 左右入替）──────────────── */
.lp-wrapper .block-alternate{
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
  max-width: 980px;
  margin: 0 auto;
  padding: 0 40px;
}

.lp-wrapper .block-alternate--reverse{
  direction: rtl;
}
.lp-wrapper .block-alternate--reverse > *{
  direction: ltr;
}

