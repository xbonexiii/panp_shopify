<style>

/* ================== tokens.css ================== */
:root {
  /* ---- 色 ---- */
  --gold: #A37729;
  --gold-light: #c49535;
  --gold-tint: rgba(163,119,41,.1);
  --blue: #0071e3;
  --text: #1d1d1f;
  --text-sub: #6e6e73;
  --bg-white: #ffffff;
  --bg-gray: #f5f5f7;
  --bg-dark: #1d1d1f;
  --star: #f5c518;

  /* ---- タイポグラフィ（サイズ階層） ---- */
  --fs-hero: clamp(32px, 5.5vw, 68px);
  --fs-hero-compact: clamp(30px, 4.2vw, 54px);
  --fs-h2: clamp(28px, 3.5vw, 44px);
  --fs-h3: 22px;
  --fs-stat: clamp(28px, 3.6vw, 48px);
  --fs-lead: clamp(16px, 1.6vw, 20px);
  --fs-body: 17px;
  --fs-note: 13px;
  --fs-micro: 12px;

  /* ---- 字間 ---- */
  --ls-hero: -0.03em;
  --ls-heading: -0.02em;
  --ls-num: -0.04em;

  /* ---- 角丸（3階層固定） ---- */
  --radius-card: 24px;
  --radius-image: 16px;
  --radius-badge: 12px;
  --radius-pill: 50px;

  /* ---- 影（1種のみ） ---- */
  --shadow-card: 0 2px 20px rgba(0,0,0,.06);

  /* ---- セクション余白 ---- */
  --section-pad: 100px;
  --section-pad-sp: 64px;
}

/* ================== base.css ================== */
.lp-wrapper *,  .lp-wrapper *::before,  .lp-wrapper *::after{ box-sizing: border-box; margin: 0; padding: 0; }
.lp-wrapper{ scroll-behavior: smooth; }
.lp-wrapper{
  font-family: Helvetica, Arial, sans-serif;
  color: var(--text); font-size: var(--fs-body); line-height: 1.7; overflow-x: hidden;
}
.lp-wrapper img{ max-width: 100%; height: auto; display: block; }
.lp-wrapper a{ color: inherit; text-decoration: none; }
.lp-wrapper section{ width: 100%; }
/* 見出しは常にコンテナの色を継承（Shopifyテーマの h1/h2{color:#1d1d1f} 直接指定に負けて黒くなる再発バグを防ぐ・省略禁止） */
.lp-wrapper h1,  .lp-wrapper h2,  .lp-wrapper h3,  .lp-wrapper h4,  .lp-wrapper h5,  .lp-wrapper h6{ color: inherit; }
.lp-wrapper .container{ max-width: 1200px; margin: 0 auto; padding: 0 40px; }
.lp-wrapper .section-padding{ padding-top: var(--section-pad); padding-bottom: var(--section-pad); }
.lp-wrapper h2.section-title{ font-size: var(--fs-h2); font-weight: 700; line-height: 1.3; letter-spacing: var(--ls-heading); }
@media (max-width: 768px) {
  .lp-wrapper{ font-size: 16px; }
  .lp-wrapper .container{ padding: 0 20px; }
  .lp-wrapper .section-padding{ padding-top: var(--section-pad-sp); padding-bottom: var(--section-pad-sp); }
}

/* ---- アニメーションクラス（4種） ---- */
.lp-wrapper .fade-in{ opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
.lp-wrapper .fade-in.visible{ opacity: 1; transform: translateY(0); }
.lp-wrapper .slide-left{ opacity: 0; transform: translateX(-48px); transition: opacity 0.8s ease, transform 0.8s ease; }
.lp-wrapper .slide-right{ opacity: 0; transform: translateX(48px);  transition: opacity 0.8s ease, transform 0.8s ease; }
.lp-wrapper .slide-up{ opacity: 0; transform: translateY(32px);  transition: opacity 0.7s ease, transform 0.7s ease; }
.lp-wrapper .slide-left.visible,  .lp-wrapper .slide-right.visible,  .lp-wrapper .slide-up.visible{ opacity: 1; transform: none; }
.lp-wrapper .delay-1{ transition-delay: .15s; }
.lp-wrapper .delay-2{ transition-delay: .3s; }
.lp-wrapper .delay-3{ transition-delay: .45s; }
.lp-wrapper .delay-4{ transition-delay: .6s; }

/* ---- ボタンコンポーネント ---- */
.lp-wrapper .btn-primary{
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--gold); color: #fff;
  font-size: 18px; font-weight: 700; padding: 18px 40px;
  border-radius: var(--radius-pill); cursor: pointer;
  transition: background 0.2s, transform 0.1s;
  border: none; letter-spacing: 0.02em;
}
.lp-wrapper .btn-primary:hover{ background: var(--gold-light); transform: translateY(-1px); }
.lp-wrapper .btn-secondary{
  display: inline-block; color: var(--gold); font-size: 15px; font-weight: 500;
  margin-top: 16px; border-bottom: 1px solid currentColor; padding-bottom: 2px;
}

/* ---- スクロール誘導矢印 ---- */
.lp-wrapper .scroll-hint{
  position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  color: rgba(255,255,255,0.55); font-size: 10px; letter-spacing: 0.15em;
  text-transform: uppercase; animation: scroll-bounce 2.2s infinite;
}
.lp-wrapper .scroll-hint svg{ width: 20px; height: 20px; }
@keyframes scroll-bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.55; }
  50%       { transform: translateX(-50%) translateY(8px); opacity: 0.9; }
}

/* ---- ソーシャルプルーフ（ヒーロー内） ---- */
.lp-wrapper .hero-social-proof{ display: flex; align-items: center; gap: 8px; margin-top: 12px; color: #fff; font-size: 14px; }
.lp-wrapper .hero-social-proof .stars{ color: #f5c518; letter-spacing: 2px; font-size: 16px; }

/* ---- 最終CTA直前 お客様の声引用 ---- */
.lp-wrapper .cta-voice{ max-width: 480px; margin: 0 auto 32px; text-align: center; }
.lp-wrapper .cta-voice blockquote{
  font-size: 15px; line-height: 1.7; color: rgba(255,255,255,0.85);
  font-style: italic; margin: 0 0 8px;
  border-left: 2px solid var(--gold); padding-left: 14px; text-align: left;
}
.lp-wrapper .cta-voice cite{ font-size: var(--fs-micro); color: rgba(255,255,255,0.5); display: block; text-align: right; }

/* ---- モバイルスティッキーCTA（上スクロールで凹む・下スクロールで再表示） ---- */
.lp-wrapper #sticky-cta{
  display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 8000;
  padding: 12px 20px 20px;
  background: linear-gradient(to top, rgba(0,0,0,0.92) 80%, transparent);
  transform: translateY(0); transition: transform .3s ease;
}
.lp-wrapper #sticky-cta.retract{ transform: translateY(110%); }
.lp-wrapper #sticky-cta a{
  display: block; width: 100%; text-align: center;
  background: var(--gold); color: #fff;
  font-size: 16px; font-weight: 700; padding: 16px; border-radius: var(--radius-badge);
}
.lp-wrapper #sticky-cta .sticky-note{ text-align: center; font-size: 11px; color: rgba(255,255,255,0.6); margin-top: 6px; }
@media (min-width: 769px) { #sticky-cta { display: none !important; } }

/* ---- 2カラム 画像+テキスト グリッド ---- */
.lp-wrapper .two-col-inner{ display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
.lp-wrapper .two-col-image-wrap img{ width: 100%; height: 400px; object-fit: cover; border-radius: var(--radius-image); display: block; }
@media (max-width: 768px) {
  .lp-wrapper .two-col-inner{ grid-template-columns: 1fr; gap: 32px; }
  .lp-wrapper .two-col-image-wrap{ order: -1; }
  .lp-wrapper .two-col-image-wrap img{ height: 260px; }
}

/* ================== RIDE商流1_テーマ.css ================== */
/* ============================================================
   案件テーマ: PANP RIDE 商流1（「あの面倒が、あなたの代わりに終わる」LP）
   原稿メモ指定: 落ち着いた緑（メイン）・オレンジ（CTA・感情の橋・強調のみ）。
   変更: RIDEシリーズはブランドカラー=ゴールド #A37729（緑はAIRシリーズ）／
         CTAボタンは青（信頼の青・2026-07-04確定）／感情の橋のみオレンジ。
   使い方: tokens.css の直後・base.css の【後】に読み込む（値の上書きのみ）
   ============================================================ */
:root {
  --gold: #A37729;
  --gold-light: #C0913A;
  --gold-tint: rgba(163, 119, 41, .08);

  /* CTAボタン専用 = 青（信頼の青） */
  --cta: #1E6FD9;
  --cta-light: #3E85E8;

  /* 感情の橋 専用 = オレンジ（章末の1文のみ） */
  --bridge: #E8722A;

  /* 背景 = 温かみのある白系 */
  --bg-white: #FDFCF9;
  --bg-gray: #F5F2EC;
  --bg-dark: #1C1A17;
}
.lp-wrapper .btn-primary{ background: var(--cta); }
.lp-wrapper .btn-primary:hover{ background: var(--cta-light); }
.lp-wrapper #sticky-cta a{ background: var(--cta); }
.lp-wrapper .bridge-line{
  font-size: var(--fs-h3); font-weight: 700; color: var(--bridge);
  line-height: 1.8;
}

/* ================== sec-hero（FV・キャッチ主役写真型） ================== */
.lp-wrapper #sec-hero{
  position: relative; min-height: 100svh;
  display: flex; align-items: center;
  color: #fff;
}
.lp-wrapper #sec-hero .hero-bg{ position: absolute; inset: 0; overflow: hidden; }
.lp-wrapper #sec-hero .hero-bg img{ width: 100%; height: 100%; object-fit: cover; }
.lp-wrapper #sec-hero .hero-bg::after{
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.78) 0%, rgba(0,0,0,.28) 50%, rgba(0,0,0,.08) 100%);
}
.lp-wrapper #sec-hero .hero-brand{
  position: absolute; top: 28px; left: 40px; z-index: 2;
  height: 26px; width: auto; display: block;
}
.lp-wrapper #sec-hero .hero-inner{
  position: relative; z-index: 1; width: 100%;
  max-width: 1200px; margin: 0 auto;
  padding-left: 40px; padding-right: 40px; padding-top: 72px; padding-bottom: 72px;
}
/* 不安ワードチップはキャッチ＋芯の一言の下に置く（2026-07-14 レビュー反映: コピーを先に読ませる） */
.lp-wrapper #sec-hero .worry-chips{ display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
.lp-wrapper #sec-hero .worry-chips span{
  display: inline-flex; align-items: center; gap: 6px;
  font-size: var(--fs-note); font-weight: 500; color: rgba(255,255,255,.9);
  border: 1px solid rgba(255,255,255,.35);
  padding: 7px 14px; border-radius: var(--radius-pill);
  backdrop-filter: blur(2px);
}
.lp-wrapper #sec-hero .worry-chips svg{ width: 15px; height: 15px; }
.lp-wrapper #sec-hero h1{
  font-size: var(--fs-hero); font-weight: 700;
  line-height: 1.35; letter-spacing: var(--ls-hero);
  color: #fff;
  max-width: 720px; margin-bottom: 20px;
}
.lp-wrapper #sec-hero .hero-core{
  font-size: var(--fs-lead); font-weight: 700; line-height: 1.9;
  color: rgba(255,255,255,.92); max-width: 680px;
}
.lp-wrapper #sec-hero .hero-core em{ font-style: normal; color: var(--gold-light); }
.lp-wrapper #sec-hero .hd-nowrap{ white-space: nowrap; } /* 行末1文字の孤立を防ぐ（手動br禁止） */
/* eyebrow（見出し上の小ラベル）を全セクション非表示（ユーザー指示 2026-07-16） */
.lp-wrapper [data-slot="eyebrow"]{ display: none !important; }
@media (max-width: 768px) {
  .lp-wrapper #sec-hero .hero-brand{ left: 20px; top: 20px; }
  .lp-wrapper #sec-hero .hero-inner{ padding-left: 20px; padding-right: 20px; padding-top: 64px; padding-bottom: 88px; }
  .lp-wrapper #sec-hero h1{ font-size: calc(var(--fs-hero) * 0.82); line-height: 1.4; }
  /* 文言が長いためスマホは1行維持より読みやすさ優先で折り返す */
  .lp-wrapper #sec-hero .hd-nowrap{ white-space: normal; }
}

/* ================== sec-empathy（問題提起＋共感・独白と生声） ================== */
.lp-wrapper #sec-empathy{ background: var(--bg-dark); color: #fff; }
.lp-wrapper #sec-empathy .em-inner{ max-width: 680px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper #sec-empathy .em-label{ font-size: var(--fs-note); font-weight: 700; letter-spacing: var(--ls-heading); color: var(--gold-light); margin-bottom: 16px; }
.lp-wrapper #sec-empathy h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.5;
  letter-spacing: var(--ls-heading); color: #fff; margin-bottom: 28px;
}
.lp-wrapper #sec-empathy .em-body p{ font-size: var(--fs-body); line-height: 2.1; color: rgba(255,255,255,.85); margin-bottom: 20px; }
/* 生声（楽天レビュー風UI: 人物アイコン＋吹き出し＋出所ラベル・2026-07-14レビュー反映）。
   ダーク背景のためしっぽは付けない（半透明の菱形が内部要素と重なって透けるため） */
.lp-wrapper #sec-empathy .em-voice{ display: flex; align-items: flex-start; gap: 12px; margin: 28px 0; }
.lp-wrapper #sec-empathy .em-voice .avatar{
  width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0;
  background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.22);
  display: flex; align-items: center; justify-content: center;
}
.lp-wrapper #sec-empathy .em-voice .avatar svg{ width: 24px; height: 24px; color: rgba(255,255,255,.7); }
.lp-wrapper #sec-empathy .em-voice .bubble{
  flex: 1; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.18);
  border-radius: var(--radius-card); padding: 14px 18px 12px;
}
.lp-wrapper #sec-empathy .em-voice .bubble .v-meta{ display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
.lp-wrapper #sec-empathy .em-voice .quote-mark{ width: 16px; height: 16px; color: var(--gold-light); opacity: .6; flex-shrink: 0; }
.lp-wrapper #sec-empathy .em-voice .src{
  font-size: var(--fs-micro); color: rgba(255,255,255,.6); margin-left: auto;
  background: rgba(255,255,255,.08); border-radius: var(--radius-pill); padding: 3px 10px; white-space: nowrap;
}
.lp-wrapper #sec-empathy .em-voice .bubble p{
  font-size: var(--fs-note); line-height: 1.9; color: rgba(255,255,255,.88);
  letter-spacing: var(--ls-heading); margin-bottom: 0;
}
.lp-wrapper #sec-empathy .em-close{ font-size: var(--fs-lead); font-weight: 700; line-height: 2.0; color: #fff; margin-top: 8px; }
.lp-wrapper #sec-empathy .em-close .accent{ color: var(--gold-light); }

/* ================== sec-awareness（気づき・家電は自動なのに空気入れだけ手動） ================== */
.lp-wrapper #sec-awareness{ background: var(--bg-gray); color: var(--text); }
.lp-wrapper #sec-awareness .aw-inner{ max-width: 880px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper #sec-awareness .aw-eyebrow{
  display: inline-block; font-size: var(--fs-note); font-weight: 700; letter-spacing: var(--ls-heading);
  color: var(--gold); background: var(--gold-tint);
  padding: 6px 16px; border-radius: var(--radius-pill); margin-bottom: 20px;
}
.lp-wrapper #sec-awareness h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.55;
  letter-spacing: var(--ls-heading); color: var(--text); margin-bottom: 20px;
}
.lp-wrapper #sec-awareness .aw-lead{ font-size: var(--fs-body); line-height: 2.0; color: var(--text-sub); margin-bottom: 36px; }
.lp-wrapper #sec-awareness .aw-grid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 40px; }
.lp-wrapper #sec-awareness .aw-card{
  background: var(--bg-white); border-radius: var(--radius-card); overflow: hidden;
  box-shadow: var(--shadow-card); text-align: left;
}
.lp-wrapper #sec-awareness .aw-card img{ width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
.lp-wrapper #sec-awareness .aw-card .aw-img{ position: relative; line-height: 0; }
.lp-wrapper #sec-awareness .aw-card .aw-img::after{ content: ""; position: absolute; inset: 0; background: rgba(0,0,0,.22); pointer-events: none; }
.lp-wrapper #sec-awareness .aw-card-body{ padding: 20px 22px; }
.lp-wrapper #sec-awareness .aw-card h3{ font-size: var(--fs-body); font-weight: 700; line-height: 1.6; color: var(--text); margin-bottom: 8px; }
.lp-wrapper #sec-awareness .aw-card p{ font-size: var(--fs-note); line-height: 1.9; color: var(--text-sub); }
/* 対比の一撃: 家電は自動なのに空気入れだけ手動（このセクションの主役・詳細度はコンテナ込み） */
.lp-wrapper #sec-awareness .aw-inner .aw-contrast{
  background: var(--bg-white); border-left: 4px solid var(--gold);
  border-radius: var(--radius-image); padding: 28px 28px;
  font-size: var(--fs-lead); font-weight: 700; line-height: 1.9; color: var(--text); margin-bottom: 28px;
}
.lp-wrapper #sec-awareness .aw-close{ font-size: var(--fs-body); font-weight: 700; line-height: 2.0; color: var(--text); }
.lp-wrapper #sec-awareness .aw-close .accent{ color: var(--gold); }
@media (max-width: 768px) {
  .lp-wrapper #sec-awareness .aw-grid{ grid-template-columns: 1fr; }
}

/* ================== sec-solution（解決・製品コールアウト型／あなたの代わりに） ================== */
.lp-wrapper #sec-solution{ background: var(--bg-white); color: var(--text); }
.lp-wrapper #sec-solution .sol-inner{ max-width: 680px; margin: 0 auto; padding: 0 20px; text-align: left; }
.lp-wrapper #sec-solution .sol-eyebrow{
  display: inline-block; font-size: var(--fs-note); font-weight: 700;
  letter-spacing: 0.14em; color: var(--gold);
  background: var(--gold-tint);
  padding: 6px 16px; border-radius: var(--radius-pill); margin-bottom: 24px;
}
.lp-wrapper #sec-solution h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.5;
  letter-spacing: var(--ls-heading); color: var(--text);
  margin-bottom: 16px;
}
.lp-wrapper #sec-solution h2 em{ font-style: normal; color: var(--gold); }
.lp-wrapper #sec-solution .sol-product-name{ font-size: var(--fs-lead); font-weight: 700; color: var(--text); margin-bottom: 8px; }
.lp-wrapper #sec-solution .sol-lead{ font-size: var(--fs-body); line-height: 2.0; color: var(--text-sub); margin-bottom: 12px; }
/* 製品ビジュアル（1カラム・大きく主役に） */
.lp-wrapper #sec-solution .sol-visual{ max-width: 880px; margin: 44px auto; padding: 0 20px; }
.lp-wrapper #sec-solution .product-photo{ border-radius: var(--radius-card); overflow: hidden; box-shadow: var(--shadow-card); }
.lp-wrapper #sec-solution .product-photo img,  .lp-wrapper #sec-solution .product-photo video{ width: 100%; height: 100%; max-height: 460px; object-fit: cover; display: block; }
/* 使い方3ステップ（写真で見せる） */
.lp-wrapper #sec-solution .photo-steps{
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;
  max-width: 1120px; margin: 0 auto 20px; padding: 0 20px;
}
.lp-wrapper #sec-solution .pstep{ background: var(--bg-gray); border-radius: var(--radius-image); overflow: hidden; }
.lp-wrapper #sec-solution .pstep img{ width: 100%; height: 420px; object-fit: cover; }
.lp-wrapper #sec-solution .pstep figcaption{ padding: 14px 16px; font-size: var(--fs-note); font-weight: 700; color: var(--text); text-align: left; }
.lp-wrapper #sec-solution .pstep .step-num{ display: block; font-size: var(--fs-micro); font-weight: 700; color: var(--gold); letter-spacing: 0.1em; margin-bottom: 4px; }
/* なぜできるか（センサーで自動停止） */
.lp-wrapper #sec-solution .sol-why{
  max-width: 680px; margin: 0 auto; padding: 0 20px;
}
.lp-wrapper #sec-solution .sol-why p{ font-size: var(--fs-body); line-height: 2.0; color: var(--text-sub); margin-bottom: 8px; }
.lp-wrapper #sec-solution .sol-transform{
  font-size: var(--fs-lead); font-weight: 700; line-height: 2.0;
  color: var(--text); max-width: 640px; margin: 44px auto; padding: 0 20px;
}
.lp-wrapper #sec-solution .sol-transform em{ font-style: normal; color: var(--gold); }
.lp-wrapper #sec-solution .sol-inner .sol-bridge{ margin-top: 12px; display: block; }
@media (max-width: 768px) {
  .lp-wrapper #sec-solution .sol-visual{ margin: 32px auto; }
  .lp-wrapper #sec-solution .product-photo img,  .lp-wrapper #sec-solution .product-photo video{ max-height: 300px; }
  .lp-wrapper #sec-solution .photo-steps{ grid-template-columns: 1fr; gap: 14px; }
  .lp-wrapper #sec-solution .pstep{ display: block; }
  .lp-wrapper #sec-solution .pstep img{ width: 100%; height: 300px; }
}

/* ================== sec-cta-simple（中間CTA・シンプル3要素型） ================== */
/* 次のsec-comparisonがグレーのため、CTAは白（雛形のグレーのままだと境目が消えて比較の一部に見える）。
   解決セクション（白）からの流れをそのまま受けて押させ、次のグレーで章を切る */
.lp-wrapper #sec-cta-simple{ background: var(--bg-white); color: var(--text); }
.lp-wrapper #sec-cta-simple .sc-inner{
  max-width: 880px; width: calc(100% - 40px); margin: 0 auto; text-align: center;
}
/* 見出しは他セクションと同じ --fs-h2。スマホでも縮小させず、必要なら改行させる */
.lp-wrapper #sec-cta-simple .sc-inner h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.5;
  letter-spacing: var(--ls-heading); color: var(--text);
  margin-bottom: 20px;
}
.lp-wrapper #sec-cta-simple .sc-lead{
  font-size: var(--fs-body); line-height: 2.0; color: var(--text-sub); margin-bottom: 36px;
}
/* ボタン下の安心補足 — 主役はボタンなので従属サイズ */
.lp-wrapper #sec-cta-simple .sc-note{
  font-size: var(--fs-note); line-height: 1.8; color: var(--text-sub); margin-top: 16px;
}
