.lp-wrapper #sec-guarantee .support-row svg{ width: 18px; height: 18px; color: var(--gold); }
.lp-wrapper #sec-guarantee .gr-close{
  max-width: 680px; margin: 0 auto; padding: 0 20px;
  font-size: var(--fs-lead); font-weight: 700; line-height: 2.0; color: var(--text);
}
.lp-wrapper #sec-guarantee .gr-close .bridge-line{ display: block; margin-top: 4px; }
@media (max-width: 768px) {
  .lp-wrapper #sec-guarantee .gr-cards{ grid-template-columns: 1fr; }
  .lp-wrapper #sec-guarantee .gr-card{ padding: 26px 20px; }
}

/* ================== sec-founder（作り手から・手紙型） ================== */
.lp-wrapper #sec-founder{ background: var(--bg-white); color: var(--text); }
.lp-wrapper #sec-founder .fd-inner{ max-width: 680px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper #sec-founder .fd-label{
  font-size: var(--fs-note); font-weight: 700; letter-spacing: var(--ls-heading);
  color: var(--text-sub); margin-bottom: 16px;
}
.lp-wrapper #sec-founder h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.55;
  letter-spacing: var(--ls-heading); color: var(--text); margin-bottom: 32px;
}
.lp-wrapper #sec-founder .fd-head{ display: flex; align-items: center; gap: 16px; margin-bottom: 28px; }
.lp-wrapper #sec-founder .fd-head img{
  width: 72px; height: 72px; border-radius: 50%; object-fit: cover; flex-shrink: 0;
  box-shadow: var(--shadow-card);
}
.lp-wrapper #sec-founder .fd-head .fd-name{ font-size: var(--fs-body); font-weight: 700; color: var(--text); }
.lp-wrapper #sec-founder .fd-head .fd-name span{ display: block; font-size: var(--fs-micro); font-weight: 700; color: var(--text-sub); margin-top: 2px; }
.lp-wrapper #sec-founder .fd-letter{ border-left: 3px solid var(--gold); padding-left: 22px; }
.lp-wrapper #sec-founder .fd-letter p{ font-size: var(--fs-body); line-height: 2.2; color: var(--text); margin-bottom: 18px; }
.lp-wrapper #sec-founder .fd-letter .fd-core{
  font-size: var(--fs-lead); font-weight: 700; line-height: 1.9; color: var(--gold); margin-bottom: 18px;
}
.lp-wrapper #sec-founder .fd-sign{ text-align: right; font-size: var(--fs-note); font-weight: 700; color: var(--text-sub); margin-top: 26px; }

/* ================== sec-final-cta（今切り替えるなら・朝フォトオーバーレイ型） ================== */
.lp-wrapper #sec-final-cta{
  position: relative; overflow: hidden;
  background: var(--bg-dark); color: #fff;
}
.lp-wrapper #sec-final-cta .fc-bg{
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; object-position: center;
}
.lp-wrapper #sec-final-cta .fc-overlay{
  position: absolute; inset: 0;
  background: linear-gradient(to right, rgba(0,0,0,.72) 0%, rgba(0,0,0,.55) 55%, rgba(0,0,0,.35) 100%);
}
.lp-wrapper #sec-final-cta .fc-inner{
  position: relative; max-width: 680px; margin: 0 auto; padding: 0 20px; text-align: left;
}
.lp-wrapper #sec-final-cta .fc-eyebrow{
  display: inline-block; font-size: var(--fs-note); font-weight: 700; letter-spacing: var(--ls-heading);
  color: #fff; background: rgba(255,255,255,.14);
  padding: 6px 16px; border-radius: var(--radius-pill); margin-bottom: 20px;
}
.lp-wrapper #sec-final-cta h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.55;
  letter-spacing: var(--ls-heading); color: #fff; margin-bottom: 22px;
}
.lp-wrapper #sec-final-cta .fc-scene{ font-size: var(--fs-body); line-height: 2.0; color: rgba(255,255,255,.88); margin-bottom: 18px; }
.lp-wrapper #sec-final-cta .fc-inner .fc-voice{
  font-size: calc(var(--fs-lead) * 1.3); font-weight: 800; letter-spacing: var(--ls-heading);
  color: #fff; margin-bottom: 34px;
}
.lp-wrapper #sec-final-cta .fc-reasons{ display: grid; gap: 12px; margin-bottom: 30px; }
.lp-wrapper #sec-final-cta .fc-reason{
  display: flex; align-items: flex-start; gap: 12px;
  background: rgba(255,255,255,.10); border: 1px solid rgba(255,255,255,.18);
  border-radius: var(--radius-card); padding: 14px 18px;
}
.lp-wrapper #sec-final-cta .fc-reason svg{ width: 20px; height: 20px; flex-shrink: 0; margin-top: 3px; color: var(--bridge); }
.lp-wrapper #sec-final-cta .fc-reason p{ font-size: var(--fs-note); line-height: 1.8; color: #fff; }
.lp-wrapper #sec-final-cta .fc-reason p strong{ color: var(--bridge); }
.lp-wrapper #sec-final-cta .fc-review{
  display: flex; align-items: flex-start; gap: 12px;
  background: rgba(255,255,255,.10); border: 1px solid rgba(255,255,255,.18);
  border-radius: var(--radius-card); padding: 16px 18px; margin-bottom: 34px;
}
.lp-wrapper #sec-final-cta .fc-review .avatar{
  width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;
  background: rgba(255,255,255,.22);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-note); font-weight: 700; color: #fff;
}
.lp-wrapper #sec-final-cta .fc-review .stars{ color: var(--star); font-size: var(--fs-note); letter-spacing: 2px; margin-bottom: 4px; }
.lp-wrapper #sec-final-cta .fc-review .fc-review-body p{ font-size: var(--fs-note); line-height: 1.8; color: #fff; margin-bottom: 4px; }
.lp-wrapper #sec-final-cta .fc-review .src{ font-size: var(--fs-micro); color: rgba(255,255,255,.65); }
.lp-wrapper #sec-final-cta .fc-badges{ display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
.lp-wrapper #sec-final-cta .fc-badges span{
  display: inline-flex; align-items: center; gap: 6px;
  font-size: var(--fs-micro); font-weight: 700; color: #fff;
  background: rgba(255,255,255,.14); border-radius: var(--radius-pill); padding: 6px 14px;
  white-space: nowrap;
}
.lp-wrapper #sec-final-cta .fc-badges svg{ width: 14px; height: 14px; color: var(--bridge); }
.lp-wrapper #sec-final-cta .btn-primary{ white-space: nowrap; }
.lp-wrapper #sec-final-cta .fc-close{ margin-top: 26px; }
.lp-wrapper #sec-final-cta .fc-close .bridge-line{ color: var(--bridge); }
@media (max-width: 768px) {
  .lp-wrapper #sec-final-cta .fc-overlay{ background: rgba(0,0,0,.62); }
  .lp-wrapper #sec-final-cta .fc-inner .fc-voice{ font-size: var(--fs-lead); }
}

/* ================== sec-faq（よくある質問・最小アコーディオン型） ================== */
.lp-wrapper #sec-faq{ background: var(--bg-white); color: var(--text); }
.lp-wrapper #sec-faq .fq-inner{ max-width: 680px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper #sec-faq .fq-label{
  font-size: var(--fs-note); font-weight: 700; letter-spacing: var(--ls-heading);
  color: var(--text-sub); margin-bottom: 16px;
}
.lp-wrapper #sec-faq h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.55;
  letter-spacing: var(--ls-heading); color: var(--text); margin-bottom: 32px;
}
.lp-wrapper #sec-faq details{ border-top: 1px solid rgba(0,0,0,.12); }
.lp-wrapper #sec-faq details:last-of-type{ border-bottom: 1px solid rgba(0,0,0,.12); }
.lp-wrapper #sec-faq summary{
  display: flex; align-items: flex-start; justify-content: space-between; gap: 14px;
  padding: 18px 2px; cursor: pointer; list-style: none;
  font-size: var(--fs-body); font-weight: 700; line-height: 1.7; color: var(--text);
}
.lp-wrapper #sec-faq summary::-webkit-details-marker{ display: none; }
.lp-wrapper #sec-faq summary svg{ width: 18px; height: 18px; flex-shrink: 0; margin-top: 5px; color: var(--gold); transition: transform .25s ease; }
.lp-wrapper #sec-faq details[open] summary svg{ transform: rotate(180deg); }
.lp-wrapper #sec-faq .fq-a{ padding: 0 2px 20px; font-size: var(--fs-note); line-height: 2.0; color: var(--text-sub); }

/* ================== sec-spec（製品仕様・数字先出しハイブリッド型） ================== */
/* 出典: library/design-system/sections/spec/数字先出しハイブリッド型.html（デザインラボ採用済み雛形） */
/* ===== このセクション専用CSS（トークン変数のみ） ===== */
.lp-wrapper #sec-spec{ background: var(--bg-gray); }
.lp-wrapper #sec-spec .sh-inner{ max-width: 880px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper #sec-spec .sh-eyebrow{
  display: inline-block; font-size: var(--fs-note); font-weight: 700; letter-spacing: var(--ls-heading);
  color: var(--gold); background: var(--gold-tint);
  padding: 6px 16px; border-radius: var(--radius-pill); margin-bottom: 20px;
}
.lp-wrapper #sec-spec h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.5;
  letter-spacing: var(--ls-heading); color: var(--text); margin-bottom: 40px;
}
/* 上段: 主役4スタッツ（白カード・数字特大） */
.lp-wrapper #sec-spec .sh-stats{ display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 48px; }
.lp-wrapper #sec-spec .sh-stat{
  background: var(--bg-white); border-radius: var(--radius-card);
  padding: 26px 18px; box-shadow: var(--shadow-card); text-align: center;
}
.lp-wrapper #sec-spec .sh-stat .label{ font-size: var(--fs-micro); font-weight: 700; color: var(--text-sub); margin-bottom: 8px; }
.lp-wrapper #sec-spec .sh-stat .num{
  font-size: var(--fs-stat); font-weight: 800; letter-spacing: var(--ls-num);
  line-height: 1.1; color: var(--gold); white-space: nowrap;
}
.lp-wrapper #sec-spec .sh-stat .num em{
  font-style: normal; font-size: 0.45em; font-weight: 700; color: var(--text-sub);
  letter-spacing: var(--ls-heading); margin-left: 4px;
}
.lp-wrapper #sec-spec .sh-stat .cond{ font-size: var(--fs-micro); color: var(--text-sub); margin-top: 6px; line-height: 1.5; }
/* 下段: cofo式罫線表（従属・静かに補完） */
.lp-wrapper #sec-spec .sh-table{ border-top: 1px solid rgba(0,0,0,.15); }
.lp-wrapper #sec-spec .sh-row{
  display: grid; grid-template-columns: 11em 1fr; align-items: baseline; gap: 16px;
  padding: 16px 4px; border-bottom: 1px solid rgba(0,0,0,.1);
}
.lp-wrapper #sec-spec .sh-row dt{ font-size: var(--fs-note); color: var(--text-sub); }
.lp-wrapper #sec-spec .sh-row dd{ font-size: var(--fs-body); color: var(--text); line-height: 1.8; }
.lp-wrapper #sec-spec .sh-note{ font-size: var(--fs-micro); color: var(--text-sub); opacity: .85; margin-top: 20px; line-height: 1.7; }
@media (max-width: 768px) {
  .lp-wrapper #sec-spec .sh-stats{ grid-template-columns: 1fr 1fr; gap: 10px; }
  .lp-wrapper #sec-spec .sh-row{ grid-template-columns: 1fr; gap: 4px; padding: 12px 2px; }
}

/* ================== sec-closing-cta（締めの最終CTA・製品背景オーバーレイ×信頼性） ================== */
/* タイヤの上のRIDE本体（暗ガレージ演出・RIDE_021）をフル背景に敷き、ダークオーバーレイ＋
   ゆっくりズーム（ケンバーンズ）でダイナミックに。テキスト・バッジ・CTAを白文字で重ねる。 */
.lp-wrapper #sec-closing-cta{
  position: relative; overflow: hidden;
  background: var(--bg-dark); color: #fff; text-align: center;
}
.lp-wrapper #sec-closing-cta .cc-bg{
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; object-position: center;
  transform: scale(1.06);
  filter: brightness(1.18) saturate(1.05);
  animation: cc-kenburns 22s ease-in-out infinite alternate;
}
@keyframes cc-kenburns {
  from { transform: scale(1.06); }
  to   { transform: scale(1.16); }
}
@media (prefers-reduced-motion: reduce) {
  .lp-wrapper #sec-closing-cta .cc-bg{ animation: none; }
}
.lp-wrapper #sec-closing-cta .cc-overlay{
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse at 50% 46%, rgba(0,0,0,0) 0%, rgba(0,0,0,.40) 100%),
    linear-gradient(to bottom, rgba(0,0,0,.34) 0%, rgba(0,0,0,.10) 45%, rgba(0,0,0,.70) 100%);
}
.lp-wrapper #sec-closing-cta .cc-inner{
  position: relative; z-index: 1;
  max-width: 860px; width: calc(100% - 40px); margin: 0 auto;
}
.lp-wrapper #sec-closing-cta .cc-eyebrow{
  display: inline-block; font-size: var(--fs-note); font-weight: 700; letter-spacing: var(--ls-heading);
  color: var(--gold-light); background: rgba(255,255,255,.10); backdrop-filter: blur(3px);
  padding: 6px 16px; border-radius: var(--radius-pill); margin-bottom: 22px;
}
.lp-wrapper #sec-closing-cta h2{
  font-size: min(var(--fs-hero-compact), 6.6vw); font-weight: 700; line-height: 1.3;
  letter-spacing: var(--ls-heading); color: #fff; margin-bottom: 18px;
  white-space: nowrap; text-shadow: 0 2px 24px rgba(0,0,0,.5);
}
.lp-wrapper #sec-closing-cta .cc-lead{ font-size: var(--fs-lead); line-height: 1.9; color: rgba(255,255,255,.9); margin-bottom: 34px; text-shadow: 0 1px 12px rgba(0,0,0,.5); }
.lp-wrapper #sec-closing-cta .cc-badges{ display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-bottom: 40px; }
.lp-wrapper #sec-closing-cta .cc-badges span{
  display: inline-flex; align-items: center; gap: 7px;
  font-size: var(--fs-note); font-weight: 700; color: #fff;
  background: rgba(0,0,0,.40); border: 1px solid rgba(255,255,255,.22); backdrop-filter: blur(4px);
  padding: 10px 18px; border-radius: var(--radius-pill); white-space: nowrap;
}
.lp-wrapper #sec-closing-cta .cc-badges svg{ width: 15px; height: 15px; flex-shrink: 0; color: var(--gold-light); }
.lp-wrapper #sec-closing-cta .btn-primary{ font-size: 20px; padding: 20px 48px; box-shadow: 0 8px 30px rgba(30,111,217,.45); }
.lp-wrapper #sec-closing-cta .cc-price{ font-size: var(--fs-lead); font-weight: 800; color: #fff; margin-bottom: 20px; text-shadow: 0 1px 12px rgba(0,0,0,.5); }
.lp-wrapper #sec-closing-cta .cc-price span{ font-size: var(--fs-note); font-weight: 700; color: rgba(255,255,255,.78); margin-left: 6px; }
.lp-wrapper #sec-closing-cta .cc-note{ font-size: var(--fs-note); color: rgba(255,255,255,.68); margin-top: 16px; }
@media (max-width: 768px) {
  .lp-wrapper #sec-closing-cta{ text-align: left; }
  .lp-wrapper #sec-closing-cta h2{ font-size: clamp(28px, 7.6vw, 40px); white-space: normal; }
  .lp-wrapper #sec-closing-cta .cc-badges{ justify-content: flex-start; }
  .lp-wrapper #sec-closing-cta .cc-overlay{ background: linear-gradient(to bottom, rgba(0,0,0,.44) 0%, rgba(0,0,0,.26) 40%, rgba(0,0,0,.76) 100%); }
  .lp-wrapper #sec-closing-cta .cc-badges span{ font-size: var(--fs-micro); padding: 8px 14px; }
}

/* ================== フッター ================== */
.lp-wrapper #lp-footer{ background: var(--bg-dark); padding: 48px 20px 32px; text-align: center; }
.lp-wrapper #lp-footer .footer-logo{ height: 32px; width: auto; display: block; margin: 0 auto 20px; opacity: 0.85; }
.lp-wrapper #lp-footer p{ color: rgba(255,255,255,.6); font-size: var(--fs-micro); }


/* ---- eyebrow（見出し上の小ラベル）を一時非表示（2026-07-14 市山さん指示） ----
   削除はせず表示だけ止める。復活させるときはこのブロックを消す */
.lp-wrapper [class*="eyebrow"]{ display: none !important; }

</style>

<div id="lp-{{ section.id }}" class="lp-wrapper">
<section
  id="sec-hero"
  data-section-type="hero"
  data-section-name="FV（問題提起＋共感）キャッチ主役写真型"
  data-section-order="1"
>
  <div class="hero-bg">
    <img data-slot="hero-bg" data-asset-id="SHOPIFY-mama-cycle-hero-1"
         src="https://cdn.shopify.com/s/files/1/0564/1591/1987/files/mama-cycle-hero-1.png?v=1784180365"
         alt="[ヒーロー背景: 子ども乗せ自転車とママの実写。下部は暗め（白文字の可読性確保）]" />
  </div>
  <img class="hero-brand" data-slot="brand-logo" data-asset-id="PANP_LOGO_WHITE" src="https://drive.google.com/thumbnail?id=1mp5JwzqAc7nO6ESyHM0fpd7EENf8lC0b&sz=w1600" alt="PANP" />
  <div class="hero-inner">
    <h1 data-slot="headline" class="fade-in">空気を入れるたびに、<br>「面倒だな」と思っていませんか。</h1>
    <p class="hero-core fade-in delay-1" data-slot="core-line">あの面倒な空気入れが、<span class="hd-nowrap"><em>あなたの代わりに、ボタンひとつで</em>終わる。</span></p>
    <div class="worry-chips fade-in delay-2" data-slot="worry-chips">
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"/><polyline points="16 17 22 17 22 11"/></svg>ペダルが重い</span>
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/><circle cx="12" cy="12" r="4"/></svg>また汗をかく</span>
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>つい後回し</span>
    </div>
  </div>
  <div class="scroll-hint">
    <span>scroll</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
         stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </div>
</section>

<section
  id="sec-empathy"
  class="section-padding"
  data-section-type="empathy"
  data-section-name="問題提起＋共感（この面倒はずっと続く）"
  data-section-order="2"
>
  <div class="em-inner">
    <p class="em-label fade-in" data-slot="eyebrow">その面倒、ずっと続きます</p>
    <h2 class="fade-in" data-slot="headline">この作業は、いったい、いつまで続くのでしょうか。</h2>
    <div class="em-body" data-slot="empathy-body">
      <p class="slide-up">手動の空気入れを、立ったまま体重をかけて、何度も押す。夏は汗がにじみ、冬は手がかじかんで、入れ終わるころには、腕がだるくなっている。好きでやっているわけではないけれど、やらなきゃいけないから、辛いのを我慢して、続けてきた。</p>
      <p class="slide-up">タイヤの空気は、いつのまにか減っていて、ペダルがだんだん重くなってくる。そろそろ入れなきゃ、と思う。でも、あの重い空気入れを引っぱり出して、また汗をかくのかと考えると、つい、後回しにしてしまう。</p>
    </div>
    <div class="em-voice slide-up" data-slot="voice">
      <div class="avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
      <div class="bubble">
        <div class="v-meta"><svg class="quote-mark" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/></svg><span class="src">お客様の声</span></div>
        <p>「夏場に手で汗かきながら空気入れていた時、馬鹿らしくなった」</p>
      </div>
    </div>
    <div class="em-body slide-up" data-slot="empathy-loop">
      <p>自転車に乗るかぎり、空気は何度でも抜けて、同じことが、何度でも巡ってきます。後回しにすれば、ペダルは重いまま。入れれば、また汗をかく。</p>
    </div>
    <p class="em-close slide-up" data-slot="close-line">どちらを選んでも、この面倒は、これから先も<span class="accent">ずっと、あなたについて回ります。</span></p>
  </div>
</section>

<section
  id="sec-awareness"
  class="section-padding"
  data-section-type="empathy"
  data-section-name="気づき（家電は自動なのに空気入れだけ手動）"
  data-section-order="3"
>
  <div class="aw-inner">
