{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .bestrate-text,
  .bestrate-image {
    text-align: center;
  }

  .bestrate-image img {
    display: block;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }

  #delivery-datetime--isRender .delivery-title.title-border {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #checkout.cart__checkout-button {
      min-height: 5.6rem;
      padding: 1.2rem 1rem;
      font-size: 2.2rem;
      line-height: 1.4;
      white-space: nowrap;
    }
  }

{%- endstyle -%}

<div
  class="gradient color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
>
  <div class="page-width">
    <div class="cart__footer isolate section-{{ section.id }}-padding">
      {%- if settings.show_cart_note -%}
        {% comment %} <cart-note class="cart__note field">
          <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea
            class="text-area field__input"
            name="note"
            form="cart"
            id="Cart-note"
            placeholder="{{ 'sections.cart.note' | t }}"
          >{{ cart.note }}</textarea>
        </cart-note> {% endcomment %}
      {%- endif -%}

      <div class="cart__blocks">
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'subtotal' -%}
              <div class="js-contents" {{ block.shopify_attributes }}>
                <div>
                  {%- if cart.cart_level_discount_applications.size > 0 -%}
                    <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                      {%- for discount in cart.cart_level_discount_applications -%}
                        <li class="discounts__discount discounts__discount--position">
                          {%- render 'icon-discount' -%}
                          {{ discount.title }}
                          (-{{ discount.total_allocated_amount | money }})
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

                <div class="totals">
                  <h2 class="totals__total">{{ 'sections.cart.estimated_total' | t }}</h2>
                  <p class="totals__total-value">{{ cart.total_price | money_with_currency | remove: 'JPY' }}</p>
                </div>

                <small class="tax-note caption-large rte">
                  {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                    {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- elsif cart.taxes_included -%}
                    {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
                  {%- elsif shop.shipping_policy.body != blank -%}
                    {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
                  {%- else -%}
                    {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
                  {%- endif -%}
                </small>
              </div>
            {%- else -%}
              <div class="cart__ctas" {{ block.shopify_attributes }}>
                <noscript>
                  <button type="submit" class="cart__update-button button button--secondary" form="cart">
                    {{ 'sections.cart.update' | t }}
                  </button>
                </noscript>

                <button
                  type="submit"
                  id="checkout"
                  class="cart__checkout-button button"
                  name="checkout"
                  {% if cart == empty %}
                    disabled
                  {% endif %}
                  form="cart"
                >
                  {{ 'sections.cart.checkout' | t }}
                </button>
              </div>

              <div class="bestrate-text">
                <small>翌日出荷／1年保証<br>どんな理由でも返品OK</small>
              </div>
              <div class="bestrate-image">
                <img src="{{ 'bestrate_white_02.jpg' | file_img_url: 'master' }}" alt="bestrate" width="300" height="76"style="box-shadow: 0 2px 11px 0 rgba(0, 0, 0, 0.08);">
              </div>

              {%- comment -%}
                {%- if additional_checkout_buttons -%}
                  <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                    {{ content_for_additional_checkout_buttons }}
                  </div>
                {%- endif -%}
              {%- endcomment -%}
          {%- endcase -%}
        {% endfor %}

        <div id="cart-errors"></div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const deliveryRootSelector = '#delivery-datetime--isRender';

    function replaceDeliveryAppCopy() {
      const deliveryRoot = document.querySelector(deliveryRootSelector);
      if (!deliveryRoot) return;

      const postcodeLabel = Array.from(deliveryRoot.querySelectorAll('.delivery-title')).find(function (label) {
        return label.textContent.includes('郵便番号');
      });
      if (postcodeLabel && postcodeLabel.textContent.trim() !== 'お届け先の郵便番号') {
        postcodeLabel.textContent = 'お届け先の郵便番号';
      }

      const postcodeInput = deliveryRoot.querySelector('input[type="tel"]');
      if (
        postcodeInput &&
        postcodeInput.getAttribute('placeholder') !== '例: 1234567（「-」は除く、数字7桁）'
      ) {
        postcodeInput.setAttribute('placeholder', '例: 1234567（「-」は除く、数字7桁）');
      }

      const errorMessages = deliveryRoot.querySelectorAll('.icon-text');
      errorMessages.forEach(function (message) {
        if (message.textContent.trim() !== '郵便番号は7桁で入力してください') return;

        const textNode = Array.from(message.childNodes).find(function (node) {
          return node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '';
        });

        if (textNode) {
          textNode.textContent = '「-」は除いて、数字7桁でご入力ください。';
        } else {
          message.appendChild(document.createTextNode('「-」は除いて、数字7桁でご入力ください。'));
        }
      });

      const minDeliveryDate = deliveryRoot.querySelector('.delivery-mindate-caution');
      if (minDeliveryDate) {
        const minDeliveryDateLabel = Array.from(minDeliveryDate.childNodes).find(function (node) {
          return node.nodeType === Node.TEXT_NODE && node.textContent.trim().startsWith('最短ご指定可能日');
        });
        if (minDeliveryDateLabel) {
          minDeliveryDateLabel.textContent = minDeliveryDateLabel.textContent.replace(
            '最短ご指定可能日',
            '最短のご指定可能日'
          );
        }
      }

      const deliveryNotice = Array.from(deliveryRoot.querySelectorAll('p, div, span')).find(function (element) {
        return (
          element.children.length === 0 &&
          element.textContent.trim() ===
            '※日付・時間を指定いただいた場合でも、地域や配送業者の都合によって指定日・指定時間に配達できない場合がございます。'
        );
      });
      if (deliveryNotice) {
        deliveryNotice.textContent = '※お住まいの場所や配送業者の都合により、';
        deliveryNotice.appendChild(document.createElement('br'));
        deliveryNotice.appendChild(document.createTextNode('　ご希望の日時に配達できない場合がございます。'));
      }
    }

    replaceDeliveryAppCopy();

    const deliveryAppObserver = new MutationObserver(replaceDeliveryAppCopy);
    const cartBlocks = document.querySelector('.cart__blocks');
    if (!cartBlocks) return;

    deliveryAppObserver.observe(cartBlocks, {
      childList: true,
      subtree: true,
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function isIE() {
      const ua = window.navigator.userAgent;
      const msie = ua.indexOf('MSIE ');
      const trident = ua.indexOf('Trident/');

      return msie > 0 || trident > 0;
    }

    if (!isIE()) return;
    const cartSubmitInput = document.createElement('input');
    cartSubmitInput.setAttribute('name', 'checkout');
    cartSubmitInput.setAttribute('type', 'hidden');
    document.querySelector('#cart').appendChild(cartSubmitInput);
    document.querySelector('#checkout').addEventListener('click', function (event) {
      document.querySelector('#cart').submit();
    });
  });
</script>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}

<script>
  function observeElementAndEnableButton(targetId, buttonId, observerSelector) {
    const targetNode = document.getElementById(targetId);
    if (!targetNode) {
      console.error(`Element with ID ${targetId} not found.`);
      return;
    }

    const button = document.getElementById(buttonId);
    if (!button) {
      console.error(`Element with ID ${buttonId} not found.`);
      return;
    }

    button.disabled = true;
    console.log('--------checkoutを非活性化--------');

    const config = {
      attributes: true,
      childList: true,
      subtree: true,
    };

    function callback(mutationsList, observer) {
      for (const mutation of mutationsList) {
        if (mutation.type === 'childList') {
          if (document.querySelector(observerSelector)) {
            button.disabled = false;
            console.log('--------checkoutを活性化--------');
          }
          return;
        }
      }
    }

    const observer = new MutationObserver(callback);
    observer.observe(targetNode, config);
  }

  document.addEventListener('DOMContentLoaded', function () {
    observeElementAndEnableButton('cart-delivery-datetime_section', 'checkout', '.delivery-select-container__select');
  });
</script>
