     sec-chapter3: 第3章（雛形: comparison/横バー性能対比型）
     ============================================================ -->
<section
  id="sec-chapter3"
  data-section-type="howto"
  data-section-name="第3章 空気を入れる頻度"
  data-section-order="5"
  class="section-padding"
>
  <div class="sec-inner">
    <h2 class="sec-h2 fade-in" data-slot="ch3-headline">空気を入れる頻度は？</h2>
    <p class="sec-lead" data-slot="ch3-lead">乗り物の空気圧を日頃からチェックすることが大事だと分かっていても、「どのくらいの頻度で空気を入れればいいの？」と疑問に思う方も多いでしょう。一般的な目安としては、以下のようになります。</p>

    <!-- 横バー性能対比型: 頻度の目安 -->
    <div class="hb-group slide-up" style="margin-top: 0;" data-slot="ch3-freq-chart">
      <p class="hb-metric">空気を入れる頻度の目安</p>
      <div class="hb-row is-accent">
        <span class="hb-label">ロードバイク</span>
        <div class="hb-track"><div class="hb-fill" data-w="26%"><span class="hb-value">週1回</span></div></div>
      </div>
      <div class="hb-row is-accent">
        <span class="hb-label">クロスバイク</span>
        <div class="hb-track"><div class="hb-fill" data-w="26%"><span class="hb-value">週1回</span></div></div>
      </div>
      <div class="hb-row">
        <span class="hb-label">ママチャリ</span>
        <div class="hb-track"><div class="hb-fill" data-w="50%">&nbsp;</div></div>
        <span class="hb-value-out">2週間に1回</span>
      </div>
      <div class="hb-row">
        <span class="hb-label">マウンテンバイク</span>
        <div class="hb-track"><div class="hb-fill" data-w="50%">&nbsp;</div></div>
        <span class="hb-value-out">2週間に1回</span>
      </div>
      <div class="hb-row">
        <span class="hb-label">自動車</span>
        <div class="hb-track"><div class="hb-fill" data-w="100%">&nbsp;</div></div>
