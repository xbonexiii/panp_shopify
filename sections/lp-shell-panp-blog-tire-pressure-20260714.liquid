<style>

/* ============================================================
   デザイントークン（design-system/tokens.css 準拠・
   PANP共通ブルーへ値のみ差し替え。変数名は共通のまま）
   ============================================================ */
:root {
  /* ---- 色（値のみブルー系に差し替え） ---- */
  --gold: #0071e3;
  --gold-light: #64a8ef;
  --gold-tint: rgba(0,113,227,.08);
  --blue: #0071e3;
  --text: #1d1d1f;
  --text-sub: #6e6e73;
  --bg-white: #ffffff;
  --bg-gray: #f5f5f7;
  --bg-dark: #1d1d1f;
  --star: #f5c518;

  /* ---- タイポグラフィ（サイズ階層） ---- */
  --fs-hero: clamp(32px, 5.5vw, 68px);
  --fs-hero-compact: clamp(30px, 4.2vw, 54px);
  --fs-h2: clamp(28px, 3.5vw, 44px);
  --fs-h3: 22px;
  --fs-stat: clamp(28px, 3.6vw, 48px);
  --fs-lead: clamp(16px, 1.6vw, 20px);
  --fs-body: 17px;
  --fs-note: 13px;
  --fs-micro: 12px;

  /* ---- 字間 ---- */
  --ls-hero: -0.03em;
  --ls-heading: -0.02em;
  --ls-num: -0.04em;

  /* ---- 角丸（3階層固定） ---- */
  --radius-card: 24px;
  --radius-image: 16px;
  --radius-badge: 12px;
  --radius-pill: 50px;

  /* ---- 影（1種のみ） ---- */
  --shadow-card: 0 2px 20px rgba(0,0,0,.06);

  /* ---- セクション余白 ---- */
  --section-pad: 100px;
  --section-pad-sp: 64px;
}

/* ============================================================
   ベースCSS（design-system/base.css より内包）
   ============================================================ */
.lp-wrapper *,  .lp-wrapper *::before,  .lp-wrapper *::after{ box-sizing: border-box; margin: 0; padding: 0; }
.lp-wrapper{ scroll-behavior: smooth; }
.lp-wrapper{
  font-family: Helvetica, Arial, sans-serif;
  color: var(--text); font-size: var(--fs-body); line-height: 1.7; overflow-x: hidden;
  background: var(--bg-white);
}
.lp-wrapper img{ max-width: 100%; height: auto; display: block; }
.lp-wrapper a{ color: inherit; text-decoration: none; }
.lp-wrapper section{ width: 100%; }
/* 見出しは常にコンテナの色を継承（Shopify黒文字化バグ対策・省略禁止） */
.lp-wrapper h1,  .lp-wrapper h2,  .lp-wrapper h3,  .lp-wrapper h4,  .lp-wrapper h5,  .lp-wrapper h6{ color: inherit; }
.lp-wrapper .container{ max-width: 1200px; margin: 0 auto; padding: 0 40px; }
.lp-wrapper .section-padding{ padding-top: var(--section-pad); padding-bottom: var(--section-pad); }
@media (max-width: 768px) {
  .lp-wrapper{ font-size: 16px; }
  .lp-wrapper .container{ padding: 0 20px; }
  .lp-wrapper .section-padding{ padding-top: var(--section-pad-sp); padding-bottom: var(--section-pad-sp); }
}
.lp-wrapper .fade-in{
  opacity: 0; transform: translateY(24px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.lp-wrapper .fade-in.visible{ opacity: 1; transform: translateY(0); }
.lp-wrapper .slide-left{ opacity: 0; transform: translateX(-48px); transition: opacity 0.8s ease, transform 0.8s ease; }
.lp-wrapper .slide-right{ opacity: 0; transform: translateX(48px);  transition: opacity 0.8s ease, transform 0.8s ease; }
.lp-wrapper .slide-up{ opacity: 0; transform: translateY(32px);  transition: opacity 0.7s ease, transform 0.7s ease; }
.lp-wrapper .slide-left.visible,  .lp-wrapper .slide-right.visible,  .lp-wrapper .slide-up.visible{ opacity: 1; transform: none; }
.lp-wrapper .delay-1{ transition-delay: .15s; }
.lp-wrapper .delay-2{ transition-delay: .3s; }
.lp-wrapper .delay-3{ transition-delay: .45s; }
.lp-wrapper .delay-4{ transition-delay: .6s; }
@media (prefers-reduced-motion: reduce) {
  .lp-wrapper .fade-in,  .lp-wrapper .slide-up,  .lp-wrapper .slide-left,  .lp-wrapper .slide-right{ opacity: 1; transform: none; transition: none; }
}
.lp-wrapper .scroll-hint{
  position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  color: rgba(255,255,255,0.55); font-size: 10px; letter-spacing: 0.15em;
  text-transform: uppercase; animation: scroll-bounce 2.2s infinite;
}
.lp-wrapper .scroll-hint svg{ width: 20px; height: 20px; }
@keyframes scroll-bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.55; }
  50%       { transform: translateX(-50%) translateY(8px); opacity: 0.9; }
}

/* ============================================================
   共通部品: 章eyebrowピル・見出し・本文（雛形共通パターン）
   ============================================================ */
.lp-wrapper .sec-inner{ max-width: 760px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper .sec-inner--wide{ max-width: 880px; }
.lp-wrapper .sec-h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.55;
  letter-spacing: var(--ls-heading); color: var(--text); margin-bottom: 16px;
}
.lp-wrapper .sec-h3{
  font-size: var(--fs-h3); font-weight: 700; line-height: 1.6;
  letter-spacing: var(--ls-heading); color: var(--text);
  margin-top: 56px; margin-bottom: 14px;
}
.lp-wrapper .sec-lead{ font-size: var(--fs-body); line-height: 2.0; color: var(--text-sub); margin-bottom: 36px; }
.lp-wrapper .sec-body{ font-size: var(--fs-body); line-height: 2.0; color: var(--text-sub); margin-bottom: 16px; }
.lp-wrapper .sec-body strong{ color: var(--text); }
.lp-wrapper .article-photo{ margin: 28px 0 36px; }
.lp-wrapper .article-photo img{
  width: 100%; object-fit: cover; display: block;
  border-radius: var(--radius-image); box-shadow: var(--shadow-card);
}
.lp-wrapper .article-photo figcaption{ font-size: var(--fs-note); color: var(--text-sub); margin-top: 10px; text-align: center; line-height: 1.7; }
.lp-wrapper .article-photo--diagram img{ object-fit: contain; background: var(--bg-white); }


/* ============================================================
   sec-hero（雛形: hero/商流2FV_キャッチ主役写真型）
   ============================================================ */
.lp-wrapper #sec-hero{
  position: relative; min-height: 100svh;
  display: flex; align-items: center; /* テキストは縦中央寄せ（雛形第2Rレビュー反映） */
  color: #fff;
}
.lp-wrapper #sec-hero .hero-bg{ position: absolute; inset: 0; overflow: hidden; }
.lp-wrapper #sec-hero .hero-bg img{ width: 100%; height: 100%; object-fit: cover; }
.lp-wrapper #sec-hero .hero-bg::after{
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.78) 0%, rgba(0,0,0,.45) 50%, rgba(0,0,0,.15) 100%);
}
.lp-wrapper #sec-hero .hero-inner{
  position: relative; z-index: 1; width: 100%;
  max-width: 1200px; margin: 0 auto;
  padding-left: 40px; padding-right: 40px; padding-top: 72px; padding-bottom: 72px;
}
.lp-wrapper #sec-hero h1{
  font-size: var(--fs-hero); font-weight: 700;
  line-height: 1.35; letter-spacing: var(--ls-hero);
  color: #fff; /* ダーク上の見出しは明示（Shopify対策） */
  max-width: 680px; margin-bottom: 20px;
}
.lp-wrapper #sec-hero .hero-core{
  font-size: var(--fs-lead); font-weight: 700; line-height: 1.9;
  color: rgba(255,255,255,.92); max-width: 680px;
  text-shadow: 0 1px 12px rgba(0,0,0,.55);
}
.lp-wrapper #sec-hero .hero-core em{ font-style: normal; color: var(--gold-light); }
.lp-wrapper #sec-hero .hd-nowrap{ white-space: nowrap; } /* 行末1文字の孤立を防ぐ（手動br禁止） */
/* 不安ワードチップはキャッチ＋芯の一言の下（雛形第3Rレビュー反映） */
.lp-wrapper #sec-hero .worry-chips{ display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
.lp-wrapper #sec-hero .worry-chips span{
  display: inline-flex; align-items: center; gap: 6px;
  font-size: var(--fs-note); font-weight: 500; color: rgba(255,255,255,.9);
  border: 1px solid rgba(255,255,255,.35);
  padding: 7px 14px; border-radius: var(--radius-pill);
  backdrop-filter: blur(2px);
}
.lp-wrapper #sec-hero .worry-chips svg{ width: 15px; height: 15px; }
@media (max-width: 768px) {
  .lp-wrapper #sec-hero .hero-inner{ padding-left: 20px; padding-right: 20px; padding-top: 64px; padding-bottom: 88px; }
  .lp-wrapper #sec-hero h1{ font-size: calc(var(--fs-hero) * 0.82); line-height: 1.4; }
}

/* ============================================================
   sec-toc（目次・記事ページ固有）
   ============================================================ */
.lp-wrapper #sec-toc{ background: var(--bg-gray); padding-top: 44px; padding-bottom: 44px; }
.lp-wrapper #sec-toc .toc-label{
  font-size: var(--fs-micro); font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--gold); margin-bottom: 14px;
}
.lp-wrapper #sec-toc .toc-title{ font-size: var(--fs-lead); font-weight: 700; margin-bottom: 18px; line-height: 1.5; color: var(--text); }
.lp-wrapper #sec-toc .toc-list{ list-style: none; display: grid; gap: 8px; }
.lp-wrapper #sec-toc .toc-list li a{
  display: flex; align-items: flex-start; gap: 12px;
  padding: 13px 16px;
  background: var(--bg-white); border-radius: var(--radius-badge);
  box-shadow: var(--shadow-card);
  font-size: var(--fs-note); font-weight: 700; color: var(--text);
  transition: transform 0.2s, background 0.2s; line-height: 1.6;
}
.lp-wrapper #sec-toc .toc-list li a:hover{ background: var(--gold-tint); transform: translateX(4px); }
.lp-wrapper #sec-toc .toc-num{
  flex-shrink: 0; font-size: var(--fs-micro); font-weight: 800;
  color: #fff; background: var(--gold);
  width: 24px; height: 24px; border-radius: 8px;
  display: flex; align-items: center; justify-content: center; margin-top: 1px;
  letter-spacing: var(--ls-num);
}

/* ============================================================
   ピクトグラム比率型（雛形: proof/ピクトグラム比率型）
   ============================================================ */
.lp-wrapper .pg-block{ background: var(--bg-gray); border-radius: var(--radius-card); padding: 44px 32px; margin: 36px 0 48px; text-align: center; }
.lp-wrapper .pg-label{ font-size: var(--fs-note); font-weight: 700; color: var(--text-sub); margin-bottom: 18px; }
.lp-wrapper .pg-block .pg-stat{
  font-size: calc(var(--fs-stat) * 1.3); font-weight: 800; letter-spacing: var(--ls-num);
  line-height: 1.1; color: var(--gold); white-space: nowrap; margin-bottom: 26px;
}
.lp-wrapper .pg-block .pg-stat em{
  font-style: normal; font-size: 0.4em; font-weight: 700; color: var(--text-sub);
  letter-spacing: var(--ls-heading);
}
.lp-wrapper .pg-icons{ display: flex; justify-content: center; gap: 10px; margin-bottom: 24px; flex-wrap: wrap; }
.lp-wrapper .pg-tire{
  width: 44px; height: 44px; color: var(--text-sub);
  opacity: 0; transform: translateY(10px);
  transition: opacity .4s ease, transform .4s ease, color .4s ease;
}
.lp-wrapper .pg-tire:not(.lit) svg{ opacity: .3; }
.lp-wrapper .pg-tire.lit{ color: var(--gold); }
.lp-wrapper .pg-tire.show{ opacity: 1; transform: none; }
.lp-wrapper .pg-tire svg{ width: 100%; height: 100%; }
@media (prefers-reduced-motion: reduce) { .pg-tire { transition: none; opacity: 1; transform: none; } }
.lp-wrapper .pg-desc{ font-size: var(--fs-body); line-height: 2.0; color: var(--text); margin-bottom: 8px; }
.lp-wrapper .pg-note{ font-size: var(--fs-micro); color: var(--text-sub); line-height: 1.8; }
@media (max-width: 768px) {
  .lp-wrapper .pg-block{ padding: 32px 18px; }
  .lp-wrapper .pg-icons{ max-width: 260px; margin-left: auto; margin-right: auto; }
  .lp-wrapper .pg-tire{ width: 40px; height: 40px; }
}

/* ============================================================
   番号カード型（雛形: proof/商流2正確さ_番号カード型）
   ============================================================ */
.lp-wrapper .reason-card{
  background: var(--bg-gray); border-radius: var(--radius-card);
  padding: 32px 30px; margin-bottom: 18px;
}
.lp-wrapper .reason-head{ display: flex; align-items: baseline; gap: 16px; margin-bottom: 12px; }
.lp-wrapper .reason-num{
  font-size: var(--fs-stat); font-weight: 800; letter-spacing: var(--ls-num);
  color: var(--gold); line-height: 1; flex-shrink: 0;
}
.lp-wrapper .reason-title{ font-size: var(--fs-h3); font-weight: 700; line-height: 1.5; color: var(--text); }
.lp-wrapper .reason-card > p{ font-size: var(--fs-body); line-height: 2.0; color: var(--text); }
@media (max-width: 768px) { .reason-card { padding: 24px 20px; } }

/* ============================================================
   横バー性能対比型（雛形: comparison/横バー性能対比型）
   ============================================================ */
.lp-wrapper .hb-group{ margin: 36px 0; }
.lp-wrapper .hb-metric{ font-size: var(--fs-lead); font-weight: 700; color: var(--text); margin-bottom: 14px; }
.lp-wrapper .hb-row{ display: grid; grid-template-columns: 8.5em 1fr auto; align-items: center; gap: 12px; margin-bottom: 10px; }
.lp-wrapper .hb-label{ font-size: var(--fs-note); font-weight: 700; color: var(--text-sub); text-align: right; line-height: 1.5; }
.lp-wrapper .hb-row.is-accent .hb-label{ color: var(--gold); }
.lp-wrapper .hb-rank{
  display: inline-block; font-size: 10px; font-weight: 800; color: #fff;
  background: var(--gold); border-radius: 4px; padding: 1px 6px; margin-right: 4px; vertical-align: 1px;
}
.lp-wrapper .hb-track{ position: relative; height: 34px; background: var(--bg-gray); overflow: hidden; }
.lp-wrapper .hb-fill{
  height: 100%; width: 0;
  background: var(--text-sub); opacity: .45;
  transition: width 1.1s ease .15s;
  display: flex; align-items: center; justify-content: flex-end; padding-right: 12px;
}
.lp-wrapper .hb-row.is-accent .hb-fill{ background: var(--gold); opacity: 1; }
.lp-wrapper .hb-fill .hb-value{
  font-size: var(--fs-note); font-weight: 800; letter-spacing: var(--ls-num);
  color: #fff; white-space: nowrap;
}
.lp-wrapper .hb-value-out{ font-size: var(--fs-note); font-weight: 800; color: var(--text); white-space: nowrap; }
.lp-wrapper .hb-note{ font-size: var(--fs-micro); color: var(--text-sub); margin-top: 16px; line-height: 1.8; }
.lp-wrapper .hb-punch{
  background: var(--gold-tint); border-radius: var(--radius-card);
  padding: 26px 28px; margin: 28px 0 0; text-align: center;
}
.lp-wrapper .hb-punch p{ font-size: var(--fs-lead); font-weight: 700; color: var(--text); line-height: 1.8; }
.lp-wrapper .hb-punch p strong{ color: var(--gold); }
@media (max-width: 768px) {
  .lp-wrapper .hb-row{ grid-template-columns: 1fr auto; gap: 6px; }
  .lp-wrapper .hb-label{ grid-column: 1 / -1; text-align: left; }
  .lp-wrapper .hb-track{ height: 30px; }
}

/* ============================================================
   実写真カード型（雛形: compatible/商流2これ1台_実写真カード型）
   ============================================================ */
.lp-wrapper .cp-grid{ display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin: 32px 0; }
.lp-wrapper .cp-grid--two{ grid-template-columns: 1fr 1fr; }
.lp-wrapper .cp-card{
  background: var(--bg-white); border-radius: var(--radius-card); overflow: hidden;
  box-shadow: var(--shadow-card);
}
.lp-wrapper .cp-card img{ width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
.lp-wrapper .cp-card img.cp-img-contain{ object-fit: contain; background: var(--bg-white); }
.lp-wrapper .cp-card-body{ padding: 20px; }
.lp-wrapper .cp-card-body h3{ font-size: var(--fs-lead); font-weight: 700; line-height: 1.5; color: var(--text); margin-bottom: 10px; }
.lp-wrapper .cp-types{ display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
.lp-wrapper .cp-types span{
  font-size: var(--fs-micro); font-weight: 700; color: var(--text-sub);
  background: var(--bg-gray); border-radius: var(--radius-pill); padding: 4px 10px;
}
.lp-wrapper .cp-card-body .cp-desc{ font-size: var(--fs-note); line-height: 1.9; color: var(--text-sub); }
.lp-wrapper .cp-tag{
  display: inline-block; font-size: var(--fs-micro); font-weight: 700; color: var(--gold);
  background: var(--gold-tint); border-radius: var(--radius-pill); padding: 4px 12px; margin-bottom: 10px;
}
@media (max-width: 768px) {
  .lp-wrapper .cp-grid{ grid-template-columns: 1fr; }
  .lp-wrapper .cp-grid--two{ grid-template-columns: 1fr; }
}

/* ============================================================
   等式ビジュアル型（雛形: proof/商流2音_等式ビジュアル型）
   ============================================================ */
.lp-wrapper .hn-eq{
  display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: 14px;
  background: var(--bg-white); border-radius: var(--radius-card); padding: 30px 24px; margin: 32px 0;
  box-shadow: var(--shadow-card);
}
.lp-wrapper .hn-eq-side{ text-align: center; }
.lp-wrapper .hn-eq-mark{ font-size: var(--fs-h3); font-weight: 800; color: var(--text-sub); text-align: center; }
.lp-wrapper .hn-eq .hn-db{
  font-size: calc(var(--fs-stat) * 0.9); font-weight: 800; letter-spacing: var(--ls-num);
  line-height: 1.1; color: var(--text); white-space: nowrap;
}
.lp-wrapper .hn-eq .hn-db em{
  font-style: normal; font-size: 0.4em; font-weight: 700; color: var(--text-sub);
  letter-spacing: var(--ls-heading); margin-left: 4px;
}
.lp-wrapper .hn-eq .eq-sub{ font-size: var(--fs-micro); font-weight: 700; color: var(--text-sub); margin-top: 6px; }
.lp-wrapper .hn-eq .is-main .hn-db{ color: var(--gold); }
.lp-wrapper .hn-chip{
  display: inline-block; font-size: var(--fs-body); font-weight: 700; color: var(--gold);
  background: var(--gold-tint); border-radius: var(--radius-pill); padding: 12px 24px; margin-top: 8px;
}
@media (max-width: 768px) {
  /* 等式はスマホで縦積み（確定基準: 記号は縦方向） */
  .lp-wrapper .hn-eq{ grid-template-columns: 1fr; }
}

/* ============================================================
   単位カード（番号カード型の分解カード応用・2×2）
   ============================================================ */
.lp-wrapper .unit-grid{ display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 32px 0; }
.lp-wrapper .unit-card{ background: var(--bg-white); border-radius: var(--radius-card); padding: 26px 24px; box-shadow: var(--shadow-card); }
.lp-wrapper .unit-head{ display: flex; align-items: baseline; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
.lp-wrapper .unit-name{
  font-size: calc(var(--fs-stat) * 0.7); font-weight: 800; letter-spacing: var(--ls-num);
  color: var(--gold); line-height: 1; white-space: nowrap;
}
.lp-wrapper .unit-read{ font-size: var(--fs-micro); font-weight: 700; color: var(--text-sub); }
.lp-wrapper .unit-card p{ font-size: var(--fs-note); line-height: 1.9; color: var(--text-sub); margin-bottom: 10px; }
.lp-wrapper .unit-for{
  display: inline-block; font-size: var(--fs-micro); font-weight: 700; color: var(--text-sub);
  background: var(--bg-gray); border-radius: var(--radius-pill); padding: 4px 12px;
}
@media (max-width: 600px) { .unit-grid { grid-template-columns: 1fr; } }

/* ============================================================
   縦タイムライン型（雛形: howto/商流2使い方_縦タイムライン型）
   ============================================================ -*/
.lp-wrapper .ht-timeline{ position: relative; padding-left: 56px; margin: 40px 0 8px; }
.lp-wrapper .ht-timeline::before{
  content: ""; position: absolute; top: 8px; bottom: 8px; left: 17px;
  width: 2px; background: var(--gold-tint);
}
.lp-wrapper .ht-tl-step{ position: relative; padding-bottom: 44px; }
.lp-wrapper .ht-tl-step:last-child{ padding-bottom: 0; }
.lp-wrapper .ht-tl-step .num{
  position: absolute; left: -56px; top: 0;
  display: flex; align-items: center; justify-content: center;
  width: 36px; height: 36px; border-radius: 50%;
  background: var(--gold); color: #fff;
  font-size: var(--fs-body); font-weight: 800; letter-spacing: var(--ls-num);
}
.lp-wrapper .ht-tl-step h4{ font-size: var(--fs-lead); font-weight: 700; line-height: 1.6; color: var(--text); margin-bottom: 8px; }
.lp-wrapper .ht-tl-step > p{ font-size: var(--fs-note); line-height: 1.9; color: var(--text-sub); margin-bottom: 14px; }
.lp-wrapper .ht-tl-step .step-photo img{
  width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block;
  border-radius: var(--radius-image); box-shadow: var(--shadow-card);
}
.lp-wrapper .ht-tl-step .step-photo--diagram img{ object-fit: contain; background: var(--bg-white); aspect-ratio: auto; max-height: 380px; margin: 0 auto; }
.lp-wrapper .ht-card-note{
  position: relative; background: var(--gold-tint); border-radius: var(--radius-card);
  padding: 18px 20px; margin-top: 14px;
}
.lp-wrapper .ht-card-note::before{
  content: ""; position: absolute; top: -7px; left: 28px;
  width: 14px; height: 14px; background: var(--gold-tint);
  transform: rotate(45deg);
}
.lp-wrapper .ht-card-note p{ font-size: var(--fs-note); line-height: 1.9; color: var(--text-sub); margin-bottom: 6px; }
.lp-wrapper .ht-card-note p:last-child{ margin-bottom: 0; }
.lp-wrapper .ht-card-note p strong{ color: var(--text); }
@media (max-width: 768px) {
  .lp-wrapper .ht-timeline{ padding-left: 48px; }
  .lp-wrapper .ht-tl-step .num{ left: -48px; width: 32px; height: 32px; }
  .lp-wrapper .ht-timeline::before{ left: 15px; }
}

/* ============================================================
   表示タイプ2分岐カード（BeforeAfterカード型の対比構造を応用）
   ============================================================ */
