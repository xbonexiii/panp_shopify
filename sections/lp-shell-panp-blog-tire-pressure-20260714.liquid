<!-- コアスクリプト（design-system/scripts.js ＋ セクション専用JS） -->
<script>
/* ① スライドインアニメーション発火（IntersectionObserver） */
(function () {
  var targets = document.querySelectorAll('.slide-left, .slide-right, .slide-up, .fade-in');
  if (!('IntersectionObserver' in window)) {
    targets.forEach(function (el) { el.classList.add('visible'); }); return;
  }
  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.15 });
  targets.forEach(function (el) { obs.observe(el); });
})();

/* ② ピクトグラム: タイヤアイコンを1個ずつ時差で点灯（雛形: ピクトグラム比率型 専用JS） */
(function () {
  var icons = document.querySelectorAll('.pg-tire');
  if (!icons.length) return;
  function reveal() {
    icons.forEach(function (el, i) {
      setTimeout(function () { el.classList.add('show'); }, i * 110);
    });
  }
  if (!('IntersectionObserver' in window)) { reveal(); return; }
  var wrap = document.querySelector('.pg-icons');
  new IntersectionObserver(function (entries, obs) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { reveal(); obs.unobserve(e.target); }
    });
  }, { threshold: 0.5 }).observe(wrap);
})();

/* ③ カウントアップ（data-count・ピクトグラム比率型の大数字） */
(function () {
  var els = document.querySelectorAll('[data-count]');
  if (!els.length) return;
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function run(el) {
    var target = parseFloat(el.getAttribute('data-count'));
    if (reduced) { el.textContent = target; return; }
    var dur = 1000, start = null;
    function step(ts) {
      if (!start) start = ts;
      var p = Math.min((ts - start) / dur, 1);
      el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3)));
      if (p < 1) requestAnimationFrame(step); else el.textContent = target;
    }
    requestAnimationFrame(step);
  }
  if (!('IntersectionObserver' in window)) { els.forEach(run); return; }
  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { run(e.target); obs.unobserve(e.target); }
    });
  }, { threshold: 0.5 });
  els.forEach(function (el) { obs.observe(el); });
})();

/* ④ 横バー: スクロール到達時に伸ばす（雛形: 横バー性能対比型 専用JS） */
(function () {
  var fills = document.querySelectorAll('.hb-fill');
  if (!fills.length) return;
  if (!('IntersectionObserver' in window)) {
    fills.forEach(function (el) { el.style.width = el.getAttribute('data-w'); }); return;
  }
  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.style.width = e.target.getAttribute('data-w'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.4 });
  fills.forEach(function (el) { obs.observe(el); });
})();
</script>


