<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: Helvetica, Arial, sans-serif;
      color: #1d1d1f; font-size: 17px; line-height: 1.8;
      overflow-x: hidden; background: #fff;
      -webkit-font-smoothing: antialiased;
    }
    img { max-width: 100%; height: auto; display: block; }
    a { color: inherit; text-decoration: none; }
    section { width: 100%; overflow: hidden; }

    :root {
      --green: #416923;
      --green-light: #538a2d;
      --dark: #1d1d1f;
      --black: #000;
      --blue: #0071e3;
      --blue-hover: #0077ed;
      --gray-bg: #f5f5f7;
      --white: #fff;
      --border: #d2d2d7;
      --text-sub: #6e6e73;
    }

    /* Layout */
    .container { max-width: 980px; margin: 0 auto; padding: 0 40px; }
    .article-body { max-width: 720px; margin: 0 auto; padding: 0 40px; }
    .sec-white { background: var(--white); padding: 100px 0; }
    .sec-gray  { background: var(--gray-bg); padding: 100px 0; }
    .sec-dark  { background: var(--dark); color: #fff; padding: 80px 0; text-align: center; }

    .two-col {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 64px; align-items: flex-start;
    }
    .two-col--rev .col-img { order: -1; }
    .col-img img { width: 100%; border-radius: 20px; aspect-ratio: 4/3; object-fit: cover; object-position: top; }

    /* Typography */
    .label {
      display: block; font-size: 13px; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--green); margin-bottom: 16px;
    }
    h2.title {
      font-size: clamp(26px, 3.5vw, 40px); font-weight: 700;
      line-height: 1.35; letter-spacing: -0.01em; margin-bottom: 24px;
    }
    .body-text { font-size: 17px; line-height: 1.9; color: var(--text-sub); }
    .body-text p { margin-bottom: 1.4em; }
    .body-text p:last-child { margin-bottom: 0; }
    .body-text strong { color: var(--dark); font-weight: 700; }

    /* Animations */
    .fade-in { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .fade-in.visible { opacity: 1; transform: none; }
    .slide-up { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .slide-up.visible { opacity: 1; transform: none; }

    /* Buttons */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      font-size: 17px; font-weight: 700; padding: 18px 40px;
      border-radius: 100px; border: none; cursor: pointer;
      transition: background 0.2s, transform 0.15s; white-space: nowrap; text-decoration: none;
    }
    .btn-black { background: var(--blue); color: #fff; }
    .btn-black:hover { background: var(--blue-hover); }
    .btn-black:hover { background: #333; transform: scale(1.02); }
    .btn-white { background: var(--blue); color: #fff; }
    .btn-white:hover { background: var(--blue-hover); transform: scale(1.02); }

    /* ── Hero ── */
    #sec-hero {
      position: relative; padding: 0; min-height: 100svh;
      display: flex; align-items: flex-end;
    }
    .hero-bg { position: absolute; inset: 0; background: #000; }
    .hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center; opacity: 0.75; }
    .hero-content {
      position: relative; z-index: 1; width: 100%;
      padding: 80px 40px 100px;
      background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.2) 55%, transparent 100%);
    }
    .hero-inner { max-width: 700px; }
    .hero-eyebrow {
      display: inline-block; margin-bottom: 20px;
      background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2);
      border-radius: 20px; padding: 6px 14px; font-size: 13px; color: rgba(255,255,255,.75);
    }
    .hero-h1 {
      font-size: clamp(28px, 5vw, 56px); font-weight: 700; color: #fff;
      line-height: 1.4; letter-spacing: 0.04em; margin-bottom: 20px;
      font-feature-settings: "palt" 1;
      hanging-punctuation: first last;
    }
    .hero-sub {
      font-size: clamp(15px, 2vw, 18px); color: rgba(255,255,255,0.85);
      margin-bottom: 40px; line-height: 1.7; max-width: 480px;
    }
    .hero-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
    .hero-note { font-size: 13px; color: rgba(255,255,255,0.6); }
    .scroll-hint {
      position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      color: rgba(255,255,255,0.5); font-size: 10px; letter-spacing: 0.15em;
      text-transform: uppercase; animation: bounce 2.2s infinite; z-index: 2;
    }
    .scroll-hint svg { width: 20px; height: 20px; }
    @keyframes bounce {
      0%,100% { transform: translateX(-50%) translateY(0); opacity:.5; }
      50%      { transform: translateX(-50%) translateY(8px); opacity:.9; }
    }

    /* ── Story ── */
    #sec-story { background: #fafaf8; padding: 100px 0; }
    .story-inner { max-width: 660px; margin: 0 auto; padding: 0 24px; }
    .story-opener {
      font-size: clamp(26px, 4.5vw, 40px); font-weight: 700; line-height: 1.5;
      letter-spacing: -0.01em; text-align: center; margin-bottom: 52px;
    }
    .art-p { font-size: 17px; line-height: 2; color: var(--dark); margin-bottom: 1.6em; }
    .art-p:last-child { margin-bottom: 0; }
    .art-accent { font-weight: 700; font-size: 19px; color: var(--green); }
    .story-scene {
      background: #fff; border-radius: 16px; padding: 32px 36px;
      margin: 44px 0; box-shadow: 0 2px 16px rgba(0,0,0,0.07);
      font-size: 18px; line-height: 2.1; color: #222; text-align: center;
    }
    .story-scene-note { font-size: 13px; color: #aaa; margin-top: 12px; display: block; }
    .story-divider {
      display: flex; align-items: center; gap: 16px; margin: 48px 0;
    }
    .story-divider::before, .story-divider::after {
      content: ''; flex: 1; border-top: 1px solid var(--border);
    }
    .story-divider-dot { color: var(--green); font-size: 14px; letter-spacing: 6px; }
    .quote-block {
      border-left: 3px solid var(--green); padding: 8px 0 8px 24px;
      margin: 36px 0; font-size: 17px; line-height: 2; color: #555;
    }
    .story-reveal {
      text-align: center; margin: 44px 0 36px;
      font-size: clamp(22px, 3.5vw, 32px); font-weight: 700; line-height: 1.6;
    }
    .story-reveal-accent { color: var(--green); display: block; }
    .story-promise {
      text-align: center; font-size: 18px; font-weight: 700;
      line-height: 1.8; color: var(--dark);
      border-top: 1px solid var(--border); padding-top: 36px; margin-top: 44px;
    }
    @media (max-width: 768px) {
      .story-scene { padding: 24px 24px; }
    }

    /* ── Bar Chart ── */
    .bar-wrap { margin: 36px 0; }
    .bar-row { margin-bottom: 20px; }
    .bar-label {
      font-size: 14px; font-weight: 600; color: var(--text-sub);
      margin-bottom: 6px; display: flex; justify-content: space-between;
    }
    .bar-time { font-weight: 700; color: var(--dark); }
    .bar-time.hl { color: var(--green); font-size: 16px; }
    .bar-track { background: #e0e0e5; border-radius: 6px; height: 14px; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 6px; background: #b5b5be; }
    .bar-fill.hl { background: var(--green); }
    .bar-callout {
      margin-top: 24px; background: #eef5e8; border: 2px solid var(--green);
      border-radius: 16px; padding: 24px; text-align: center;
    }
    .big-num { font-size: 56px; font-weight: 800; color: var(--green); line-height: 1; }
    .big-unit { font-size: 28px; }
    .big-note { font-size: 14px; color: var(--text-sub); margin-top: 4px; }
    .cmp-img { margin-top: 48px; border-radius: 20px; overflow: hidden; max-width: 560px; }
    .cmp-img img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }

    /* ── Feature Cards ── */
    .f-cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin-top: 28px; }
    .f-card { background: #fff; border-radius: 20px; padding: 28px 22px; box-shadow: 0 2px 16px rgba(0,0,0,.06); }
    .f-icon {
      width: 48px; height: 48px; background: #eef5e8; border-radius: 12px;
      display: flex; align-items: center; justify-content: center; margin-bottom: 16px;
    }
    .f-icon svg { width: 24px; height: 24px; stroke: var(--green); }
    .f-card h3 { font-size: 15px; font-weight: 700; margin-bottom: 6px; }
    .f-card p { font-size: 13px; color: var(--text-sub); line-height: 1.7; margin: 0; }

    /* ── Mid CTA ── */
    .mid-cta { background: var(--dark); color: #fff; padding: 80px 0; text-align: center; }
    .mid-inner { max-width: 540px; margin: 0 auto; padding: 0 24px; }
    .mid-title { font-size: 26px; font-weight: 700; line-height: 1.5; margin-bottom: 10px; }
    .mid-sub { font-size: 15px; opacity: .7; margin-bottom: 36px; }
    .mid-note { font-size: 13px; opacity: .5; margin-top: 12px; }

    /* ── Compare Table ── */
    .tbl-wrap { overflow-x: auto; margin-top: 32px; border-radius: 16px; border: 1px solid var(--border); }
    .tbl { width: 100%; border-collapse: collapse; font-size: 14px; }
    .tbl th, .tbl td { padding: 14px 16px; border-bottom: 1px solid var(--border); text-align: left; vertical-align: middle; line-height: 1.5; }
    .tbl thead th { background: var(--gray-bg); font-weight: 700; font-size: 12px; letter-spacing: .05em; text-transform: uppercase; color: var(--text-sub); }
    .tbl thead th.hl { background: var(--dark); color: #fff; }
    .tbl tbody td.hl { background: #f0f7eb; font-weight: 600; color: #305018; }
    .tbl tbody tr:last-child td { border-bottom: none; }
    .ok { color: var(--green); font-weight: 700; }
    .ng { color: #aaa; }

    /* ── Guarantee Cards ── */
    .g-cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; margin-top: 56px; }
    .g-card { background: #fff; border-radius: 24px; padding: 40px 32px; text-align: center; box-shadow: 0 4px 24px rgba(0,0,0,.07); border: 1px solid rgba(0,0,0,.05); }
    .g-ico {
      width: 56px; height: 56px; background: #eef5e8; border-radius: 50%;
      display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;
    }
    .g-ico svg { width: 28px; height: 28px; stroke: var(--green); }
    .g-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
    .g-card p { font-size: 14px; color: var(--text-sub); line-height: 1.7; margin: 0; }

    /* ── Product Reveal ── */
    #sec-product-reveal {
      position: relative; width: 100%; height: 80vh; min-height: 520px;
      overflow: hidden; background: #000;
      display: flex; align-items: center; justify-content: center;
    }
    #sec-product-reveal video {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; display: block;
    }
    .reveal-overlay {
      position: absolute; inset: 0;
      background: rgba(0,0,0,0.58);
    }
    .reveal-content {
      position: relative; z-index: 2;
      text-align: center; padding: 0 24px;
    }
    .reveal-headline {
      font-size: clamp(32px, 6vw, 72px); font-weight: 700;
      color: #fff; line-height: 1.3; letter-spacing: -0.01em;
    }
    @media (max-width: 768px) {
      #sec-product-reveal { height: 65vh; min-height: 400px; }
    }

    /* ── Howto ── */
    .howto-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
    .howto-card { background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 2px 16px rgba(0,0,0,0.07); text-align: center; }
    .howto-img { width: 100%; aspect-ratio: 4/3; object-fit: cover; object-position: top; display: block; }
    .howto-card-body { padding: 28px 24px 32px; }
    .howto-num { width: 48px; height: 48px; border-radius: 50%; background: var(--black); color: #fff; font-size: 20px; font-weight: 700; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
    .howto-title { font-size: 17px; font-weight: 700; margin-bottom: 10px; line-height: 1.4; }
    .howto-body { font-size: 15px; color: var(--text-sub); line-height: 1.7; }
    .deflate-card {
      margin-top: 48px; background: #1d1d1f; border-radius: 20px;
      overflow: hidden; display: grid; grid-template-columns: 1fr 1fr;
    }
    .deflate-video-wrap { position: relative; aspect-ratio: 9/16; overflow: hidden; }
    .deflate-video-wrap video { width: 100%; height: 100%; object-fit: cover; display: block; }
    .deflate-body-wrap {
      padding: 40px 36px; display: flex; flex-direction: column; justify-content: center;
    }
    .deflate-label {
      display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: rgba(255,255,255,0.45);
      border: 1px solid rgba(255,255,255,0.15); border-radius: 100px;
      padding: 3px 12px; margin-bottom: 20px; align-self: flex-start;
    }
    .deflate-title { font-size: 22px; font-weight: 700; color: #fff; margin-bottom: 12px; line-height: 1.5; }
    .deflate-desc { font-size: 14px; color: rgba(255,255,255,0.55); line-height: 1.9; }
    @media (max-width: 768px) {
      .deflate-card { grid-template-columns: 1fr; }
      .deflate-video-wrap { aspect-ratio: 4/3; }
      .deflate-body-wrap { padding: 28px 24px; }
    }
    @media (max-width: 768px) {
      .howto-grid { grid-template-columns: 1fr; gap: 20px; }
    }

    /* ── FAQ ── */
    .faq-list { margin-top: 36px; }
    .faq-item { border-bottom: 1px solid var(--border); }
    .faq-item:first-child { border-top: 1px solid var(--border); }
    .faq-q {
      display: flex; justify-content: space-between; align-items: center;
      padding: 22px 0; cursor: pointer; font-weight: 700; font-size: 16px;
      gap: 16px; user-select: none;
    }
    .faq-qt { flex: 1; }
    .faq-ic { width: 22px; height: 22px; flex-shrink: 0; transition: transform .3s; stroke: var(--green); }
    .faq-item.open .faq-ic { transform: rotate(45deg); }
    .faq-ans { overflow: hidden; max-height: 0; transition: max-height .35s ease; }
    .faq-ans-in { padding-bottom: 22px; font-size: 15px; line-height: 1.8; color: var(--text-sub); }
    .faq-item.open .faq-ans { max-height: 500px; }

    /* ── Final CTA ── */
    #sec-cta { position: relative; background: #0a0a0f; color: #fff; padding: 100px 0; text-align: center; overflow: hidden; }
    #sec-cta .cta-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; z-index: 0; }
    #sec-cta::after { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.45); z-index: 1; }
    .cta-wrap { position: relative; z-index: 2; max-width: 600px; margin: 0 auto; padding: 0 24px; }
    .cta-voice { margin-bottom: 44px; }
    .cta-voice blockquote {
      font-size: 16px; line-height: 1.8; color: rgba(255,255,255,.85);
      font-style: italic; border-left: 3px solid var(--green);
      padding-left: 16px; text-align: left; margin: 0 0 8px;
    }
    .cta-voice cite { font-size: 12px; color: rgba(255,255,255,.4); display: block; text-align: right; }
    #sec-cta h2 { font-size: clamp(24px,4vw,36px); font-weight: 700; line-height: 1.4; margin-bottom: 16px; color: #fff; }
    #sec-cta .cta-body { font-size: 16px; color: rgba(255,255,255,.75); margin-bottom: 40px; line-height: 1.8; }
    .cta-badges { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 24px; }
    .cta-badge { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); border-radius: 20px; padding: 6px 14px; font-size: 13px; color: rgba(255,255,255,.75); }
    .cta-sub-link { display: inline-block; margin-top: 20px; font-size: 14px; color: rgba(255,255,255,.5); border-bottom: 1px solid rgba(255,255,255,.3); padding-bottom: 2px; }

    /* ── Footer ── */
    footer { background: var(--dark); color: rgba(255,255,255,.45); padding: 48px 0 32px; text-align: center; font-size: 13px; }
    footer img { height: 32px; width: auto; display: block; margin: 0 auto 24px; opacity: .8; }
    .ft-links { display: flex; gap: 24px; justify-content: center; margin-bottom: 16px; flex-wrap: wrap; }
    .ft-links a { color: rgba(255,255,255,.45); }
    .ft-links a:hover { color: rgba(255,255,255,.75); }

    /* ── Sticky CTA ── */
    #sticky-cta {
      display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 8000;
      padding: 12px 20px 20px;
      background: linear-gradient(to top, rgba(0,0,0,.93) 80%, transparent);
    }
    #sticky-cta a {
      display: block; width: 100%; text-align: center;
      background: var(--blue); color: #fff;
      font-size: 16px; font-weight: 700; padding: 16px; border-radius: 12px;
    }
    #sticky-cta .sn { text-align: center; font-size: 11px; color: rgba(255,255,255,.55); margin-top: 6px; }
    @media (min-width: 769px) { #sticky-cta { display: none !important; } }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      body { font-size: 16px; }
      .container, .article-body { padding: 0 20px; }
      .sec-white, .sec-gray { padding: 72px 0; }
      #sec-story { padding: 64px 0; }
      .mid-cta { padding: 64px 0; }
      #sec-cta { padding: 72px 0; }
      .two-col { grid-template-columns: 1fr; gap: 36px; }
      .two-col--rev .col-img { order: 0; }
      .f-cards { grid-template-columns: 1fr; }
      .g-cards { grid-template-columns: 1fr; }
      .hero-content { padding: 60px 20px 80px; }
      .hero-cta { align-items: stretch; }
      .btn { font-size: 16px; padding: 16px 28px; }
      .big-num { font-size: 44px; }
      .mid-title { font-size: 22px; }
    }

/* ---- eyebrow（見出し上の小ラベル）を一時非表示（2026-07-14 市山さん指示） ----
   削除はせず表示だけ止める。復活させるときはこのブロックを消す */
[class*="eyebrow"] { display: none !important; }
</style>

<!-- ① Hero -->
<section id="sec-hero" data-section-type="hero" data-section-name="ヒーローセクション" data-section-order="1">
  <div class="hero-bg">
    <img data-slot="hero-image" data-asset-id="AIR_reveal"
      src="https://drive.google.com/thumbnail?id=1s_t3UirYKRZhC3pTlT94b5CxjMJqyXZ-&sz=w1600"
      alt="PANP AIR" />
  </div>
  <div class="hero-content">
    <div class="hero-inner">
      <p data-slot="hero-eyebrow" class="hero-eyebrow fade-in">PANP AIR — コードレス電動エアポンプ</p>
      <h1 data-slot="headline" class="hero-h1 fade-in" style="transition-delay:.1s">
        「早く早く」って、<br>汗だくで浮き輪を膨らましていた。
      </h1>
      <p data-slot="subheadline" class="hero-sub fade-in" style="transition-delay:.2s">
        浮き輪を膨らます作業、今年から変えませんか。
      </p>
      <div class="hero-cta fade-in" style="transition-delay:.3s">
        <a data-slot="cta-button" href="https://panp.jp/products/kukiire02" class="btn btn-white">
          PANP AIRを見てみる（30日返品OK）
        </a>
        <p class="hero-note">送料無料・1年保証・30日返品OK</p>
      </div>
    </div>
  </div>
  <div class="scroll-hint" aria-hidden="true">
    <span>scroll</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </div>
</section>

<!-- ② Story -->
<section id="sec-story" data-section-type="empathy" data-section-name="冒頭リード・共感ストーリー" data-section-order="2">
  <div class="story-inner">

    <p class="story-opener slide-up">毎年、夏になると<br>思うことがあります。</p>

    <p class="art-p slide-up">プールに行く前とか、海に行く前とか。<br>浮き輪とかビーチボールを膨らませるあれ、なんとかならないかなって。</p>

    <div class="story-scene slide-up">
      子どもに「早く早く！」って言われながら<br>
      汗だくになっている自分。
      <span class="story-scene-note">別につらくはない。でも、ちょっとだけ申し訳なくなる。</span>
    </div>

    <div class="story-divider slide-up">
      <span class="story-divider-dot">◆ ◆ ◆</span>
    </div>

    <p class="art-p slide-up">夏のレジャーって、楽しみなんだけど、準備が地味に大変ですよね。特に「膨らます作業」。</p>

    <div data-slot="story-text" class="quote-block slide-up">
      浮き輪、ビーチボール、エアマット——<br>全部口で膨らましてたら、それだけで疲れます。<br>ポンプを使っても、足踏みポンプって地味に体力いるし。
    </div>

    <p class="art-p slide-up">「まあ毎年こんなもんだよね」と思いながらやってたんですが、<br>電動のポンプを使ってから、その考えが変わりました。</p>

    <div class="story-reveal slide-up">
      ノズルを刺してスイッチを入れるだけ。
