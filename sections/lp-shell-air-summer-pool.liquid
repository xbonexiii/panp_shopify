<script>
(function () {
  var els = document.querySelectorAll('.slide-up, .fade-in');
  if (!('IntersectionObserver' in window)) { els.forEach(function(e){e.classList.add('visible');}); return; }
  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('visible'); obs.unobserve(e.target); } });
  }, { threshold: 0.12 });
  els.forEach(function(e){ obs.observe(e); });
})();
</script>

<script>
(function () {
  document.querySelectorAll('.faq-item').forEach(function(item){
    item.querySelector('.faq-q').addEventListener('click', function(){
      var open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(function(i){ i.classList.remove('open'); });
      if (!open) item.classList.add('open');
    });
  });
})();
</script>

<script>
(function () {
  var el = document.getElementById('sticky-cta'); if (!el) return;
  var trigger = document.getElementById('sec-cta-mid-1');
  var fin = document.getElementById('sec-cta');
  if (!trigger || !('IntersectionObserver' in window)) return;

  function update() {
    var triggerBottom = trigger.getBoundingClientRect().bottom;
    var finVisible = fin ? fin.getBoundingClientRect().top < window.innerHeight * 0.9 : false;
    el.style.display = (triggerBottom < 0 && !finVisible) ? 'block' : 'none';
  }

  window.addEventListener('scroll', update, { passive: true });
  update();
})();
</script>

