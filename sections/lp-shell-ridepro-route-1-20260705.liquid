/* ================== sec-accuracy（精度±1PSI・数字主役＋ディスプレイUI） ================== */
.lp-wrapper #sec-accuracy{ background: var(--bg-gray); color: var(--text); }
.lp-wrapper #sec-accuracy .ac-inner{
  max-width: 880px; width: calc(100% - 40px); margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: center;
}
.lp-wrapper #sec-accuracy .ac-eyebrow{
  display: inline-block; font-size: var(--fs-note); font-weight: 700; letter-spacing: var(--ls-heading);
