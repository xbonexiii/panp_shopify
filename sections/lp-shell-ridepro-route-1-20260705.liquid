<script>
/* ============================================================
   LP共通JavaScript 3本セット（design-system/scripts.js をインライン化）
   ① スライドイン発火 ② パララックス ③ スティッキーCTA制御
   ============================================================ */

/* ① スライドインアニメーション発火（IntersectionObserver） */
(function () {
  var targets = document.querySelectorAll('.slide-left, .slide-right, .slide-up, .fade-in');
  if (!('IntersectionObserver' in window)) {
    targets.forEach(function (el) { el.classList.add('visible'); }); return;
  }
  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.15 });
  targets.forEach(function (el) { obs.observe(el); });
})();

/* ② パララックス（デスクトップのみ・STRENGTH=40px） */
(function () {
  if (window.matchMedia('(max-width: 768px)').matches) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var els = Array.prototype.slice.call(document.querySelectorAll('.parallax-bg'));
  var STRENGTH = 40; var ticking = false;
  function update() {
    var vh = window.innerHeight;
    els.forEach(function (img) {
      var section = img.parentElement;
      var rect = section.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > vh) return;
      var offset = (rect.top + rect.height / 2 - vh / 2) / (vh + rect.height) * STRENGTH * 2;
      img.style.transform = 'translateY(' + offset.toFixed(2) + 'px)';
    });
    ticking = false;
  }
  window.addEventListener('scroll', function () {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
  update();
})();

/* ③ モバイルスティッキーCTA制御（sec-heroを通過したら出現・sec-closing-cta表示中は隠す・上スクロールで凹む） */
(function () {
  var el = document.getElementById('sticky-cta');
  if (!el) return;
  var shown = false;
  /* 上スクロール=読み返し中はバナーを凹ませて視界を空け、下スクロールで再表示（デフォルト挙動） */
  var lastY = window.scrollY;
  window.addEventListener('scroll', function () {
    var y = window.scrollY;
    if (shown) {
      if (y < lastY - 4) el.classList.add('retract');
      else if (y > lastY + 4) el.classList.remove('retract');
    }
    lastY = y;
  }, { passive: true });
  var trigger = document.getElementById('sec-hero');
  if (trigger && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting && !shown && window.scrollY > trigger.offsetTop) {
          el.style.display = 'block'; shown = true;
        }
      });
    }, { threshold: 0 }).observe(trigger);
  }
  var closingCta = document.getElementById('sec-closing-cta');
  if (closingCta && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        el.style.display = e.isIntersecting ? 'none' : (shown ? 'block' : 'none');
      });
    }, { threshold: 0.1 }).observe(closingCta);
  }
})();

/* ④ 損失の縦棒グラフ発火（スクロール到達で height を設定） */
(function () {
  var bars = document.querySelectorAll('#sec-loss .cb-bar');
  if (!bars.length) return;
  if (!('IntersectionObserver' in window)) { bars.forEach(function (el) { el.style.height = el.getAttribute('data-h'); }); return; }
  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) { e.target.style.height = e.target.getAttribute('data-h'); obs.unobserve(e.target); } });
  }, { threshold: 0.4 });
  bars.forEach(function (el) { obs.observe(el); });
})();

/* ⑤ 実績カウントアップ発火（スクロール到達で 0→実数値） */
(function () {
  var els = document.querySelectorAll('#sec-proof .cu');
  if (!els.length) return;
  function fmt(v, dec, comma) { var s = v.toFixed(dec); if (comma) s = s.replace(/\B(?=(\d{3})+(?!\d))/g, ','); return s; }
  function run(el) {
    var target = parseFloat(el.getAttribute('data-count')), dec = parseInt(el.getAttribute('data-decimals') || '0', 10), comma = el.getAttribute('data-comma') === '1', t0 = null, DUR = 1300;
    function step(ts) { if (!t0) t0 = ts; var p = Math.min((ts - t0) / DUR, 1), eased = 1 - Math.pow(1 - p, 3); el.textContent = fmt(target * eased, dec, comma); if (p < 1) requestAnimationFrame(step); }
    requestAnimationFrame(step);
  }
  if (!('IntersectionObserver' in window)) { els.forEach(function (el) { var d = parseInt(el.getAttribute('data-decimals') || '0', 10); el.textContent = fmt(parseFloat(el.getAttribute('data-count')), d, el.getAttribute('data-comma') === '1'); }); return; }
  var obs = new IntersectionObserver(function (entries) { entries.forEach(function (e) { if (e.isIntersecting) { run(e.target); obs.unobserve(e.target); } }); }, { threshold: 0.5 });
  els.forEach(function (el) { obs.observe(el); });
})();

/* ⑥ 精度セクション: 空気圧カウントアップ（35.0→40.0・ゆっくり一定ペース・到達で停止＋✓表示） */
(function () {
  var el = document.querySelector('#sec-accuracy .cu-psi');
  if (!el) return;
  var reached = document.querySelector('#sec-accuracy .psi-reached');
  var START = 35.0, GOAL = 40.0, DUR = 4500;
  function finish() { el.textContent = GOAL.toFixed(1); if (reached) reached.classList.add('show'); }
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { finish(); return; }
  function run() {
    var t0 = null;
    function step(ts) {
      if (!t0) t0 = ts;
      var p = Math.min((ts - t0) / DUR, 1);
      el.textContent = (START + (GOAL - START) * p).toFixed(1);
      if (p < 1) requestAnimationFrame(step); else finish();
    }
    requestAnimationFrame(step);
  }
  if (!('IntersectionObserver' in window)) { finish(); return; }
  new IntersectionObserver(function (entries, obs) {
    entries.forEach(function (e) { if (e.isIntersecting) { run(); obs.unobserve(e.target); } });
  }, { threshold: 0.5 }).observe(el);
})();

</script>
</div>

