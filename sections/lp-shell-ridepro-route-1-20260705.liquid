.lp-wrapper #sec-accuracy .psi-figure{ font-size: calc(var(--fs-stat) * 1.5); font-weight: 800; letter-spacing: var(--ls-num); line-height: 1; white-space: nowrap; color: var(--gold-light); }
.lp-wrapper #sec-accuracy .psi-figure .psi-unit{ font-size: 0.32em; font-weight: 700; color: rgba(255,255,255,.7); margin-left: 6px; letter-spacing: var(--ls-heading); }
.lp-wrapper #sec-accuracy .psi-reached{ font-size: var(--fs-note); font-weight: 700; color: var(--gold-light); margin-top: 18px; opacity: 0; transform: translateY(4px); transition: opacity .45s ease, transform .45s ease; }
.lp-wrapper #sec-accuracy .psi-reached.show{ opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) { #sec-accuracy .psi-reached { transition: none; opacity: 1; transform: none; } }
.lp-wrapper #sec-accuracy .psi-note{ font-size: var(--fs-note); color: rgba(255,255,255,.75); }
