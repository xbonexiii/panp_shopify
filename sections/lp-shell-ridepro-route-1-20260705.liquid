<style>

/* ================== tokens.css ================== */
:root {
  /* ---- 色 ---- */
  --gold: #A37729;
  --gold-light: #c49535;
  --gold-tint: rgba(163,119,41,.1);
  --blue: #0071e3;
  --text: #1d1d1f;
  --text-sub: #6e6e73;
  --bg-white: #ffffff;
  --bg-gray: #f5f5f7;
  --bg-dark: #1d1d1f;
  --star: #f5c518;

  /* ---- タイポグラフィ（サイズ階層） ---- */
  --fs-hero: clamp(32px, 5.5vw, 68px);
  --fs-hero-compact: clamp(30px, 4.2vw, 54px);
  --fs-h2: clamp(28px, 3.5vw, 44px);
  --fs-h3: 22px;
  --fs-stat: clamp(28px, 3.6vw, 48px);
  --fs-lead: clamp(16px, 1.6vw, 20px);
  --fs-body: 17px;
  --fs-note: 13px;
  --fs-micro: 12px;

  /* ---- 字間 ---- */
  --ls-hero: -0.03em;
  --ls-heading: -0.02em;
  --ls-num: -0.04em;

  /* ---- 角丸（3階層固定） ---- */
  --radius-card: 24px;
  --radius-image: 16px;
  --radius-badge: 12px;
  --radius-pill: 50px;

  /* ---- 影（1種のみ） ---- */
  --shadow-card: 0 2px 20px rgba(0,0,0,.06);

  /* ---- セクション余白 ---- */
  --section-pad: 100px;
  --section-pad-sp: 64px;
}

/* ================== base.css ================== */
.lp-wrapper *,  .lp-wrapper *::before,  .lp-wrapper *::after{ box-sizing: border-box; margin: 0; padding: 0; }
.lp-wrapper{ scroll-behavior: smooth; }
.lp-wrapper{
  font-family: Helvetica, Arial, sans-serif;
  color: var(--text); font-size: var(--fs-body); line-height: 1.7; overflow-x: hidden;
}
.lp-wrapper img{ max-width: 100%; height: auto; display: block; }
.lp-wrapper a{ color: inherit; text-decoration: none; }
.lp-wrapper section{ width: 100%; }
/* 見出しは常にコンテナの色を継承（Shopifyテーマの h1/h2{color:#1d1d1f} 直接指定に負けて黒くなる再発バグを防ぐ・省略禁止） */
.lp-wrapper h1,  .lp-wrapper h2,  .lp-wrapper h3,  .lp-wrapper h4,  .lp-wrapper h5,  .lp-wrapper h6{ color: inherit; }
.lp-wrapper .container{ max-width: 1200px; margin: 0 auto; padding: 0 40px; }
.lp-wrapper .section-padding{ padding-top: var(--section-pad); padding-bottom: var(--section-pad); }
.lp-wrapper h2.section-title{ font-size: var(--fs-h2); font-weight: 700; line-height: 1.3; letter-spacing: var(--ls-heading); }
@media (max-width: 768px) {
  .lp-wrapper{ font-size: 16px; }
  .lp-wrapper .container{ padding: 0 20px; }
  .lp-wrapper .section-padding{ padding-top: var(--section-pad-sp); padding-bottom: var(--section-pad-sp); }
}

/* ---- アニメーションクラス（4種） ---- */
.lp-wrapper .fade-in{ opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
.lp-wrapper .fade-in.visible{ opacity: 1; transform: translateY(0); }
.lp-wrapper .slide-left{ opacity: 0; transform: translateX(-48px); transition: opacity 0.8s ease, transform 0.8s ease; }
.lp-wrapper .slide-right{ opacity: 0; transform: translateX(48px);  transition: opacity 0.8s ease, transform 0.8s ease; }
.lp-wrapper .slide-up{ opacity: 0; transform: translateY(32px);  transition: opacity 0.7s ease, transform 0.7s ease; }
.lp-wrapper .slide-left.visible,  .lp-wrapper .slide-right.visible,  .lp-wrapper .slide-up.visible{ opacity: 1; transform: none; }
.lp-wrapper .delay-1{ transition-delay: .15s; }
.lp-wrapper .delay-2{ transition-delay: .3s; }
.lp-wrapper .delay-3{ transition-delay: .45s; }
.lp-wrapper .delay-4{ transition-delay: .6s; }

/* ---- ボタンコンポーネント ---- */
.lp-wrapper .btn-primary{
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--gold); color: #fff;
  font-size: 18px; font-weight: 700; padding: 18px 40px;
  border-radius: var(--radius-pill); cursor: pointer;
  transition: background 0.2s, transform 0.1s;
  border: none; letter-spacing: 0.02em;
}
.lp-wrapper .btn-primary:hover{ background: var(--gold-light); transform: translateY(-1px); }
.lp-wrapper .btn-secondary{
  display: inline-block; color: var(--gold); font-size: 15px; font-weight: 500;
  margin-top: 16px; border-bottom: 1px solid currentColor; padding-bottom: 2px;
}

/* ---- スクロール誘導矢印 ---- */
.lp-wrapper .scroll-hint{
  position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  color: rgba(255,255,255,0.55); font-size: 10px; letter-spacing: 0.15em;
  text-transform: uppercase; animation: scroll-bounce 2.2s infinite;
}
.lp-wrapper .scroll-hint svg{ width: 20px; height: 20px; }
@keyframes scroll-bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.55; }
  50%       { transform: translateX(-50%) translateY(8px); opacity: 0.9; }
}

/* ---- ソーシャルプルーフ（ヒーロー内） ---- */
.lp-wrapper .hero-social-proof{ display: flex; align-items: center; gap: 8px; margin-top: 12px; color: #fff; font-size: 14px; }
.lp-wrapper .hero-social-proof .stars{ color: #f5c518; letter-spacing: 2px; font-size: 16px; }

/* ---- 最終CTA直前 お客様の声引用 ---- */
.lp-wrapper .cta-voice{ max-width: 480px; margin: 0 auto 32px; text-align: center; }
.lp-wrapper .cta-voice blockquote{
  font-size: 15px; line-height: 1.7; color: rgba(255,255,255,0.85);
  font-style: italic; margin: 0 0 8px;
  border-left: 2px solid var(--gold); padding-left: 14px; text-align: left;
}
.lp-wrapper .cta-voice cite{ font-size: var(--fs-micro); color: rgba(255,255,255,0.5); display: block; text-align: right; }

/* ---- モバイルスティッキーCTA（上スクロールで凹む・下スクロールで再表示） ---- */
.lp-wrapper #sticky-cta{
  display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 8000;
  padding: 12px 20px 20px;
  background: linear-gradient(to top, rgba(0,0,0,0.92) 80%, transparent);
  transform: translateY(0); transition: transform .3s ease;
}
.lp-wrapper #sticky-cta.retract{ transform: translateY(110%); }
.lp-wrapper #sticky-cta a{
  display: block; width: 100%; text-align: center;
  background: var(--gold); color: #fff;
  font-size: 16px; font-weight: 700; padding: 16px; border-radius: var(--radius-badge);
}
.lp-wrapper #sticky-cta .sticky-note{ text-align: center; font-size: 11px; color: rgba(255,255,255,0.6); margin-top: 6px; }
@media (min-width: 769px) { #sticky-cta { display: none !important; } }

/* ---- 2カラム 画像+テキスト グリッド ---- */
.lp-wrapper .two-col-inner{ display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
.lp-wrapper .two-col-image-wrap img{ width: 100%; height: 400px; object-fit: cover; border-radius: var(--radius-image); display: block; }
@media (max-width: 768px) {
  .lp-wrapper .two-col-inner{ grid-template-columns: 1fr; gap: 32px; }
  .lp-wrapper .two-col-image-wrap{ order: -1; }
  .lp-wrapper .two-col-image-wrap img{ height: 260px; }
}

/* ================== RIDE_PRO_テーマ.css ================== */
/* ============================================================
   案件テーマ: PANP RIDE PRO route-1（車ドライバー向け・高価格帯プレミアムLP）
   原稿メモ指定: 落ち着いた緑（メイン）・オレンジ（CTA・感情の橋・強調のみ）。
   変更: RIDEシリーズはブランドカラー=ゴールド #A37729（緑はAIRシリーズ）／
         CTAボタンは青（信頼の青・2026-07-04確定）／感情の橋のみオレンジ。
   使い方: tokens.css の直後・base.css の【後】に読み込む（値の上書きのみ）
   ============================================================ */
:root {
  --gold: #A37729;
  --gold-light: #C0913A;
  --gold-tint: rgba(163, 119, 41, .08);

  /* CTAボタン専用 = 青（信頼の青） */
  --cta: #1E6FD9;
  --cta-light: #3E85E8;

  /* 感情の橋 専用 = オレンジ（章末の1文のみ） */
  --bridge: #E8722A;

  /* 背景 = 温かみのある白系 */
  --bg-white: #FDFCF9;
  --bg-gray: #F5F2EC;
  --bg-dark: #1C1A17;
}
.lp-wrapper .btn-primary{ background: var(--cta); }
.lp-wrapper .btn-primary:hover{ background: var(--cta-light); }
.lp-wrapper #sticky-cta a{ background: var(--cta); }
.lp-wrapper .bridge-line{
  font-size: var(--fs-h3); font-weight: 700; color: var(--bridge);
  line-height: 1.8;
}
/* 見出しの改行位置調整用（行末1〜2文字の孤立を防ぐ・手動br禁止基準に準拠） */
.lp-wrapper .hd-nowrap{ white-space: nowrap; }

/* ================== sec-hero（FV・キャッチ主役写真型） ================== */
.lp-wrapper #sec-hero{
  position: relative; min-height: 100svh;
  display: flex; align-items: center;
  color: #fff;
}
.lp-wrapper #sec-hero .hero-bg{ position: absolute; inset: 0; overflow: hidden; }
.lp-wrapper #sec-hero .hero-bg img{ width: 100%; height: 100%; object-fit: cover; }
.lp-wrapper #sec-hero .hero-bg::after{
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.78) 0%, rgba(0,0,0,.28) 50%, rgba(0,0,0,.08) 100%);
}
.lp-wrapper #sec-hero .hero-brand{
  position: absolute; top: 28px; left: 40px; z-index: 2;
  height: 26px; width: auto; display: block;
}
.lp-wrapper #sec-hero .hero-inner{
  position: relative; z-index: 1; width: 100%;
  max-width: 1200px; margin: 0 auto;
  padding-left: 40px; padding-right: 40px; padding-top: 72px; padding-bottom: 72px;
}
.lp-wrapper #sec-hero .worry-chips{ display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
.lp-wrapper #sec-hero .worry-chips span{
  display: inline-flex; align-items: center; gap: 6px;
  font-size: var(--fs-note); font-weight: 500; color: rgba(255,255,255,.9);
  border: 1px solid rgba(255,255,255,.35);
  padding: 7px 14px; border-radius: var(--radius-pill);
  backdrop-filter: blur(2px);
}
.lp-wrapper #sec-hero .worry-chips svg{ width: 15px; height: 15px; }
.lp-wrapper #sec-hero h1{
  font-size: var(--fs-hero); font-weight: 700;
  line-height: 1.35; letter-spacing: var(--ls-hero);
  color: #fff;
  max-width: 720px; margin-bottom: 20px;
}
.lp-wrapper #sec-hero .hero-core{
  font-size: var(--fs-lead); font-weight: 700; line-height: 1.9;
  color: rgba(255,255,255,.92); max-width: 680px;
}
.lp-wrapper #sec-hero .hero-core em{ font-style: normal; color: var(--gold-light); }
@media (max-width: 768px) {
  .lp-wrapper #sec-hero .hero-brand{ left: 20px; top: 20px; }
  .lp-wrapper #sec-hero .hero-inner{ padding-left: 20px; padding-right: 20px; padding-top: 64px; padding-bottom: 88px; }
  .lp-wrapper #sec-hero h1{ font-size: calc(var(--fs-hero) * 0.82); line-height: 1.4; }
}

/* ================== sec-howto（誰でも使える・写真3ステップ型） ================== */
.lp-wrapper #sec-howto{ background: var(--bg-white); color: var(--text); }
.lp-wrapper #sec-howto .ht-inner{ max-width: 880px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper #sec-howto .ht-eyebrow{
  display: inline-block; font-size: var(--fs-note); font-weight: 700; letter-spacing: var(--ls-heading);
  color: var(--gold); background: var(--gold-tint);
  padding: 6px 16px; border-radius: var(--radius-pill); margin-bottom: 20px;
}
.lp-wrapper #sec-howto h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.55;
  letter-spacing: var(--ls-heading); color: var(--text); margin-bottom: 40px;
}
.lp-wrapper #sec-howto .ht-steps{ display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 18px; margin-bottom: 52px; }
.lp-wrapper #sec-howto .ht-step{ background: var(--bg-gray); border-radius: var(--radius-card); overflow: hidden; }
.lp-wrapper #sec-howto .ht-step img{ width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
.lp-wrapper #sec-howto .ht-step-body{ padding: 20px; }
.lp-wrapper #sec-howto .ht-step .num{
  display: inline-flex; align-items: center; justify-content: center;
  width: 34px; height: 34px; border-radius: 50%;
  background: var(--gold); color: #fff;
  font-size: var(--fs-body); font-weight: 800; letter-spacing: var(--ls-num);
  margin-bottom: 12px;
}
.lp-wrapper #sec-howto .ht-step h3{ font-size: var(--fs-lead); font-weight: 700; line-height: 1.6; color: var(--text); margin-bottom: 8px; }
.lp-wrapper #sec-howto .ht-step p{ font-size: var(--fs-note); line-height: 1.9; color: var(--text-sub); }
/* PANPカード=「難しそう」の先回り解消（2カラム: 実物写真×説明） */
.lp-wrapper #sec-howto .ht-card-block{
  display: grid; grid-template-columns: 1fr 1.2fr; gap: 28px; align-items: center;
  background: var(--gold-tint); border-radius: var(--radius-card);
  padding: 32px 28px; margin-bottom: 36px;
}
.lp-wrapper #sec-howto .ht-card-block img{ width: 100%; border-radius: var(--radius-image); display: block; }
.lp-wrapper #sec-howto .ht-card-block .worry{ font-size: var(--fs-body); font-weight: 700; line-height: 1.9; color: var(--text); margin-bottom: 12px; }
.lp-wrapper #sec-howto .ht-card-block p{ font-size: var(--fs-note); line-height: 1.9; color: var(--text-sub); margin-bottom: 8px; }
.lp-wrapper #sec-howto .ht-card-block .ht-no-unit{
  font-size: var(--fs-lead); font-weight: 700; line-height: 1.8; color: var(--gold); margin-bottom: 0;
}
.lp-wrapper #sec-howto .ht-voice{ border-left: 3px solid var(--gold); padding-left: 18px; margin: 0 0 28px; }
.lp-wrapper #sec-howto .ht-voice p{ font-size: var(--fs-note); line-height: 1.9; color: var(--text); font-style: italic; margin-bottom: 4px; }
.lp-wrapper #sec-howto .ht-voice .src{ font-size: var(--fs-micro); color: var(--text-sub); }
.lp-wrapper #sec-howto .ht-close{ font-size: var(--fs-body); font-weight: 700; line-height: 2.0; color: var(--text); }
.lp-wrapper #sec-howto .ht-close .bridge-line{ display: block; margin-top: 4px; }
@media (max-width: 768px) {
  .lp-wrapper #sec-howto .ht-steps{ grid-template-columns: 1fr; }
  .lp-wrapper #sec-howto .ht-card-block{ grid-template-columns: 1fr; padding: 24px 20px; }
  .lp-wrapper #sec-howto .ht-card-block img{ order: -1; }
}

/* ================== sec-compatible（これ1台で・実写真カード型） ================== */
.lp-wrapper #sec-compatible{ background: var(--bg-gray); color: var(--text); }
.lp-wrapper #sec-compatible .cp-inner{ max-width: 880px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper #sec-compatible .cp-eyebrow{
  display: inline-block; font-size: var(--fs-note); font-weight: 700; letter-spacing: var(--ls-heading);
  color: var(--gold); background: var(--gold-tint);
  padding: 6px 16px; border-radius: var(--radius-pill); margin-bottom: 20px;
}
.lp-wrapper #sec-compatible h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.55;
  letter-spacing: var(--ls-heading); color: var(--text); margin-bottom: 16px;
}
.lp-wrapper #sec-compatible .cp-valve{ font-size: var(--fs-body); line-height: 2.0; color: var(--text-sub); margin-bottom: 12px; }
.lp-wrapper #sec-compatible .cp-valve-pills{ display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 36px; }
.lp-wrapper #sec-compatible .cp-valve-pills span{
  font-size: var(--fs-micro); font-weight: 700; color: var(--gold);
  background: var(--bg-white); border-radius: var(--radius-pill); padding: 6px 14px;
  box-shadow: var(--shadow-card); white-space: nowrap;
}
.lp-wrapper #sec-compatible .cp-grid{ display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 40px; }
.lp-wrapper #sec-compatible .cp-card{
  background: var(--bg-white); border-radius: var(--radius-card); overflow: hidden;
  box-shadow: var(--shadow-card);
}
.lp-wrapper #sec-compatible .cp-card img{ width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
.lp-wrapper #sec-compatible .cp-card-body{ padding: 18px; }
.lp-wrapper #sec-compatible .cp-card h3{ font-size: var(--fs-lead); font-weight: 700; line-height: 1.5; color: var(--text); margin-bottom: 10px; }
.lp-wrapper #sec-compatible .cp-types{ display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
.lp-wrapper #sec-compatible .cp-types span{
  font-size: var(--fs-micro); font-weight: 700; color: var(--text-sub);
  background: var(--bg-gray); border-radius: var(--radius-pill); padding: 4px 10px;
}
.lp-wrapper #sec-compatible .cp-inner .cp-sum{
  font-size: var(--fs-lead); font-weight: 700; line-height: 1.9; color: var(--gold); margin-bottom: 14px;
}
.lp-wrapper #sec-compatible .cp-close{ font-size: var(--fs-body); font-weight: 700; line-height: 2.0; color: var(--text); }
.lp-wrapper #sec-compatible .cp-close .bridge-line{ display: block; margin-top: 4px; }
@media (max-width: 768px) {
  .lp-wrapper #sec-compatible .cp-grid{ grid-template-columns: 1fr 1fr; }
  .lp-wrapper #sec-compatible .cp-card h3{ font-size: var(--fs-body); }
}

/* ================== sec-voices（10万人＋お客様の声＋CTA／最多の声先出し型） ================== */
.lp-wrapper #sec-voices{ background: var(--bg-white); color: var(--text); }
.lp-wrapper #sec-voices .vo-inner{ max-width: 880px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper #sec-voices .vo-eyebrow{
  display: inline-block; font-size: var(--fs-note); font-weight: 700; letter-spacing: var(--ls-heading);
  color: var(--gold); background: var(--gold-tint);
  padding: 6px 16px; border-radius: var(--radius-pill); margin-bottom: 20px;
}
.lp-wrapper #sec-voices .vo-inner .vo-top-voice{
  font-size: calc(var(--fs-h2) * 1.1); font-weight: 800; line-height: 1.5;
  letter-spacing: var(--ls-heading); color: var(--gold);
  margin-bottom: 12px;
}
.lp-wrapper #sec-voices .vo-top-label{ font-size: var(--fs-body); line-height: 2.0; color: var(--text-sub); margin-bottom: 36px; }
/* 評価サマリーバー（総合★・件数・星1件数を先出しして証拠を集約） */
.lp-wrapper #sec-voices .vo-rating{
  display: flex; align-items: center; gap: 24px;
  background: var(--bg-gray); border-radius: var(--radius-card);
  padding: 22px 28px; margin-bottom: 30px;
}
.lp-wrapper #sec-voices .vo-rating .vo-rating-score{ text-align: center; flex-shrink: 0; }
.lp-wrapper #sec-voices .vo-rating .vo-rating-num{
  font-size: calc(var(--fs-stat) * 1.15); font-weight: 800; letter-spacing: var(--ls-num);
  line-height: 1; color: var(--gold); display: block;
}
.lp-wrapper #sec-voices .vo-rating .vo-rating-stars{ color: var(--star); font-size: var(--fs-lead); letter-spacing: 3px; display: block; margin-top: 4px; }
.lp-wrapper #sec-voices .vo-rating .vo-rating-meta{ border-left: 1px solid rgba(0,0,0,.12); padding-left: 24px; }
.lp-wrapper #sec-voices .vo-rating .vo-rating-meta p{ font-size: var(--fs-note); line-height: 1.7; color: var(--text-sub); margin: 0; }
.lp-wrapper #sec-voices .vo-rating .vo-rating-meta strong{ font-size: var(--fs-lead); font-weight: 800; color: var(--text); letter-spacing: var(--ls-num); }
@media (max-width: 768px) {
  .lp-wrapper #sec-voices .vo-rating{ gap: 16px; padding: 18px 20px; }
  .lp-wrapper #sec-voices .vo-rating .vo-rating-meta{ padding-left: 16px; }
}
.lp-wrapper #sec-voices h2{
  font-size: var(--fs-lead); font-weight: 700; line-height: 1.6;
  letter-spacing: var(--ls-heading); color: var(--text); margin-bottom: 18px;
}
.lp-wrapper #sec-voices .vo-band{
  display: grid; grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid rgba(0,0,0,.12); border-bottom: 1px solid rgba(0,0,0,.12);
  margin-bottom: 16px;
}
.lp-wrapper #sec-voices .vo-band-cell{ padding: 18px 10px; text-align: center; }
.lp-wrapper #sec-voices .vo-band-cell + .vo-band-cell{ border-left: 1px solid rgba(0,0,0,.12); }
.lp-wrapper #sec-voices .vo-band-cell h3{ font-size: var(--fs-micro); font-weight: 700; color: var(--text-sub); margin-bottom: 6px; }
.lp-wrapper #sec-voices .vo-band-cell .vo-num{
  font-size: calc(var(--fs-stat) * 0.7); font-weight: 800; letter-spacing: var(--ls-num);
  line-height: 1.1; color: var(--text); white-space: nowrap;
}
.lp-wrapper #sec-voices .vo-band-cell .vo-num em{
  font-style: normal; font-size: 0.45em; font-weight: 700; color: var(--text-sub);
  letter-spacing: var(--ls-heading); margin-left: 3px;
}
.lp-wrapper #sec-voices .vo-band-cell .vo-num .star-mark{ color: var(--star); }
.lp-wrapper #sec-voices .vo-band-cell .vo-num em.denom{ font-size: 0.45em; }
.lp-wrapper #sec-voices .vo-medal{ text-align: center; margin: 24px 0 8px; }
.lp-wrapper #sec-voices .vo-medal img{ width: 52%; max-width: 220px; height: auto; display: inline-block; }
.lp-wrapper #sec-voices .vo-note{ font-size: var(--fs-micro); color: var(--text-sub); margin-bottom: 44px; }
