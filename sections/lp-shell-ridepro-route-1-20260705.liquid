.lp-wrapper #sec-accuracy .psi-value{ font-size: calc(var(--fs-stat) * 1.4); font-weight: 800; letter-spacing: var(--ls-num); line-height: 1; white-space: nowrap; color: var(--gold-light); }
.lp-wrapper #sec-accuracy .psi-value .psi-unit{ font-size: 0.35em; font-weight: 700; color: rgba(255,255,255,.7); margin-left: 6px; }
/* 単一数字のカウントアップ: 35.0から目標40.0までゆっくり上がり、同じ数値になったら止まる */
