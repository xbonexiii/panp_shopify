  .lp-wrapper .accuracy-inner{ grid-template-columns: 1fr; gap: 40px; }
  .lp-wrapper .accuracy-image-wrap{ order: -1; }
  .lp-wrapper .accuracy-image-wrap img{ height: 280px; }
  .lp-wrapper .power-stats{ grid-template-columns: 1fr; gap: 2px; }
