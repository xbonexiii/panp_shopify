<style>

/* === TOKENS === */
:root {
  --blue: #0071e3;
  --blue-light: #0079f1;
  --gold: #A37729;
  --gold-light: #c49535;
  --text: #1d1d1f;
  --bg-white: #ffffff;
  --bg-gray: #f5f5f7;
  --bg-dark: #1d1d1f;
  --badge-gold: #C79E10;
  --badge-text: #1d1d1f;
  --font-family: Helvetica, Arial, sans-serif;
}

/* === RESET & BASE === */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
.lp-wrapper{ scroll-behavior: smooth; overflow-x: hidden; }
.lp-wrapper{
  font-family: var(--font-family);
  color: var(--text); font-size: 17px; line-height: 1.7; overflow-x: hidden;
}
.lp-wrapper img{ max-width: 100%; height: auto; display: block; }
.lp-wrapper a{ color: inherit; text-decoration: none; }
.lp-wrapper section{ width: 100%; }
.lp-wrapper .container{ max-width: 1200px; margin: 0 auto; padding: 0 40px; }
.lp-wrapper .section-padding{ padding: 100px 0; }
.lp-wrapper h2.section-title{ font-size: 40px; font-weight: 700; line-height: 1.3; letter-spacing: -0.01em; }

/* === ANIMATIONS === */
.lp-wrapper .fade-in{ opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
.lp-wrapper .fade-in.visible{ opacity: 1; transform: translateY(0); }
.lp-wrapper .slide-left{ opacity: 0; transform: translateX(-48px); transition: opacity 0.8s ease, transform 0.8s ease; }
.lp-wrapper .slide-right{ opacity: 0; transform: translateX(48px);  transition: opacity 0.8s ease, transform 0.8s ease; }
.lp-wrapper .slide-up{ opacity: 0; transform: translateY(32px);  transition: opacity 0.7s ease, transform 0.7s ease; }
.lp-wrapper .slide-left.visible,  .lp-wrapper .slide-right.visible,  .lp-wrapper .slide-up.visible{ opacity: 1; transform: none; }
@media (max-width: 768px) {
  .lp-wrapper .slide-left{ transform: translateX(0); }
  .lp-wrapper .slide-right{ transform: translateX(0); }
}
.lp-wrapper .fade-in-delay-1{ transition-delay: 0.1s; }
.lp-wrapper .fade-in-delay-2{ transition-delay: 0.2s; }
.lp-wrapper .fade-in-delay-3{ transition-delay: 0.3s; }
.lp-wrapper .fade-in-delay-4{ transition-delay: 0.4s; }

/* === BUTTONS === */
.lp-wrapper .btn-primary{
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--blue); color: #fff;
  font-size: 18px; font-weight: 700; padding: 18px 40px;
  border-radius: 50px; cursor: pointer;
  transition: background 0.2s, transform 0.1s;
  border: none; letter-spacing: 0.02em; white-space: nowrap;
}
@media (max-width: 768px) {
  .lp-wrapper .btn-primary{ font-size: 15px; padding: 16px 24px; }
}
.lp-wrapper .btn-primary:hover{ background: var(--blue-light); transform: translateY(-1px); }
.lp-wrapper .btn-secondary{
  display: inline-block; color: var(--blue); font-size: 15px; font-weight: 500;
  margin-top: 16px; border-bottom: 1px solid currentColor; padding-bottom: 2px;
}

/* === EYEBROW === */
.lp-wrapper .eyebrow{
  display: inline-block; font-size: 13px; font-weight: 700;
  letter-spacing: 0.12em; color: var(--blue); text-transform: uppercase;
  margin-bottom: 16px;
}

/* === HERO === */
.lp-wrapper #sec-hero{
  position: relative; min-height: 100vh;
  display: flex; align-items: center;
  background: #0a0a14; overflow: hidden;
}
.lp-wrapper #sec-hero .hero-bg{
  position: absolute; inset: 0;
  width: 100%; height: 130%; top: -15%;
  object-fit: cover; object-position: center;
  opacity: 0.55;
}
.lp-wrapper #sec-hero .hero-overlay{
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(0,20,60,0.75) 0%, rgba(0,0,0,0.5) 60%, rgba(0,0,0,0.2) 100%);
}
.lp-wrapper #sec-hero .hero-content{
  position: relative; z-index: 1;
  max-width: 760px;
}
.lp-wrapper #sec-hero .hero-eyebrow{
  display: inline-block; font-size: 13px; font-weight: 700;
  letter-spacing: 0.12em; color: rgba(255,255,255,0.65);
  text-transform: uppercase; margin-bottom: 24px;
  border: 1px solid rgba(255,255,255,0.25); border-radius: 50px;
  padding: 6px 16px;
}
.lp-wrapper #sec-hero h1{
  font-size: clamp(36px, 5vw, 64px); font-weight: 700;
  line-height: 1.2; letter-spacing: -0.02em;
  color: #fff; margin-bottom: 24px;
}
.lp-wrapper #sec-hero .hero-sub{
  font-size: clamp(17px, 2vw, 21px); color: rgba(255,255,255,0.8);
  line-height: 1.6; margin-bottom: 36px; max-width: 560px;
}
.lp-wrapper #sec-hero .hero-cta-note{
  font-size: 13px; color: rgba(255,255,255,0.55); margin-top: 12px;
  letter-spacing: 0.02em;
}
.lp-wrapper .hero-social-proof{
  display: flex; align-items: center; gap: 8px; margin-top: 16px;
  color: #fff; font-size: 14px;
}
.lp-wrapper .hero-social-proof .stars{ color: #f5c518; letter-spacing: 2px; font-size: 16px; }
.lp-wrapper .scroll-hint{
  position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  color: rgba(255,255,255,0.5); font-size: 10px; letter-spacing: 0.15em;
  text-transform: uppercase; animation: scroll-bounce 2.2s infinite;
}
.lp-wrapper .scroll-hint svg{ width: 20px; height: 20px; }
@keyframes scroll-bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.5; }
  50%       { transform: translateX(-50%) translateY(8px); opacity: 0.9; }
}

/* === EMPATHY (LOSS) === */
.lp-wrapper #sec-empathy{ background: var(--bg-gray); }
.lp-wrapper #sec-empathy .empathy-body{
  font-size: 18px; line-height: 1.9; color: #515154;
  max-width: 680px; margin-bottom: 56px;
}
.lp-wrapper #sec-empathy .empathy-body strong{ color: var(--text); }
.lp-wrapper .loss-cards{
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 40px;
}
.lp-wrapper .loss-card{
  background: #fff; border-radius: 20px; padding: 32px 24px; text-align: center;
  box-shadow: 0 8px 32px rgba(0,0,0,0.06);
}
.lp-wrapper .loss-card .lc-icon{
  font-size: 32px; margin-bottom: 16px;
}
.lp-wrapper .loss-card .lc-label{
  font-size: 13px; font-weight: 600; color: #86868b;
  letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 8px;
}
.lp-wrapper .loss-card .lc-value{
  font-size: clamp(32px, 4vw, 48px); font-weight: 800;
  color: var(--text); line-height: 1; margin-bottom: 8px;
}
.lp-wrapper .loss-card .lc-unit{ font-size: 18px; font-weight: 600; }
.lp-wrapper .loss-card .lc-desc{ font-size: 14px; color: #86868b; line-height: 1.5; }
.lp-wrapper .loss-card .lc-source{
  font-size: 11px; color: #aaa; margin-top: 8px; font-style: italic;
}
.lp-wrapper .loss-total{
  background: var(--bg-dark); color: #fff;
  border-radius: 20px; padding: 40px 48px;
  display: flex; align-items: center; justify-content: space-between; gap: 32px;
  flex-wrap: wrap;
}
.lp-wrapper .loss-total .lt-label{ font-size: 16px; color: rgba(255,255,255,0.7); margin-bottom: 8px; }
.lp-wrapper .loss-total .lt-value{
  font-size: clamp(48px, 7vw, 88px); font-weight: 800; color: #fff; line-height: 1;
}
.lp-wrapper .loss-total .lt-note{ font-size: 13px; color: rgba(255,255,255,0.5); margin-top: 8px; }
.lp-wrapper .loss-total .lt-right{ font-size: 16px; line-height: 1.8; color: rgba(255,255,255,0.75); }

/* === EMPATHY-2 === */
.lp-wrapper #sec-empathy-2{ background: var(--bg-white); }
.lp-wrapper .pain-quotes{
  display: grid; grid-template-columns: 1fr; gap: 0; max-width: 680px;
}
.lp-wrapper .pain-quote{
  padding: 28px 32px; border-left: 3px solid var(--blue);
  margin-bottom: 20px;
  background: #f8f9ff; border-radius: 0 12px 12px 0;
}
.lp-wrapper .pain-quote q{
  font-size: 20px; font-weight: 600; color: var(--text);
  line-height: 1.6; font-style: italic; display: block;
  quotes: "「" "」";
}
.lp-wrapper .pain-quote q::before{ content: open-quote; }
.lp-wrapper .pain-quote q::after{ content: close-quote; }
.lp-wrapper .pain-summary{
  margin-top: 40px; font-size: 18px; color: #515154; line-height: 1.8;
  max-width: 640px;
}
.lp-wrapper .pain-summary strong{ color: var(--text); }

/* === SOLUTION === */
.lp-wrapper #sec-solution{ background: var(--bg-gray); }
.lp-wrapper .solution-inner{
  display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center;
}
.lp-wrapper .solution-text .sol-features{ margin-top: 32px; }
.lp-wrapper .sol-feature{
  display: flex; gap: 16px; align-items: flex-start; margin-bottom: 24px;
}
.lp-wrapper .sol-feature .sf-icon{
  width: 44px; height: 44px; background: var(--blue);
  border-radius: 12px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.lp-wrapper .sol-feature .sf-icon svg{ width: 22px; height: 22px; stroke: #fff; }
.lp-wrapper .sol-feature .sf-text .sf-title{ font-size: 16px; font-weight: 700; margin-bottom: 4px; }
.lp-wrapper .sol-feature .sf-text .sf-desc{ font-size: 15px; color: #515154; line-height: 1.6; }
.lp-wrapper .solution-image-wrap img{
  width: 100%; height: 440px; object-fit: cover;
  border-radius: 20px;
}

/* === MID CTA === */
.lp-wrapper #sec-cta-mid{
  background: var(--bg-dark); color: #fff; padding: 72px 0; text-align: center;
}
.lp-wrapper #sec-cta-mid .mid-cta-inner{ max-width: 560px; margin: 0 auto; }
.lp-wrapper #sec-cta-mid .mid-cta-title{
  font-size: 28px; font-weight: 700; line-height: 1.4; margin-bottom: 12px;
}
.lp-wrapper #sec-cta-mid .mid-cta-sub{ font-size: 15px; opacity: 0.7; margin-bottom: 32px; }
.lp-wrapper #sec-cta-mid .mid-cta-note{ font-size: 13px; opacity: 0.55; margin-top: 12px; }

/* === FEATURES ACCURACY === */
.lp-wrapper #sec-features-accuracy{ background: var(--bg-white); }
.lp-wrapper .accuracy-inner{
  display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center;
}
.lp-wrapper .accuracy-big-num{
  font-size: clamp(80px, 12vw, 140px); font-weight: 800; color: var(--blue);
  line-height: 1; letter-spacing: -0.03em; margin: 24px 0 8px;
}
.lp-wrapper .accuracy-unit{ font-size: 32px; font-weight: 700; color: var(--blue); }
.lp-wrapper .accuracy-caption{ font-size: 16px; color: #515154; line-height: 1.7; }
.lp-wrapper .accuracy-points{ margin-top: 40px; }
.lp-wrapper .acc-point{
  display: flex; gap: 14px; align-items: flex-start; margin-bottom: 20px;
  padding-bottom: 20px; border-bottom: 1px solid #e8e8ed;
}
.lp-wrapper .acc-point:last-child{ border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
.lp-wrapper .acc-point .ap-num{
  width: 32px; height: 32px; background: var(--blue); color: #fff;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 700; flex-shrink: 0; margin-top: 2px;
}
.lp-wrapper .acc-point .ap-text .ap-title{ font-size: 16px; font-weight: 700; margin-bottom: 4px; }
.lp-wrapper .acc-point .ap-text .ap-desc{ font-size: 15px; color: #515154; line-height: 1.6; }
.lp-wrapper .accuracy-image-wrap img{
  width: 100%; height: 400px; object-fit: cover; border-radius: 20px;
}

/* === FEATURES POWER === */
.lp-wrapper #sec-features-power{
  background: var(--bg-dark); color: #fff;
  padding: 100px 0;
}
.lp-wrapper #sec-features-power .eyebrow{ color: rgba(255,255,255,0.5); }
.lp-wrapper #sec-features-power h2.section-title{ color: #fff; }
.lp-wrapper #sec-features-power .power-sub{
  font-size: 18px; color: rgba(255,255,255,0.65); max-width: 560px;
  margin-top: 16px; line-height: 1.7;
}
.lp-wrapper .power-stats{
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 2px; margin-top: 64px; border-radius: 20px; overflow: hidden;
}
.lp-wrapper .power-stat{
  background: rgba(255,255,255,0.06); padding: 40px 32px; text-align: center;
}
.lp-wrapper .power-stat .ps-value{
  font-size: clamp(40px, 6vw, 68px); font-weight: 800; color: #fff;
  line-height: 1; letter-spacing: -0.02em;
}
.lp-wrapper .power-stat .ps-unit{ font-size: 20px; font-weight: 600; }
.lp-wrapper .power-stat .ps-label{
  font-size: 15px; color: rgba(255,255,255,0.6); margin-top: 12px; line-height: 1.5;
}
.lp-wrapper .power-note{
  margin-top: 24px; font-size: 14px; color: rgba(255,255,255,0.4);
  text-align: center;
}

/* === FEATURES COMPATIBLE === */
.lp-wrapper #sec-features-compatible{ background: var(--bg-gray); }
.lp-wrapper .compatible-hero{
  position: relative; width: 100%;
  aspect-ratio: 3/2; max-height: 520px;
  overflow: hidden; margin-bottom: 60px;
  border-radius: 20px;
}
.lp-wrapper .compatible-hero img{
  width: 100%; height: 100%;
  object-fit: cover; object-position: center;
}
.lp-wrapper .compatible-hero-overlay{
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.72));
  display: flex; flex-direction: column;
  align-items: flex-start; justify-content: flex-end;
  padding: 40px 48px;
}
.lp-wrapper .compatible-hero-eyebrow{
  font-size: 13px; font-weight: 600; letter-spacing: 0.12em;
  color: rgba(255,255,255,0.75); text-transform: uppercase; margin-bottom: 10px;
}
.lp-wrapper .compatible-hero-text{
  color: #fff; font-size: 28px; font-weight: 700;
  line-height: 1.45; letter-spacing: -0.01em;
}
.lp-wrapper .compatible-icon-grid{
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px;
  max-width: 720px; margin: 0 auto;
}
.lp-wrapper .compatible-item{ text-align: center; }
.lp-wrapper .compatible-icon{
  width: 80px; height: 80px; margin: 0 auto 14px;
  display: block; object-fit: contain;
}
.lp-wrapper .compatible-name{
  font-size: 16px; font-weight: 700; margin-bottom: 4px;
}
.lp-wrapper .compatible-note{
  font-size: 14px; color: #86868b; line-height: 1.5;
}
.lp-wrapper .compatible-footer{
  margin-top: 48px; text-align: center; font-size: 14px; color: #86868b;
}
.lp-wrapper .compatible-footer a{ color: var(--blue); border-bottom: 1px solid currentColor; }

/* === PROOF === */
.lp-wrapper #sec-proof{
  position: relative; background: #0a0a0f; overflow: hidden; padding: 120px 0 100px;
}
.lp-wrapper #sec-proof .proof-bg{
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; opacity: 0.1;
}
.lp-wrapper #sec-proof .proof-overlay{
  position: absolute; inset: 0;
  background: radial-gradient(ellipse at 50% 40%, rgba(10,10,15,0.5) 0%, rgba(10,10,15,0.92) 75%);
}
.lp-wrapper #sec-proof .container{ position: relative; z-index: 1; }
.lp-wrapper #sec-proof .eyebrow{ color: var(--gold); }
.lp-wrapper #sec-proof h2.section-title{ color: #fff; }
.lp-wrapper #sec-proof .proof-sub{
  font-size: 17px; color: rgba(255,255,255,0.6); margin-top: 12px; margin-bottom: 56px;
}
.lp-wrapper .medals{
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-bottom: 60px;
}
.lp-wrapper .medal-card{
  background: #fff; border-radius: 20px; padding: 40px 24px; text-align: center;
  box-shadow: 0 16px 56px rgba(0,0,0,0.4), 0 2px 8px rgba(0,0,0,0.2);
}
.lp-wrapper .medal-label{
  font-size: 14px; font-weight: 700; color: #515154;
  margin-top: 20px; letter-spacing: 0.02em;
}
/* Laurel Badge CSS */
.lp-wrapper .laurel-badge{
  display: inline-flex; align-items: center; justify-content: center;
  gap: 0; padding: 8px 0; max-width: 100%;
}
.lp-wrapper .laurel-badge .laurel-img{
  height: 160px; width: auto; display: block; flex-shrink: 0;
}
.lp-wrapper .laurel-badge.compact .laurel-img{ height: 120px; }
.lp-wrapper .laurel-badge .laurel-img.left{ margin-right: -28px; z-index: 0; }
.lp-wrapper .laurel-badge .laurel-img.right{ margin-left: -28px; z-index: 0; }
.lp-wrapper .laurel-badge.compact .laurel-img.left{ margin-right: -22px; }
.lp-wrapper .laurel-badge.compact .laurel-img.right{ margin-left: -22px; }
.lp-wrapper .laurel-content{
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 6px; padding: 0 18px; position: relative; z-index: 1; text-align: center;
}
.lp-wrapper .laurel-eyebrow{
  font-size: 11px; font-weight: 700; letter-spacing: 0.1em; color: var(--badge-gold);
  text-transform: uppercase; line-height: 1.25; white-space: nowrap;
}
.lp-wrapper .laurel-num{
  font-size: 64px; font-weight: 700; color: var(--badge-text); line-height: 1;
  letter-spacing: -0.04em; font-feature-settings: "tnum";
  display: inline-flex; align-items: baseline; justify-content: center;
  margin: 0; white-space: nowrap;
}
.lp-wrapper .laurel-badge.compact .laurel-num{ font-size: 48px; }
.lp-wrapper .laurel-num .laurel-unit{ font-size: 13px; font-weight: 600; margin-left: 2px; }
.lp-wrapper .laurel-footer{
  font-size: 11px; font-weight: 600; color: var(--badge-text);
  letter-spacing: 0.3em; padding-left: 0.3em; white-space: nowrap;
}
/* Proof stats */
.lp-wrapper .proof-stats{
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px;
  border-radius: 16px; overflow: hidden;
}
.lp-wrapper .proof-stat{
  background: rgba(255,255,255,0.05); padding: 32px 24px; text-align: center;
}
.lp-wrapper .proof-stat .ps-num{
  font-size: clamp(28px, 3.5vw, 44px); font-weight: 800; color: #fff;
  line-height: 1; letter-spacing: -0.02em; margin-bottom: 8px;
}
.lp-wrapper .proof-stat .ps-label{
  font-size: 14px; color: rgba(255,255,255,0.55); line-height: 1.5;
}
.lp-wrapper .proof-stat .ps-num sup{
  font-size: 0.5em; font-weight: 600; vertical-align: super; letter-spacing: 0;
  color: rgba(255,255,255,0.5);
}
.lp-wrapper .proof-notes{
  margin-top: 24px; padding-top: 20px;
  border-top: 1px solid rgba(255,255,255,0.1);
}
.lp-wrapper .proof-notes p{
  font-size: 11px; color: rgba(255,255,255,0.4); line-height: 1.8;
  margin: 0;
}

/* === HOWTO === */
.lp-wrapper #sec-howto{ background: var(--bg-white); }
.lp-wrapper .howto-grid{
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px;
  margin-top: 56px;
}
.lp-wrapper .howto-step{
  background: var(--bg-gray); border-radius: 20px; overflow: hidden;
}
.lp-wrapper .howto-step-img{
  width: 100%; height: 240px; object-fit: cover;
}
.lp-wrapper .howto-step-body{ padding: 28px 28px 32px; }
.lp-wrapper .howto-step-num{
  font-size: 13px; font-weight: 700; color: var(--blue);
  letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px;
}
.lp-wrapper .howto-step-title{ font-size: 20px; font-weight: 700; margin-bottom: 10px; }
.lp-wrapper .howto-step-desc{ font-size: 15px; color: #515154; line-height: 1.7; }
.lp-wrapper .howto-caption{
  margin-top: 40px; text-align: center; font-size: 16px; color: #515154;
  line-height: 1.8;
}

/* === GUARANTEE === */
.lp-wrapper #sec-guarantee{ background: var(--bg-gray); }
.lp-wrapper .guarantee-inner{
  display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center;
}
.lp-wrapper .guarantee-items{ margin-top: 32px; }
.lp-wrapper .guarantee-item{
  display: flex; gap: 16px; align-items: flex-start;
  padding: 20px 0; border-bottom: 1px solid #e8e8ed;
}
.lp-wrapper .guarantee-item:last-child{ border-bottom: none; }
.lp-wrapper .gi-check{
  width: 36px; height: 36px; background: var(--blue); border-radius: 50%;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.lp-wrapper .gi-check svg{ width: 18px; height: 18px; stroke: #fff; }
.lp-wrapper .gi-title{ font-size: 16px; font-weight: 700; margin-bottom: 4px; }
.lp-wrapper .gi-desc{ font-size: 15px; color: #515154; line-height: 1.6; }
.lp-wrapper .guarantee-image-wrap img{
  width: 100%; height: 400px; object-fit: cover; border-radius: 20px;
}

/* === FAQ === */
.lp-wrapper #sec-faq{ background: var(--bg-white); }
.lp-wrapper .faq-list{ margin-top: 48px; max-width: 800px; }
.lp-wrapper .faq-item{
  border-bottom: 1px solid #e8e8ed;
}
.lp-wrapper .faq-q{
  display: flex; justify-content: space-between; align-items: center;
  padding: 24px 0; cursor: pointer;
  font-size: 17px; font-weight: 600; line-height: 1.5;
  background: none; border: none; width: 100%; text-align: left; color: var(--text);
}
.lp-wrapper .faq-q .fq-icon{
  width: 24px; height: 24px; flex-shrink: 0; margin-left: 16px;
  position: relative; transition: transform 0.3s;
}
.lp-wrapper .faq-q .fq-icon::before,  .lp-wrapper .faq-q .fq-icon::after{
  content: ''; position: absolute; background: var(--blue);
  border-radius: 2px;
}
.lp-wrapper .faq-q .fq-icon::before{ width: 18px; height: 2px; left: 3px; top: 11px; }
.lp-wrapper .faq-q .fq-icon::after{ width: 2px; height: 18px; left: 11px; top: 3px; transition: transform 0.3s; }
.lp-wrapper .faq-item.open .faq-q .fq-icon::after{ transform: rotate(90deg); }
.lp-wrapper .faq-a{
  display: none; padding: 0 0 24px; font-size: 16px; color: #515154;
  line-height: 1.8;
}
.lp-wrapper .faq-item.open .faq-a{ display: block; }

/* === FINAL CTA === */
.lp-wrapper #sec-cta{
  background: #0a0a0f; padding: 120px 0; text-align: center;
  position: relative; overflow: hidden;
}
.lp-wrapper #sec-cta .cta-bg{
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; opacity: 0.12;
}
.lp-wrapper #sec-cta .container{ position: relative; z-index: 1; }
.lp-wrapper .cta-voice{ max-width: 480px; margin: 0 auto 40px; }
.lp-wrapper .cta-voice blockquote{
  font-size: 15px; line-height: 1.7; color: rgba(255,255,255,0.8);
  font-style: italic; margin: 0 0 8px;
  border-left: 2px solid var(--blue); padding-left: 14px; text-align: left;
}
.lp-wrapper .cta-voice cite{
  font-size: 12px; color: rgba(255,255,255,0.45);
  display: block; text-align: right;
}
.lp-wrapper #sec-cta h2.section-title{
  color: #fff; font-size: clamp(28px, 4.5vw, 48px); margin-bottom: 40px;
}
.lp-wrapper .cta-badges{
  display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-bottom: 48px;
}
.lp-wrapper .cta-badge{
  background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
  border-radius: 50px; padding: 8px 20px; font-size: 14px; color: rgba(255,255,255,0.9);
}
.lp-wrapper .cta-price-label{
  font-size: 14px; color: rgba(255,255,255,0.5); margin-bottom: 8px;
}
.lp-wrapper .cta-price-value{
  font-size: clamp(40px, 6vw, 64px); font-weight: 800; color: #fff;
  line-height: 1; margin-bottom: 8px;
}
.lp-wrapper .cta-price-note{ font-size: 14px; color: rgba(255,255,255,0.5); margin-bottom: 32px; }
.lp-wrapper #sec-cta .btn-secondary{
  color: rgba(255,255,255,0.6); border-color: rgba(255,255,255,0.3);
  display: block; margin-top: 20px;
}

/* === STICKY CTA === */
.lp-wrapper #sticky-cta{
  display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 8000;
  padding: 12px 20px 20px;
  background: linear-gradient(to top, rgba(0,0,0,0.92) 80%, transparent);
}
.lp-wrapper #sticky-cta a{
  display: block; width: 100%; text-align: center;
  background: var(--blue); color: #fff;
  font-size: 16px; font-weight: 700; padding: 16px; border-radius: 12px;
}
.lp-wrapper #sticky-cta .sticky-note{
  text-align: center; font-size: 11px; color: rgba(255,255,255,0.6); margin-top: 6px;
}
@media (min-width: 769px) { #sticky-cta { display: none !important; } }

/* === MOBILE === */
@media (max-width: 768px) {
  .lp-wrapper{ font-size: 16px; }
  .lp-wrapper .container{ padding: 0 20px; }
  .lp-wrapper .section-padding{ padding: 64px 0; }
