/* ─── 04: プロダクトビューワー（Apple section-product-viewer 準拠）── */

/* ── 共通ルール（全ブレイクポイント） ── */
.lp-wrapper .viewer{ background: var(--color-bg); }
.lp-wrapper .viewer__card{ position: relative; background: var(--color-bg-section); overflow: hidden; }
.lp-wrapper .viewer__media-item{ position: absolute; inset: 0; opacity: 0; pointer-events: none; will-change: opacity, transform; }
.lp-wrapper .viewer__media-item img{ width: 100%; height: 100%; }
/* 入場: 右から浮き出る（translateX + opacity） */
.lp-wrapper .viewer__media-item.is-active{ opacity: 1; transform: translateX(0); transition: opacity 500ms cubic-bezier(0.28, 0.11, 0.32, 1) 50ms, transform 600ms cubic-bezier(0.28, 0.11, 0.32, 1); }
/* 退場: 左へフェードアウト */
.lp-wrapper .viewer__media-item.is-leaving{ opacity: 0; transform: translateX(-8%); transition: opacity 200ms ease-in, transform 200ms ease-in; }
/* 待機: 右側にスタンバイ */
