<div class="fh" id="fh-{{ section.id }}">

  {%- comment -%} グリッド背景 {%- endcomment -%}
  <div class="fh__grid">
    {% for block in section.blocks %}
      <div class="fh__cell fh__cell--{{ forloop.index }}" {{ block.shopify_attributes }}>
        <div class="fh__cell-inner">
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
              width="800"
              height="600"
            >
          {% else %}
            <div class="fh__cell-placeholder"></div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {%- comment -%} 複数レイヤーのオーバーレイ {%- endcomment -%}
  <div class="fh__overlay fh__overlay--base"></div>
  <div class="fh__overlay fh__overlay--radial"></div>
  <div class="fh__overlay fh__overlay--vignette"></div>
  <div class="fh__overlay fh__overlay--center"></div>

  {%- comment -%} 中央コンテンツ {%- endcomment -%}
  <div class="fh__content">
    <h1 class="fh__title">{{ section.settings.title }}</h1>
    <p class="fh__subtitle">{{ section.settings.subtitle }}</p>
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="fh__button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
    {% if section.settings.button_note != blank %}
      <p class="fh__note">{{ section.settings.button_note }}</p>
    {% endif %}
  </div>


</div>

{%- style -%}

/* ========== ベース ========== */
.fh {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 640px;
  background-color: #0e0e0e;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== グリッド ========== */
.fh__grid {
  position: absolute;
  inset: -20px;
  display: grid;
  gap: 10px;
  padding: 10px;
  grid-template-columns: 1.2fr 1fr 1.4fr 1fr 1.2fr;
  grid-template-rows: 1fr 1.1fr 1fr;
}

/* --- セルのデフォルト --- */
.fh__cell {
  border-radius: 18px;
  overflow: hidden;
  background: #1a1a1a;
}

.fh__cell-inner {
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: inherit;
}

.fh__cell-inner img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transform: scale(1.08);
}

.fh__cell-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1c1c1c, #252525);
}

/* --- ランダムサイズ: grid-column/row spans --- */
.fh__cell--1  { grid-column: 1; grid-row: 1; }
.fh__cell--2  { grid-column: 2; grid-row: 1; }
.fh__cell--3  { grid-column: 3; grid-row: 1 / 3; } /* 縦2行 */
.fh__cell--4  { grid-column: 4; grid-row: 1; }
.fh__cell--5  { grid-column: 5; grid-row: 1; }
.fh__cell--6  { grid-column: 1; grid-row: 2; }
.fh__cell--7  { grid-column: 2; grid-row: 2; }
/* col3 は cell-3 が占有 */
.fh__cell--8  { grid-column: 4; grid-row: 2; }
.fh__cell--9  { grid-column: 5; grid-row: 2; }
.fh__cell--10 { grid-column: 1 / 3; grid-row: 3; } /* 横2列 */
.fh__cell--11 { grid-column: 3; grid-row: 3; }
.fh__cell--12 { grid-column: 4 / 6; grid-row: 3; } /* 横2列 */

/* ========== アニメーション ========== */

/* 個別ドリフトアニメーション */
@keyframes fh-drift-a {
  0%   { transform: scale(1.08) translate(0px, 0px); }
  25%  { transform: scale(1.1)  translate(4px, -6px); }
  50%  { transform: scale(1.08) translate(-3px, -3px); }
  75%  { transform: scale(1.09) translate(2px, 5px); }
  100% { transform: scale(1.08) translate(0px, 0px); }
}

@keyframes fh-drift-b {
  0%   { transform: scale(1.08) translate(0px, 0px); }
  30%  { transform: scale(1.09) translate(-5px, 4px); }
  60%  { transform: scale(1.1)  translate(3px, -5px); }
  100% { transform: scale(1.08) translate(0px, 0px); }
}

@keyframes fh-drift-c {
  0%   { transform: scale(1.08) translate(0px, 0px); }
  40%  { transform: scale(1.1)  translate(6px, 3px); }
  70%  { transform: scale(1.09) translate(-4px, 6px); }
  100% { transform: scale(1.08) translate(0px, 0px); }
}

/* 輝度フェード */
@keyframes fh-glow-a {
  0%, 100% { filter: brightness(0.75) saturate(1); }
  50%       { filter: brightness(0.95) saturate(1.1); }
}

@keyframes fh-glow-b {
  0%, 100% { filter: brightness(0.6)  saturate(0.9); }
  50%       { filter: brightness(0.85) saturate(1.05); }
}

/* セルごとにアニメーション割り当て */
.fh__cell--1  .fh__cell-inner img { animation: fh-drift-a 14s ease-in-out infinite; }
.fh__cell--2  .fh__cell-inner img { animation: fh-drift-b 18s ease-in-out infinite 2s; }
.fh__cell--3  .fh__cell-inner img { animation: fh-drift-c 20s ease-in-out infinite 1s; }
.fh__cell--4  .fh__cell-inner img { animation: fh-drift-a 16s ease-in-out infinite 3s; }
.fh__cell--5  .fh__cell-inner img { animation: fh-drift-b 15s ease-in-out infinite 0.5s; }
.fh__cell--6  .fh__cell-inner img { animation: fh-drift-c 19s ease-in-out infinite 4s; }
.fh__cell--7  .fh__cell-inner img { animation: fh-drift-a 13s ease-in-out infinite 1.5s; }
.fh__cell--8  .fh__cell-inner img { animation: fh-drift-b 17s ease-in-out infinite 2.5s; }
.fh__cell--9  .fh__cell-inner img { animation: fh-drift-c 14s ease-in-out infinite 0.8s; }
.fh__cell--10 .fh__cell-inner img { animation: fh-drift-a 21s ease-in-out infinite 3.5s; }
.fh__cell--11 .fh__cell-inner img { animation: fh-drift-b 16s ease-in-out infinite 1.2s; }
.fh__cell--12 .fh__cell-inner img { animation: fh-drift-c 18s ease-in-out infinite 2.8s; }

/* セルごとに輝度アニメーション */
.fh__cell--1  { animation: fh-glow-b 8s ease-in-out infinite; }
.fh__cell--2  { animation: fh-glow-a 10s ease-in-out infinite 1s; }
.fh__cell--3  { animation: fh-glow-b 12s ease-in-out infinite 2s; }
.fh__cell--4  { animation: fh-glow-a 9s ease-in-out infinite 0.5s; }
.fh__cell--5  { animation: fh-glow-b 11s ease-in-out infinite 3s; }
.fh__cell--6  { animation: fh-glow-a 8s ease-in-out infinite 1.5s; }
.fh__cell--7  { animation: fh-glow-b 13s ease-in-out infinite 2.5s; }
.fh__cell--8  { animation: fh-glow-a 10s ease-in-out infinite 4s; }
.fh__cell--9  { animation: fh-glow-b 9s ease-in-out infinite 0.3s; }
.fh__cell--10 { animation: fh-glow-a 14s ease-in-out infinite 1.8s; }
.fh__cell--11 { animation: fh-glow-b 11s ease-in-out infinite 3.2s; }
.fh__cell--12 { animation: fh-glow-a 12s ease-in-out infinite 0.7s; }

/* ========== オーバーレイ (4層) ========== */

/* 層1: 全体ベース黒 */
.fh__overlay--base {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.62);
  pointer-events: none;
  z-index: 1;
}

/* 層2: 端を強く暗くするラジアルグラデーション */
.fh__overlay--radial {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse 55% 50% at 50% 50%,
    rgba(0, 0, 0, 0)    0%,
    rgba(0, 0, 0, 0.35) 45%,
    rgba(0, 0, 0, 0.82) 100%
  );
  pointer-events: none;
  z-index: 2;
}

/* 層3: 上下ビネット強化 */
.fh__overlay--vignette {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to bottom,
      rgba(0,0,0,0.78) 0%,
      rgba(0,0,0,0)    22%,
      rgba(0,0,0,0)    65%,
      rgba(0,0,0,0.82) 100%
    );
  pointer-events: none;
  z-index: 3;
}

/* 層4: コンテンツ周辺のソフトスポット */
.fh__overlay--center {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse 40% 35% at 50% 50%,
    rgba(0, 0, 0, 0.3) 0%,
    rgba(0, 0, 0, 0)   100%
  );
  pointer-events: none;
  z-index: 4;
}

/* ========== コンテンツ ========== */
.fh__content {
  position: relative;
  z-index: 10;
  text-align: center;
  color: #fff;
  padding: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  animation: fh-content-in 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes fh-content-in {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* タイトル */
.fh__title {
  font-size: clamp(72px, 13vw, 180px);
  font-weight: 700;
  line-height: 0.95;
  margin: 0;
  color: #fff;
  letter-spacing: -4px;
  text-shadow:
    0 0 80px rgba(255,255,255,0.15),
    0 0 160px rgba(255,255,255,0.08);
}

/* サブタイトル */
.fh__subtitle {
  font-size: clamp(15px, 1.8vw, 21px);
  color: rgba(255, 255, 255, 0.8);
  margin: 0;
  max-width: 540px;
  line-height: 1.5;
  font-weight: 400;
}

/* CTAボタン */
.fh__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 6px;
  padding: 18px 52px;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(20px) saturate(1.5);
  -webkit-backdrop-filter: blur(20px) saturate(1.5);
  border-radius: 999px;
  color: #fff;
  font-size: 18px;
  font-weight: 600;
  text-decoration: none;
  letter-spacing: 0.01em;
  transition: background 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.15),
    0 4px 24px rgba(0,0,0,0.3);
}

.fh__button:hover {
  background: rgba(255, 255, 255, 0.22);
  border-color: rgba(255, 255, 255, 0.4);
  transform: scale(1.03);
  color: #fff;
}

/* 注釈テキスト */
.fh__note {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.45);
  margin: 0;
}


/* ========== レスポンシブ: タブレット (1024px以下) ========== */
@media (max-width: 1024px) {
  .fh__grid {
    grid-template-columns: 1fr 1.3fr 1fr 1fr;
    grid-template-rows: 1fr 1.1fr 1fr;
    gap: 8px;
    padding: 8px;
    inset: -12px;
  }

  .fh__cell--1  { grid-column: 1;     grid-row: 1; }
  .fh__cell--2  { grid-column: 2 / 4; grid-row: 1; }
  .fh__cell--3  { grid-column: 4;     grid-row: 1 / 3; }
  .fh__cell--4  { grid-column: 1;     grid-row: 2; }
  .fh__cell--5  { grid-column: 2;     grid-row: 2; }
  .fh__cell--6  { grid-column: 3;     grid-row: 2; }
  .fh__cell--7  { grid-column: 1 / 3; grid-row: 3; }
  .fh__cell--8  { grid-column: 3;     grid-row: 3; }
  .fh__cell--9  { grid-column: 4;     grid-row: 3; }
  .fh__cell--10 { display: none; }
  .fh__cell--11 { display: none; }
  .fh__cell--12 { display: none; }
}

/* ========== レスポンシブ: スマートフォン (767px以下) ========== */
@media (max-width: 767px) {
  .fh {
    min-height: 100svh;
  }

  .fh__grid {
    grid-template-columns: 1fr 1.4fr 1fr;
    grid-template-rows: 1fr 1fr 1.2fr 1fr;
    gap: 6px;
    padding: 6px;
    inset: -8px;
  }

  .fh__cell--1  { grid-column: 1;     grid-row: 1; }
  .fh__cell--2  { grid-column: 2;     grid-row: 1 / 3; }
  .fh__cell--3  { grid-column: 3;     grid-row: 1; }
  .fh__cell--4  { grid-column: 1;     grid-row: 2; }
  .fh__cell--5  { grid-column: 3;     grid-row: 2; }
  .fh__cell--6  { grid-column: 1 / 3; grid-row: 3; }
  .fh__cell--7  { grid-column: 3;     grid-row: 3; }
  .fh__cell--8  { grid-column: 1;     grid-row: 4; }
  .fh__cell--9  { grid-column: 2;     grid-row: 4; }
  .fh__cell--10 { grid-column: 3;     grid-row: 4; }
  .fh__cell--11 { display: none; }
  .fh__cell--12 { display: none; }

  .fh__cell { border-radius: 12px; }

  .fh__content { padding: 16px; gap: 12px; }
  .fh__title   { letter-spacing: -1px; }
  .fh__subtitle { font-size: 14px; max-width: 300px; }
  .fh__button  { padding: 14px 32px; font-size: 15px; }
  .fh__note    { font-size: 11px; }

  /* モバイルはオーバーレイをさらに強化 */
  .fh__overlay--base { background: rgba(0,0,0,0.68); }
}

{%- endstyle -%}

{% schema %}
{
  "name": "Flowヒーロー",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "タイトル",
      "default": "Flow"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "サブタイトル",
      "default": "Where the next wave of storytelling happens"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "ボタンテキスト",
      "default": "今すぐ始める"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "ボタンリンク"
    },
    {
      "type": "text",
      "id": "button_note",
      "label": "ボタン下の注釈テキスト",
      "default": "Explore Google AI Subscriptions. See FAQ."
    },
  ],
  "blocks": [
    {
      "type": "image",
      "name": "グリッド画像",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "画像"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flowヒーロー",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
