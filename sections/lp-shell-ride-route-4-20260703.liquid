/* ================== 商流2速さ電池小さい_交互2カラム型.html ================== */
/* ===== このセクション専用CSS（トークン変数のみ） ===== */
.lp-wrapper .st-sec{ color: var(--text); }
.lp-wrapper .st-sec .st-inner{
  max-width: 880px; width: calc(100% - 40px); margin: 0 auto;
  display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: center;
  text-align: left;
}
.lp-wrapper .st-sec.is-flip .st-inner .st-text{ order: 2; }
.lp-wrapper .st-sec.is-flip .st-inner .st-media{ order: 1; }
.lp-wrapper .st-sec .st-eyebrow{
  display: inline-block; font-size: var(--fs-note); font-weight: 700; letter-spacing: var(--ls-heading);
  color: var(--gold); background: var(--gold-tint);
  padding: 6px 16px; border-radius: var(--radius-pill); margin-bottom: 18px;
}
.lp-wrapper .st-sec h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.55;
  letter-spacing: var(--ls-heading); color: var(--text); margin-bottom: 16px;
}
.lp-wrapper .st-sec .st-body{ font-size: var(--fs-body); line-height: 2.0; color: var(--text-sub); margin-bottom: 18px; }
/* 主役スタッツ（--fs-stat書式・接頭辞/単位は0.4em従属・詳細度はコンテナ込み） */
.lp-wrapper .st-sec .st-text .st-stat{
  font-size: calc(var(--fs-stat) * 1.4); font-weight: 800; letter-spacing: var(--ls-num);
  line-height: 1.1; color: var(--gold); white-space: nowrap; margin-bottom: 6px;
}
/* 接頭辞・単位（日本語）は --ls-num の詰めを解除し、見出し用字間＋広めの余白で読みやすく */
.lp-wrapper .st-sec .st-text .st-stat em{
  font-style: normal; font-size: 0.4em; font-weight: 700; color: var(--text-sub);
  letter-spacing: var(--ls-heading); margin-left: 8px;
}
.lp-wrapper .st-sec .st-text .st-stat em.pre{ margin-left: 0; margin-right: 8px; }
.lp-wrapper .st-sec .st-stat-label{ font-size: var(--fs-note); font-weight: 700; color: var(--text-sub); margin-bottom: 20px; }
.lp-wrapper .st-sec .st-media img{
  width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block;
  border-radius: var(--radius-image); box-shadow: var(--shadow-card);
}
/* 速さ: 4乗り物ミニスタッツ */
.lp-wrapper .st-sec .st-mini-grid{ display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 18px; }
.lp-wrapper .st-sec .st-mini{
  position: relative; overflow: hidden;
  background: var(--bg-white); border-radius: var(--radius-badge); padding: 14px 16px;
  box-shadow: var(--shadow-card);
}
/* 乗り物写真を背景に敷き、左からの白グラデで文字の可読性を確保（右側に写真が見える） */
.lp-wrapper .st-sec .st-mini .mini-bg{
  position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;
}
.lp-wrapper .st-sec .st-mini .mini-overlay{
  position: absolute; inset: 0;
  background: linear-gradient(to right, rgba(255,255,255,.95) 40%, rgba(255,255,255,.55) 100%);
}
.lp-wrapper .st-sec .st-mini > h3,  .lp-wrapper .st-sec .st-mini > p,  .lp-wrapper .st-sec .st-mini > span{ position: relative; }
.lp-wrapper .st-sec .st-mini h3{ font-size: var(--fs-note); font-weight: 700; color: var(--text); margin-bottom: 4px; }
.lp-wrapper .st-sec .st-mini .st-mini-time{
  font-size: calc(var(--fs-stat) * 0.62); font-weight: 800; letter-spacing: var(--ls-num);
  color: var(--gold); white-space: nowrap; line-height: 1.2;
}
