}
.lp-wrapper .st-sec .st-close{ font-size: var(--fs-body); font-weight: 700; line-height: 1.9; color: var(--text); }
@media (max-width: 768px) {
  .lp-wrapper .st-sec .st-inner{ grid-template-columns: 1fr; gap: 24px; }
  /* 画像→テキストの読み順（交互は解除して常に画像が上） */
  .lp-wrapper .st-sec .st-inner .st-media,  .lp-wrapper .st-sec.is-flip .st-inner .st-media{ order: -1; }
  .lp-wrapper .st-sec.is-flip .st-inner .st-text{ order: 0; }
}

