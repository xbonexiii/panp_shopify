/* レビューカード（確定基準UI） */
.lp-wrapper #sec-pricing .review-card{
  max-width: 680px; width: calc(100% - 40px); margin: 28px auto 0;
  background: var(--bg-white); border-radius: var(--radius-image);
  padding: 18px 20px; box-shadow: var(--shadow-card);
}
.lp-wrapper #sec-pricing .review-head{ display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.lp-wrapper #sec-pricing .review-avatar{
  width: 36px; height: 36px; border-radius: var(--radius-pill);
