.lp-wrapper #sec-pricing .review-meta{ font-size: var(--fs-micro); font-weight: 700; color: var(--text); line-height: 1.5; }
.lp-wrapper #sec-pricing .review-meta .stars{ display: block; color: var(--star); letter-spacing: 2px; }
.lp-wrapper #sec-pricing .review-card p{ font-size: var(--fs-body); line-height: 1.9; color: var(--text); }
.lp-wrapper #sec-pricing .pr-close{
