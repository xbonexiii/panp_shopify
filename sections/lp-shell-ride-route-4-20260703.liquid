<style>

/* ================== tokens.css ================== */
/* ============================================================
   デザイントークン（:root）— 全LP・全セクション共通の正
   出典: CLAUDE.md 実装スタンダードA + route-1-product-lp_セクションデザイン集の
         基本ルール（数字書式・角丸3階層・影1種・clamp見出し統一）を変数化
   ------------------------------------------------------------
   【鉄則】セクション専用CSSでは、色・文字サイズ・字間・角丸・影を
   ここの変数でのみ指定する（直書き禁止）。
   例外: ダーク背景上の白系・オーバーレイの黒系 rgba(255,255,255,α) / rgba(0,0,0,α) のみ直書き可。
   テイスト変更はこのファイルの「値」だけを差し替える（変数名・構造は共通のまま）。
   見た目の確認は スタイルガイド.html で行う。
   ============================================================ */
:root {
  /* ---- 色 ---- */
  --gold: #A37729;             /* ブランドカラー（メインアクセント・RIDE系） */
  --gold-light: #c49535;       /* ホバー時・ダーク上のアクセント */
  --gold-tint: rgba(163,119,41,.1);  /* アイコンバッジ・チップの淡い下地 */
  --blue: #0071e3;             /* CTA・リンクの共通アクセント（PANP全ブランド共通） */
  --text: #1d1d1f;
  --text-sub: #6e6e73;         /* 副次テキストは必ずこの変数。直書きグレー禁止 */
  --bg-white: #ffffff;
  --bg-gray: #f5f5f7;          /* セクション区切り */
  --bg-dark: #1d1d1f;          /* ダーク背景セクション・中間CTA */
  --star: #f5c518;             /* レビュー星（base.cssの既存値を変数化・全ブランド共通） */

  /* ---- タイポグラフィ（サイズ階層） ---- */
  --fs-hero: clamp(32px, 5.5vw, 68px);         /* ヒーローh1（フルスクリーン型） */
  --fs-hero-compact: clamp(30px, 4.2vw, 54px); /* ヒーローh1（2カラム等の省スペース型） */
  --fs-h2: clamp(28px, 3.5vw, 44px);           /* セクション見出し（全セクション統一） */
  --fs-h3: 22px;                               /* カード見出し・小見出し */
  --fs-stat: clamp(28px, 3.6vw, 48px);         /* 実績数字（font-weight:800 とセット） */
  --fs-lead: clamp(16px, 1.6vw, 20px);         /* リード文・サブコピー */
  --fs-body: 17px;                             /* 本文 */
  --fs-note: 13px;                             /* 注記・eyebrow・CTA下の補足 */
  --fs-micro: 12px;                            /* チップ・キャプション・最小テキスト */

  /* ---- 字間 ---- */
  --ls-hero: -0.03em;      /* ヒーローh1 */
  --ls-heading: -0.02em;   /* セクション見出し */
  --ls-num: -0.04em;       /* 実績数字（大きく詰める） */

  /* ---- 角丸（3階層固定・これ以外を作らない） ---- */
  --radius-card: 24px;     /* カード・大きな画像コンテナ */
  --radius-image: 16px;    /* 2カラム内の画像 */
  --radius-badge: 12px;    /* アイコンバッジ・小さなカード */
  --radius-pill: 50px;     /* ボタン・チップ・eyebrow */

  /* ---- 影（1種のみ・これ以上濃くしない） ---- */
  --shadow-card: 0 2px 20px rgba(0,0,0,.06);

  /* ---- セクション余白 ---- */
  --section-pad: 100px;    /* PC */
  --section-pad-sp: 64px;  /* モバイル */
}

/* ================== base.css ================== */
/* ============================================================
   ベースCSS（全LP共通）— コピーして <style> に内包する
   出典: CLAUDE.md 実装スタンダードB〜I・K（2026-07-03 移設・トークン参照化）
   前提: tokens.css（:root 変数）を先頭に内包していること
   ============================================================ */

/* ---- B. ベース ---- */
.lp-wrapper *,  .lp-wrapper *::before,  .lp-wrapper *::after{ box-sizing: border-box; margin: 0; padding: 0; }
.lp-wrapper{ scroll-behavior: smooth; }
.lp-wrapper{
  font-family: Helvetica, Arial, sans-serif;
  color: var(--text); font-size: var(--fs-body); line-height: 1.7; overflow-x: hidden;
}
.lp-wrapper img{ max-width: 100%; height: auto; display: block; }
.lp-wrapper a{ color: inherit; text-decoration: none; }
.lp-wrapper section{ width: 100%; }
/* 見出しは常にコンテナの色を継承（Shopify反映時にテーマの h1/h2{color:#1d1d1f} 直接指定へ負けて黒くなる再発バグを防ぐ・省略禁止） */
.lp-wrapper h1,  .lp-wrapper h2,  .lp-wrapper h3,  .lp-wrapper h4,  .lp-wrapper h5,  .lp-wrapper h6{ color: inherit; }
.lp-wrapper .container{ max-width: 1200px; margin: 0 auto; padding: 0 40px; }
.lp-wrapper .section-padding{ padding-top: var(--section-pad); padding-bottom: var(--section-pad); }
.lp-wrapper h2.section-title{ font-size: var(--fs-h2); font-weight: 700; line-height: 1.3; letter-spacing: var(--ls-heading); }
@media (max-width: 768px) {
  .lp-wrapper{ font-size: 16px; }
  .lp-wrapper .container{ padding: 0 20px; }
  .lp-wrapper .section-padding{ padding-top: var(--section-pad-sp); padding-bottom: var(--section-pad-sp); }
}

/* ---- C. アニメーションクラス（4種） ----
   fade-in: ヒーロー内の eyebrow / h1 / subheadline / CTAボタン
   slide-left: 2カラムのテキスト側（左） / slide-right: 2カラムの画像側（右）
   slide-up: グリッドカード・ステップ・アイコン群
   delay-1〜4: fade-in と併用する時差（ヒーロー内の順次出現） */
.lp-wrapper .fade-in{
  opacity: 0; transform: translateY(24px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.lp-wrapper .fade-in.visible{ opacity: 1; transform: translateY(0); }
.lp-wrapper .slide-left{ opacity: 0; transform: translateX(-48px); transition: opacity 0.8s ease, transform 0.8s ease; }
.lp-wrapper .slide-right{ opacity: 0; transform: translateX(48px);  transition: opacity 0.8s ease, transform 0.8s ease; }
.lp-wrapper .slide-up{ opacity: 0; transform: translateY(32px);  transition: opacity 0.7s ease, transform 0.7s ease; }
.lp-wrapper .slide-left.visible,  .lp-wrapper .slide-right.visible,  .lp-wrapper .slide-up.visible{ opacity: 1; transform: none; }
.lp-wrapper .delay-1{ transition-delay: .15s; }
.lp-wrapper .delay-2{ transition-delay: .3s; }
.lp-wrapper .delay-3{ transition-delay: .45s; }
.lp-wrapper .delay-4{ transition-delay: .6s; }

/* ---- D. ボタンコンポーネント ---- */
.lp-wrapper .btn-primary{
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--gold); color: #fff;
  font-size: 18px; font-weight: 700; padding: 18px 40px;
  border-radius: var(--radius-pill); cursor: pointer;
  transition: background 0.2s, transform 0.1s;
  border: none; letter-spacing: 0.02em;
}
.lp-wrapper .btn-primary:hover{ background: var(--gold-light); transform: translateY(-1px); }
.lp-wrapper .btn-secondary{
  display: inline-block; color: var(--gold); font-size: 15px; font-weight: 500;
  margin-top: 16px; border-bottom: 1px solid currentColor; padding-bottom: 2px;
}

/* ---- E. スクロール誘導矢印（ヒーロー下端・HTMLスニペットはREADME参照） ---- */
.lp-wrapper .scroll-hint{
  position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  color: rgba(255,255,255,0.55); font-size: 10px; letter-spacing: 0.15em;
  text-transform: uppercase; animation: scroll-bounce 2.2s infinite;
}
.lp-wrapper .scroll-hint svg{ width: 20px; height: 20px; }
@keyframes scroll-bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.55; }
  50%       { transform: translateX(-50%) translateY(8px); opacity: 0.9; }
}

/* ---- F. 中間CTA（#sec-cta-mid・解決策セクション直後に置く） ---- */
.lp-wrapper #sec-cta-mid{
  background: var(--bg-dark); color: #fff; padding: 72px 0; text-align: center;
}
.lp-wrapper #sec-cta-mid .mid-cta-inner{ max-width: 560px; margin: 0 auto; }
.lp-wrapper #sec-cta-mid .mid-cta-title{ font-size: 28px; font-weight: 700; line-height: 1.4; margin-bottom: 12px; }
.lp-wrapper #sec-cta-mid .mid-cta-sub{ font-size: 15px; opacity: 0.75; margin-bottom: 32px; }
.lp-wrapper #sec-cta-mid .mid-cta-note{ font-size: var(--fs-note); opacity: 0.6; margin-top: 12px; }
@media (max-width: 768px) {
  .lp-wrapper #sec-cta-mid{ padding: 56px 0; }
}

/* ---- G. ソーシャルプルーフ（ヒーロー内） ---- */
.lp-wrapper .hero-social-proof{ display: flex; align-items: center; gap: 8px; margin-top: 12px; color: #fff; font-size: 14px; }
.lp-wrapper .hero-social-proof .stars{ color: #f5c518; letter-spacing: 2px; font-size: 16px; }

/* ---- H. 最終CTA直前 お客様の声引用 ---- */
.lp-wrapper .cta-voice{ max-width: 480px; margin: 0 auto 32px; text-align: center; }
.lp-wrapper .cta-voice blockquote{
  font-size: 15px; line-height: 1.7; color: rgba(255,255,255,0.85);
  font-style: italic; margin: 0 0 8px;
  border-left: 2px solid var(--gold); padding-left: 14px; text-align: left;
}
.lp-wrapper .cta-voice cite{ font-size: var(--fs-micro); color: rgba(255,255,255,0.5); display: block; text-align: right; }

/* ---- I. モバイルスティッキーCTA（HTMLスニペットはREADME参照） ---- */
.lp-wrapper #sticky-cta{
  display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 8000;
  padding: 12px 20px 20px;
  background: linear-gradient(to top, rgba(0,0,0,0.92) 80%, transparent);
}
.lp-wrapper #sticky-cta a{
  display: block; width: 100%; text-align: center;
  background: var(--gold); color: #fff;
  font-size: 16px; font-weight: 700; padding: 16px; border-radius: var(--radius-badge);
}
.lp-wrapper #sticky-cta .sticky-note{ text-align: center; font-size: 11px; color: rgba(255,255,255,0.6); margin-top: 6px; }
@media (min-width: 769px) { #sticky-cta { display: none !important; } }

/* ---- K. 2カラム 画像+テキスト グリッド（共通パターン） ----
   テキスト左・画像右が基本。モバイルは order:-1 で画像を上に */
.lp-wrapper .two-col-inner{
  display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center;
}
.lp-wrapper .two-col-image-wrap img{ width: 100%; height: 400px; object-fit: cover; border-radius: var(--radius-image); display: block; }
@media (max-width: 768px) {
  .lp-wrapper .two-col-inner{ grid-template-columns: 1fr; gap: 32px; }
  .lp-wrapper .two-col-image-wrap{ order: -1; }
  .lp-wrapper .two-col-image-wrap img{ height: 260px; }
}


/* ================== RIDE商流2_テーマ.css ================== */
/* ============================================================
   案件テーマ: PANP RIDE 商流2（「これで合ってる」不安→安心LP）
   原稿メモ指定: 落ち着いた緑（メイン）・オレンジ（CTA・感情の橋・強調のみ）・
                温かみのある白（背景）・グレースケール。これ以外は使わない。
   変更履歴: 2026-07-04 市山さん指示によりCTAボタンを青に変更
             （感情の橋=bridge-lineはオレンジのまま・--bridge変数に分離）。
             ※原稿メモの色指定（CTA=オレンジ）からの変更点。
   使い方: tokens.css の直後に読み込む（値の上書きのみ。変数名・構造は共通）
   <link rel="stylesheet" href=".../tokens.css">
   <link rel="stylesheet" href=".../themes/RIDE商流2_テーマ.css">
   ============================================================ */
:root {
  /* メインアクセント = 落ち着いた緑（変数名 --gold は共通構造維持のため。意味は「メインアクセント」） */
  --gold: #A37729;
  --gold-light: #C0913A;
  --gold-tint: rgba(163, 119, 41, .08);

  /* CTAボタン専用 = 青（2026-07-04変更・信頼の青） */
  --cta: #1E6FD9;
  --cta-light: #3E85E8;

  /* 感情の橋 専用 = オレンジ（章末の1文のみ・CTAとは役割を分離） */
  --bridge: #E8722A;

  /* 背景 = 温かみのある白系 */
  --bg-white: #FDFCF9;   /* 温白（基本背景） */
  --bg-gray: #F5F2EC;    /* 温グレー（セクション区切り） */
  --bg-dark: #1C1A17;    /* 最暗部（「放っておくと」等・温かみのある黒） */
}

/* CTAボタンは青（メインアクセントの緑と分離する） */
.lp-wrapper .btn-primary{ background: var(--cta); }
.lp-wrapper .btn-primary:hover{ background: var(--cta-light); }
.lp-wrapper #sticky-cta a{ background: var(--cta); }

/* 感情の橋（章末の1文・オレンジ使用が許される数少ない場所） */
.lp-wrapper .bridge-line{
  /* 次セクションへの繋ぎ文＝少し大きく（2026-07-04指示・--fs-body→--fs-h3。見出しh2は食わない中間サイズ） */
  font-size: var(--fs-h3); font-weight: 700; color: var(--bridge);
  line-height: 1.8;
}


/* ================== 商流2FV_キャッチ主役写真型.html ================== */
/* ===== このセクション専用CSS（トークン変数のみ） ===== */
.lp-wrapper #sec-hero{
  position: relative; min-height: 100svh;
  display: flex; align-items: center; /* テキストは縦中央寄せ（第2Rレビュー反映） */
  color: #fff;
}
.lp-wrapper #sec-hero .hero-bg{ position: absolute; inset: 0; overflow: hidden; }
.lp-wrapper #sec-hero .hero-bg img{ width: 100%; height: 100%; object-fit: cover; }
.lp-wrapper #sec-hero .hero-bg::after{
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.78) 0%, rgba(0,0,0,.28) 50%, rgba(0,0,0,.08) 100%);
}
.lp-wrapper #sec-hero .hero-brand{
  position: absolute; top: 28px; left: 40px; z-index: 2;
  height: 26px; width: auto; display: block;
}
.lp-wrapper #sec-hero .hero-inner{
  position: relative; z-index: 1; width: 100%;
  max-width: 1200px; margin: 0 auto;
  padding-left: 40px; padding-right: 40px; padding-top: 72px; padding-bottom: 72px;
}
/* 不安ワードチップはキャッチ＋芯の一言の下に置く（第3Rレビュー反映: コピーを先に読ませる） */
.lp-wrapper #sec-hero .worry-chips{ display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
.lp-wrapper #sec-hero .worry-chips span{
  display: inline-flex; align-items: center; gap: 6px;
  font-size: var(--fs-note); font-weight: 500; color: rgba(255,255,255,.9);
  border: 1px solid rgba(255,255,255,.35);
  padding: 7px 14px; border-radius: var(--radius-pill);
  backdrop-filter: blur(2px);
}
.lp-wrapper #sec-hero .worry-chips svg{ width: 15px; height: 15px; }
.lp-wrapper #sec-hero h1{
  font-size: var(--fs-hero); font-weight: 700;
  line-height: 1.35; letter-spacing: var(--ls-hero);
  color: #fff; /* ダーク上の見出しは明示（Shopify対策） */
  max-width: 680px; margin-bottom: 20px; /* 説明文と横幅を統一（第2Rレビュー反映） */
}
.lp-wrapper #sec-hero .hero-core{
  font-size: var(--fs-lead); font-weight: 700; line-height: 1.9;
  color: rgba(255,255,255,.92); max-width: 680px;
}
.lp-wrapper #sec-hero .hero-core em{ font-style: normal; color: var(--gold-light); }
.lp-wrapper #sec-hero .hero-lead{
  font-size: var(--fs-body); font-weight: 400; line-height: 1.95;
  color: rgba(255,255,255,.88); max-width: 640px; margin-top: 22px;
}
.lp-wrapper #sec-hero .hd-nowrap{ white-space: nowrap; } /* 行末1文字の孤立を防ぐ（手動br禁止） */
/* eyebrow（見出し上の小ラベル）を全セクション非表示（ユーザー指示 2026-07-16） */
.lp-wrapper [data-slot="eyebrow"]{ display: none !important; }
@media (max-width: 768px) {
  .lp-wrapper #sec-hero .hero-brand{ left: 20px; top: 20px; }
  .lp-wrapper #sec-hero .hero-inner{ padding-left: 20px; padding-right: 20px; padding-top: 64px; padding-bottom: 88px; }
  .lp-wrapper #sec-hero h1{ font-size: calc(var(--fs-hero) * 0.82); line-height: 1.4; }
}

/* ================== 商流2放置_フォトオーバーレイ型.html ================== */
/* ===== このセクション専用CSS（トークン変数のみ） ===== */
.lp-wrapper #sec-loss{ background: var(--bg-dark); color: #fff; }
.lp-wrapper #sec-loss .loss-head{ max-width: 680px; margin: 0 auto; padding: 0 20px 56px; }
.lp-wrapper #sec-loss h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.5;
  letter-spacing: var(--ls-heading);
  color: #fff; /* ダーク見出しは明示（Shopify対策） */
  margin-bottom: 24px;
}
.lp-wrapper #sec-loss .loss-lead p{ font-size: var(--fs-lead); line-height: 2.0; color: rgba(255,255,255,.85); margin-bottom: 8px; }
.lp-wrapper #sec-loss .risk-band{ position: relative; overflow: hidden; }
.lp-wrapper #sec-loss .risk-band .band-bg{ position: absolute; inset: 0; }
.lp-wrapper #sec-loss .risk-band .band-bg img{ width: 100%; height: 100%; object-fit: cover; }
.lp-wrapper #sec-loss .risk-band .band-bg::after{
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(to right, rgba(0,0,0,.82) 0%, rgba(0,0,0,.62) 55%, rgba(0,0,0,.35) 100%);
}
.lp-wrapper #sec-loss .risk-band .band-inner{
  position: relative; z-index: 1;
  max-width: 680px; margin: 0 auto;
  padding: 72px 20px;
}
.lp-wrapper #sec-loss .risk-label{
  display: inline-flex; align-items: center; gap: 9px;
  font-size: var(--fs-body); font-weight: 700; letter-spacing: 0.06em;
  color: var(--gold-light);
  border: 1px solid rgba(255,255,255,.3);
  padding: 9px 20px; border-radius: var(--radius-pill);
  margin-bottom: 20px;
}
.lp-wrapper #sec-loss .risk-label svg{ width: 18px; height: 18px; }
.lp-wrapper #sec-loss .risk-band p{ font-size: var(--fs-body); line-height: 2.0; color: rgba(255,255,255,.9); margin-bottom: 8px; max-width: 34em; }
/* 生声（楽天レビュー風UI・ダーク背景のためしっぽなし） */
.lp-wrapper #sec-loss .risk-voice{ display: flex; align-items: flex-start; gap: 12px; margin: 22px 0 4px; max-width: 34em; }
.lp-wrapper #sec-loss .risk-voice .avatar{
  width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0;
  background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.22);
  display: flex; align-items: center; justify-content: center;
}
.lp-wrapper #sec-loss .risk-voice .avatar svg{ width: 24px; height: 24px; color: rgba(255,255,255,.7); }
.lp-wrapper #sec-loss .risk-voice .bubble{
  flex: 1; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.18);
  border-radius: var(--radius-card); padding: 14px 18px 12px;
}
.lp-wrapper #sec-loss .risk-voice .bubble .v-meta{ display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
.lp-wrapper #sec-loss .risk-voice .quote-mark{ width: 16px; height: 16px; color: var(--gold-light); opacity: .6; flex-shrink: 0; }
.lp-wrapper #sec-loss .risk-voice .src{
  font-size: var(--fs-micro); color: rgba(255,255,255,.6); margin-left: auto;
  background: rgba(255,255,255,.08); border-radius: var(--radius-pill); padding: 3px 10px; white-space: nowrap;
}
.lp-wrapper #sec-loss .risk-voice .bubble p{
  font-size: var(--fs-note); line-height: 1.9; color: rgba(255,255,255,.88);
  letter-spacing: var(--ls-heading); margin-bottom: 0;
}
.lp-wrapper #sec-loss .loss-summary{
  max-width: 680px; margin: 0 auto;
  padding: 64px 20px 0;
  font-size: var(--fs-lead); font-weight: 700; line-height: 2.0; color: #fff;
}
.lp-wrapper #sec-loss .bridge-line{ display: block; margin-top: 8px; }
@media (max-width: 768px) {
  .lp-wrapper #sec-loss .risk-band .band-inner{ padding: 56px 20px; }
}

/* ================== 商流2共感_生声吹き出し型.html ================== */
/* ===== このセクション専用CSS（トークン変数のみ） ===== */
.lp-wrapper #sec-not-alone{ background: var(--bg-gray); color: var(--text); }
.lp-wrapper #sec-not-alone .na-inner{ max-width: 680px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper #sec-not-alone .na-eyebrow{
  display: inline-block; font-size: var(--fs-note); font-weight: 700; letter-spacing: var(--ls-heading);
  color: var(--gold); background: var(--gold-tint);
  padding: 6px 16px; border-radius: var(--radius-pill); margin-bottom: 20px;
}
.lp-wrapper #sec-not-alone h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.55;
  letter-spacing: var(--ls-heading); color: var(--text); margin-bottom: 18px;
}
.lp-wrapper #sec-not-alone .na-lead{ font-size: var(--fs-body); line-height: 2.0; color: var(--text-sub); margin-bottom: 30px; }
/* 生声（楽天レビュー風UI: 人物アイコン＋吹き出し＋出所ラベル）。
