.lp-wrapper #sec-pricing{ background: var(--bg-gray); color: var(--text); }
.lp-wrapper #sec-pricing .pr-inner{ max-width: 680px; margin: 0 auto; padding: 0 20px; text-align: left; }
.lp-wrapper #sec-pricing h2{
