<!-- モバイルスティッキーCTA（scripts.js が sec-solution 通過後に表示・sec-final-cta 表示中は非表示に制御） -->
<div id="sticky-cta">
  <a href="https://panp.jp/cart/40536152244275:1?storefront=true">カートに入れる</a>
  <p class="sticky-note">お届けの送料は無料・30日、返品できます</p>
