/* ================== 商流2約束_2カード型.html ================== */
/* ===== このセクション専用CSS（トークン変数のみ） ===== */
.lp-wrapper #sec-guarantee{ background: var(--bg-gray); color: var(--text); }
.lp-wrapper #sec-guarantee .gr-inner{ max-width: 680px; margin: 0 auto; padding: 0 20px; text-align: left; }
.lp-wrapper #sec-guarantee .gr-topbadge{
  display: inline-block; background: var(--gold); color: #fff;
  font-size: var(--fs-note); font-weight: 700; letter-spacing: 0.04em;
  padding: 8px 20px; border-radius: var(--radius-pill); margin-bottom: 16px;
}
.lp-wrapper #sec-guarantee h2{
  font-size: var(--fs-h2); font-weight: 700; line-height: 1.5;
  letter-spacing: var(--ls-heading); color: var(--text); margin-bottom: 40px;
}
.lp-wrapper #sec-guarantee .gr-cards{
  display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
  max-width: 880px; width: calc(100% - 40px); margin: 0 auto 44px;
}
.lp-wrapper #sec-guarantee .gr-card{
  background: var(--bg-white); border-radius: var(--radius-card);
  padding: 32px 28px; box-shadow: var(--shadow-card);
}
.lp-wrapper #sec-guarantee .gr-label{
  display: inline-flex; align-items: center; gap: 8px;
  font-size: var(--fs-note); font-weight: 700; color: var(--gold);
  background: var(--gold-tint);
  padding: 6px 16px; border-radius: var(--radius-pill); margin-bottom: 18px;
}
.lp-wrapper #sec-guarantee .gr-label svg{ width: 15px; height: 15px; }
/* 数字が各カードの絶対的な主役（○判定済みの数字帯型と同スケール --fs-stat×1.9）
   【バグ修正】.gr-card p のルールが .gr-stat より詳細度が高く数字を小さく上書きしていた
   → 数字系セレクタに .gr-card を含め、本文ルールは :not() で数字を除外 */
.lp-wrapper #sec-guarantee .gr-card .gr-stat{
  font-size: calc(var(--fs-stat) * 1.9); font-weight: 800; letter-spacing: var(--ls-num);
  line-height: 1.05; color: var(--gold); white-space: nowrap; margin-bottom: 8px;
}
.lp-wrapper #sec-guarantee .gr-card .gr-stat em{ font-style: normal; font-size: 0.4em; font-weight: 700; color: var(--text-sub); margin-left: 2px; }
.lp-wrapper #sec-guarantee .gr-card .gr-stat em.pre{ margin-left: 0; margin-right: 4px; } /* 「最大」は単位と同サイズの接頭辞 */
.lp-wrapper #sec-guarantee .gr-card .gr-stat-sub{ font-size: var(--fs-lead); font-weight: 700; color: var(--text); margin-bottom: 18px; }
.lp-wrapper #sec-guarantee .gr-card h3{ font-size: var(--fs-note); font-weight: 700; line-height: 1.6; color: var(--text-sub); margin-bottom: 8px; }
.lp-wrapper #sec-guarantee .gr-card p:not(.gr-stat):not(.gr-stat-sub){ font-size: var(--fs-note); line-height: 1.9; color: var(--text-sub); margin-bottom: 6px; }
.lp-wrapper #sec-guarantee .gr-chips{ display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
.lp-wrapper #sec-guarantee .gr-chips span{
  font-size: var(--fs-micro); font-weight: 700; color: var(--text-sub);
  background: var(--bg-gray);
  padding: 6px 12px; border-radius: var(--radius-pill);
}
.lp-wrapper #sec-guarantee .support-row{ display: flex; gap: 14px; margin-top: 14px; }
.lp-wrapper #sec-guarantee .support-row span{
  display: inline-flex; align-items: center; gap: 6px;
  font-size: var(--fs-note); font-weight: 700; color: var(--text);
}
.lp-wrapper #sec-guarantee .support-row svg{ width: 18px; height: 18px; color: var(--gold); }
.lp-wrapper #sec-guarantee .gr-close{
  max-width: 680px; margin: 0 auto; padding: 0 20px;
  font-size: var(--fs-lead); font-weight: 700; line-height: 2.0; color: var(--text);
}
@media (max-width: 768px) {
  .lp-wrapper #sec-guarantee .gr-cards{ grid-template-columns: 1fr; }
  .lp-wrapper #sec-guarantee .gr-card{ padding: 26px 20px; }
}

/* ================== 商流2切替_朝フォトオーバーレイ型.html ================== */
