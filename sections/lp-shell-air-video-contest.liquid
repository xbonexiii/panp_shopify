<style>

:root {
  --blue: #0071e3; --blue-dark: #0060c0;
  --gold: #F59E0B; --gold-light: #FCD34D;
  --coral: #FF6B35; --sky: #0ea5e9;
  --text: #1d1d1f; --text-sub: #6e6e73;
  --bg: #ffffff; --bg-gray: #f5f5f7;
  --bg-warm: #fffbf0; --bg-sky: #f0f9ff;
  --air-green: #416923; --air-green-light: #5a8a30; --bg-mint: #f3f7ef;
}
.lp-wrapper *,  .lp-wrapper *::before,  .lp-wrapper *::after{ box-sizing: border-box; margin: 0; padding: 0; }
.lp-wrapper{ scroll-behavior: smooth; }
.lp-wrapper{ font-family: Helvetica, Arial, sans-serif; color: var(--text); font-size: 17px; line-height: 1.7; overflow-x: hidden; background: var(--bg); }
.lp-wrapper img{ max-width: 100%; height: auto; display: block; }
.lp-wrapper a{ color: inherit; text-decoration: none; }
.lp-wrapper section{ width: 100%; }

.lp-wrapper .container{ max-width: 1100px; margin: 0 auto; padding: 0 48px; }
.lp-wrapper .container-narrow{ max-width: 740px; margin: 0 auto; padding: 0 48px; }
.lp-wrapper .sec-pad{ padding: 100px 0; }
.lp-wrapper .label{ display: inline-block; font-size: 12px; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; color: var(--blue); margin-bottom: 12px; }
.lp-wrapper .sec-title{ font-size: clamp(28px,3.8vw,50px); font-weight: 800; line-height: 1.2; margin-bottom: 14px; }
.lp-wrapper .sec-sub{ font-size: 16px; color: var(--text-sub); line-height: 1.75; margin-bottom: 36px; }

/* アニメ */
.lp-wrapper .fade-in{ opacity: 0; transform: translateY(22px); transition: opacity .6s ease, transform .6s ease; }
.lp-wrapper .slide-up{ opacity: 0; transform: translateY(28px); transition: opacity .65s ease, transform .65s ease; }
.lp-wrapper .slide-left{ opacity: 0; transform: translateX(-40px); transition: opacity .7s ease, transform .7s ease; }
.lp-wrapper .slide-right{ opacity: 0; transform: translateX(40px);  transition: opacity .7s ease, transform .7s ease; }
.lp-wrapper .fade-in.visible, .lp-wrapper .slide-up.visible, .lp-wrapper .slide-left.visible, .lp-wrapper .slide-right.visible{ opacity:1; transform:none; }

/* ===== HERO ===== */
.lp-wrapper #sec-hero{ position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; color: #fff; overflow: hidden; }
.lp-wrapper .hero-bg{ position: absolute; inset: 0; z-index: 0; overflow: hidden; }
.lp-wrapper .hero-bg img{ position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
.lp-wrapper .hero-bg::after{ content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.80) 0%, rgba(0,20,60,.48) 55%, rgba(0,0,0,.1) 100%); }
.lp-wrapper .hero-inner{ position: relative; z-index: 1; max-width: 820px; margin: 0 auto; width: 100%; padding: 0 48px 80px; }
.lp-wrapper .hero-badge{ display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.28); backdrop-filter: blur(8px); border-radius: 100px; padding: 8px 20px; font-size: 13px; font-weight: 700; color: #fff; letter-spacing: .06em; margin-bottom: 24px; }
.lp-wrapper .hero-badge span{ color: var(--gold-light); }
.lp-wrapper #sec-hero h1{ font-size: clamp(40px,6.5vw,80px); font-weight: 900; line-height: 1.08; letter-spacing: -.03em; margin-bottom: 22px; color: #fff; }
.lp-wrapper .hero-sub{ font-size: 19px; color: rgba(255,255,255,.88); line-height: 1.65; margin-bottom: 28px; max-width: 560px; }
.lp-wrapper .hero-timer{ display: flex; align-items: center; gap: 8px; font-size: 15px; color: rgba(255,255,255,.7); margin-bottom: 36px; }
.lp-wrapper .timer-val{ font-weight: 800; color: #fff; font-variant-numeric: tabular-nums; font-size: 17px; }
.lp-wrapper .hero-buttons{ display: flex; gap: 14px; flex-wrap: wrap; }
.lp-wrapper .btn-primary{ display: inline-flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--blue) 0%, var(--sky) 100%); color: #fff; font-size: 18px; font-weight: 800; padding: 18px 48px; border-radius: 100px; min-height: 58px; letter-spacing: .02em; transition: opacity .2s, transform .15s; box-shadow: 0 8px 28px rgba(0,113,227,.45); }
.lp-wrapper .btn-primary:hover{ opacity: .9; transform: translateY(-2px); }
.lp-wrapper .btn-outline{ display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,.12); border: 1.5px solid rgba(255,255,255,.5); backdrop-filter: blur(6px); color: #fff; font-size: 17px; font-weight: 700; padding: 18px 36px; border-radius: 100px; min-height: 58px; letter-spacing: .01em; transition: background .2s, transform .15s; }
.lp-wrapper .btn-outline:hover{ background: rgba(255,255,255,.22); transform: translateY(-2px); }
.lp-wrapper .hero-note{ font-size: 12px; color: rgba(255,255,255,.42); margin-top: 18px; }
.lp-wrapper .hero-stats{ display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 32px; }
.lp-wrapper .hero-stat{ display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,.13); border: 1px solid rgba(255,255,255,.22); backdrop-filter: blur(8px); border-radius: 12px; padding: 12px 18px; color: #fff; font-size: 14px; font-weight: 600; line-height: 1.4; }
.lp-wrapper .hero-stat .stat-emoji{ font-size: 18px; flex-shrink: 0; }
@media (max-width: 768px) { .hero-stats { flex-direction: column; } .hero-stat { font-size: 13px; padding: 10px 14px; } }
.lp-wrapper .scroll-hint{ position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 5px; color: rgba(255,255,255,.42); font-size: 10px; letter-spacing: .15em; text-transform: uppercase; animation: bounce 2.2s infinite; z-index: 1; }
.lp-wrapper .scroll-hint svg{ width: 18px; height: 18px; }
@keyframes bounce { 0%,100%{ transform: translateX(-50%) translateY(0); opacity:.42; } 50%{ transform: translateX(-50%) translateY(8px); opacity:.85; } }

/* ===== OVERVIEW (2-col) ===== */
.lp-wrapper #sec-overview{ background: var(--bg-sky); overflow: hidden; }
.lp-wrapper .overview-inner{ display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
.lp-wrapper .overview-image-wrap{ position: relative; }
.lp-wrapper .overview-image-wrap img{ width: 100%; height: 500px; object-fit: cover; border-radius: 24px; box-shadow: 0 28px 72px rgba(0,0,0,.14); }
.lp-wrapper .ov-ok-banner{ display: flex; align-items: center; gap: 12px; margin-top: 14px; background: #fff; border: 2px solid var(--blue); border-radius: 14px; padding: 14px 20px; }
.lp-wrapper .ov-ok-icon{ font-size: 22px; flex-shrink: 0; }
.lp-wrapper .ov-ok-text{ font-size: 16px; font-weight: 800; color: var(--blue); white-space: nowrap; }
.lp-wrapper .ov-ok-sub{ font-size: 13px; color: var(--text-sub); }
.lp-wrapper .overview-image-badge{ position: absolute; bottom: 20px; left: 20px; background: rgba(0,0,0,.72); backdrop-filter: blur(12px); color: #fff; border-radius: 14px; padding: 12px 18px; font-size: 13px; font-weight: 700; }
.lp-wrapper .overview-image-badge strong{ display: block; font-size: 22px; font-weight: 900; color: var(--gold-light); }
.lp-wrapper .overview-grid{ display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 0; }
.lp-wrapper .overview-card{ background: #fff; border-radius: 16px; padding: 22px 14px; text-align: center; box-shadow: 0 2px 12px rgba(0,0,0,.07); }
.lp-wrapper .overview-card .ov-icon{ font-size: 28px; margin-bottom: 8px; }
.lp-wrapper .overview-card .ov-label{ font-size: 10px; font-weight: 700; color: var(--text-sub); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 4px; }
.lp-wrapper .overview-card .ov-val{ font-size: 14px; font-weight: 800; color: var(--text); line-height: 1.3; }
/* 投稿期間 強調カード */
.lp-wrapper .overview-period{
  grid-column: 1 / -1;
  background: linear-gradient(135deg, var(--blue) 0%, #0ea5e9 100%);
  border-radius: 18px; padding: 22px 28px;
  display: flex; align-items: center; gap: 20px;
  box-shadow: 0 8px 28px rgba(0,113,227,.28);
}
.lp-wrapper .overview-period .ov-period-icon{ font-size: 36px; flex-shrink: 0; }
.lp-wrapper .overview-period .ov-period-body{ flex: 1; }
.lp-wrapper .overview-period .ov-period-label{
  font-size: 11px; font-weight: 700; color: rgba(255,255,255,.72);
  letter-spacing: .1em; text-transform: uppercase; margin-bottom: 4px;
}
.lp-wrapper .overview-period .ov-period-date{
  font-size: 26px; font-weight: 900; color: #fff; line-height: 1.2; letter-spacing: -.01em;
}
.lp-wrapper .overview-period .ov-period-sub{
  font-size: 12px; color: rgba(255,255,255,.7); margin-top: 4px; font-weight: 500;
}
@media (max-width: 480px) {
  .lp-wrapper .overview-period .ov-period-date{ font-size: 20px; }
}

/* ===== PRIZES (3-col podium) ===== */
.lp-wrapper #sec-prizes{ background: linear-gradient(160deg, #fffbf0 0%, #fff4d6 60%, #fff0e0 100%); position: relative; overflow: hidden; }
.lp-wrapper .confetti-wrap{ position: absolute; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
.lp-wrapper .cf{ position: absolute; border-radius: 2px; animation: cf-float linear infinite; opacity: .55; }
@keyframes cf-float { 0%{ transform: translateY(-20px) rotate(0deg); opacity:.7; } 100%{ transform: translateY(110%) rotate(720deg); opacity:0; } }
.lp-wrapper #sec-prizes .container{ position: relative; z-index: 1; }
.lp-wrapper #sec-prizes .label{ color: var(--coral); }
.lp-wrapper .prizes-head{ text-align: center; margin-bottom: 40px; }

/* Amazonギフトカードバナー */
.lp-wrapper .gc-banner{ background: #1d1d1f; border: 2px solid rgba(255,153,0,.35); border-radius: 24px; padding: 40px 48px; margin-bottom: 40px; position: relative; overflow: hidden; display: flex; align-items: center; gap: 40px; }
.lp-wrapper .gc-banner::before{ content: ''; position: absolute; top: -80px; right: -60px; width: 320px; height: 320px; background: radial-gradient(circle, rgba(255,153,0,.2) 0%, transparent 70%); pointer-events: none; }
.lp-wrapper .gc-banner::after{ content: ''; position: absolute; bottom: -60px; left: -40px; width: 200px; height: 200px; background: radial-gradient(circle, rgba(255,153,0,.1) 0%, transparent 70%); pointer-events: none; }
.lp-wrapper .gc-icon{ font-size: 64px; flex-shrink: 0; position: relative; z-index: 1; line-height: 1; }
.lp-wrapper .gc-main{ flex: 1; position: relative; z-index: 1; }
.lp-wrapper .gc-eyebrow{ font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.4); margin-bottom: 10px; }
.lp-wrapper .gc-title{ font-size: clamp(26px,3.6vw,46px); font-weight: 900; line-height: 1.15; color: #fff; }
.lp-wrapper .gc-amazon{ color: #FF9900; }
.lp-wrapper .gc-present{ color: #fff; }
.lp-wrapper .gc-winners{ position: relative; z-index: 1; text-align: center; flex-shrink: 0; padding-left: 40px; border-left: 1px solid rgba(255,255,255,.12); }
.lp-wrapper .gc-winners-num{ font-size: clamp(48px,6vw,72px); font-weight: 900; color: #FF9900; line-height: 1; letter-spacing: -.03em; }
.lp-wrapper .gc-winners-label{ font-size: 14px; color: rgba(255,255,255,.5); margin-top: 6px; font-weight: 600; }

/* 3カラム台座 */
.lp-wrapper .podium-wrap{ display: grid; grid-template-columns: 1fr 1.22fr 1fr; gap: 16px; align-items: end; }

/* 大賞 (center) */
.lp-wrapper .prize-1st{ background: #fff; border: 2px solid var(--gold); border-radius: 24px; overflow: hidden; box-shadow: 0 12px 48px rgba(245,158,11,.22); position: relative; }
.lp-wrapper .prize-1st-top{ background: linear-gradient(160deg, #fef3c7 0%, #fde68a 100%); padding: 36px 28px 24px; text-align: center; position: relative; }
.lp-wrapper .prize-1st-top .rank-badge{ display: inline-flex; align-items: center; gap: 6px; background: var(--gold); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: .15em; border-radius: 100px; padding: 5px 14px; margin-bottom: 14px; }

.lp-wrapper .prize-1st-top .amount{ font-size: clamp(48px,6vw,68px); font-weight: 900; color: #92400e; line-height: 1; letter-spacing: -.03em; margin-bottom: 8px; }
.lp-wrapper .prize-1st-top .prize-title{ font-size: 22px; font-weight: 900; color: #78350f; }
.lp-wrapper .prize-1st-bottom{ padding: 18px 28px; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(245,158,11,.2); }
.lp-wrapper .prize-1st-bottom .pn{ font-size: 14px; font-weight: 700; }
.lp-wrapper .prize-1st-bottom .pm{ font-size: 13px; color: var(--text-sub); }
.lp-wrapper .sparkle{ position: absolute; font-size: var(--sz,14px); color: var(--gold-light); top: var(--y,10%); left: var(--x,10%); pointer-events: none; line-height: 1; animation: sp-twinkle var(--dur,2s) ease-in-out var(--dl,0s) infinite; }
@keyframes sp-twinkle { 0%,100%{ opacity:.5; transform:scale(1) rotate(0deg); } 50%{ opacity:1; transform:scale(1.4) rotate(20deg); } }

/* ===== 月桂冠リース ===== */
.lp-wrapper .prize-laurel-wrap{ display:flex; align-items:center; justify-content:center; gap:2px; margin-bottom:8px; }
.lp-wrapper .laurel-svg{ flex-shrink:0; }
.lp-wrapper .prize-1st .laurel-svg{ animation: laurel-gold 2.8s ease-in-out infinite; }
.lp-wrapper .prize-side.silver .laurel-svg{ animation: laurel-silver 3s ease-in-out infinite; }
.lp-wrapper .prize-side.bronze .laurel-svg{ animation: laurel-bronze 3.2s ease-in-out infinite; }
@keyframes laurel-gold {
  0%,100% { filter: drop-shadow(0 0 6px rgba(199,158,16,.6)) brightness(1); }
  50%      { filter: drop-shadow(0 0 22px rgba(255,220,60,.98)) brightness(1.2); }
}
@keyframes laurel-silver {
  0%,100% { filter: drop-shadow(0 0 5px rgba(100,116,139,.5)) brightness(1); }
  50%      { filter: drop-shadow(0 0 14px rgba(186,202,216,.9)) brightness(1.15); }
}
@keyframes laurel-bronze {
  0%,100% { filter: drop-shadow(0 0 5px rgba(161,105,40,.5)) brightness(1); }
  50%      { filter: drop-shadow(0 0 14px rgba(220,150,50,.85)) brightness(1.12); }
}
.lp-wrapper .prize-laurel-center{ text-align:center; line-height:1.15; padding:0 4px; font-weight:900; letter-spacing:.04em; font-family:'Hiragino Mincho ProN','Yu Mincho','YuMincho','Noto Serif JP',Georgia,serif; }

/* サイドカード */
.lp-wrapper .prize-side{ background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,.08); }
.lp-wrapper .prize-side-top{ padding: 28px 20px 20px; text-align: center; }
.lp-wrapper .prize-side-top .medal{ font-size: 36px; line-height:1; }
.lp-wrapper .prize-side-top .rank-label{ font-size: 10px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; margin-bottom: 10px; }
.lp-wrapper .prize-side-top .amount{ font-size: clamp(30px,3.5vw,44px); font-weight: 900; line-height: 1.1; }
.lp-wrapper .prize-side-top .prize-title{ font-size: 15px; font-weight: 800; margin-top: 6px; }
.lp-wrapper .prize-side.silver .prize-side-top{ background: linear-gradient(145deg, #f8fafc 0%, #e9f0f8 100%); }
.lp-wrapper .prize-side.silver .rank-label{ color: #64748b; }
.lp-wrapper .prize-side.silver .amount{ color: #334155; }
.lp-wrapper .prize-side.bronze .prize-side-top{ background: linear-gradient(145deg, #fffbf5 0%, #fef3e2 100%); }
.lp-wrapper .prize-side.bronze .rank-label{ color: #a16207; }
.lp-wrapper .prize-side.bronze .amount{ color: #92400e; }
.lp-wrapper .prize-side-bottom{ padding: 14px 20px; border-top: 1px solid rgba(0,0,0,.06); font-size: 13px; color: var(--text-sub); text-align: center; }

/* 台座レイアウト: 画面では 優秀賞|大賞|入賞 */
.lp-wrapper .prize-1st{ order: 1; }
.lp-wrapper .prize-side.silver{ order: 0; }
.lp-wrapper .prize-side.bronze{ order: 2; }

/* ===== STEPS (2-col) ===== */
/* ===== AIR FEATURES ===== */
.lp-wrapper #sec-features{ background: var(--bg-gray); }
.lp-wrapper .title{ font-size: clamp(28px,3.8vw,50px); font-weight: 800; line-height: 1.2; margin-bottom: 14px; }
.lp-wrapper .howto-grid{ display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-bottom: 40px; }
.lp-wrapper .howto-card{ background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 2px 16px rgba(0,0,0,.06); transition: transform .2s, box-shadow .2s; }
.lp-wrapper .howto-card:hover{ transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,.1); }
.lp-wrapper .howto-img{ width: 100%; height: 200px; object-fit: cover; display: block; }
.lp-wrapper .howto-card-body{ padding: 20px 20px 24px; }
.lp-wrapper .howto-num{ width: 32px; height: 32px; background: linear-gradient(135deg, var(--blue), var(--sky)); color: #fff; border-radius: 50%; font-size: 16px; font-weight: 900; display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }
.lp-wrapper .howto-title{ font-size: 16px; font-weight: 700; margin-bottom: 6px; color: var(--text); }
.lp-wrapper .howto-body{ font-size: 13px; color: var(--text-sub); line-height: 1.7; margin: 0; }
.lp-wrapper .deflate-card{ background: #fff; border-radius: 20px; overflow: hidden; display: grid; grid-template-columns: 1fr 1fr; box-shadow: 0 2px 20px rgba(0,0,0,.08); margin-bottom: 48px; }
.lp-wrapper .deflate-video-wrap{ overflow: hidden; }
.lp-wrapper .deflate-video-wrap video{ width: 100%; height: 100%; object-fit: cover; display: block; min-height: 280px; }
.lp-wrapper .deflate-body-wrap{ padding: 36px 32px; display: flex; flex-direction: column; justify-content: center; }
.lp-wrapper .deflate-label{ display: inline-block; background: rgba(0,113,227,.1); color: var(--blue); font-size: 12px; font-weight: 700; letter-spacing: .06em; padding: 5px 12px; border-radius: 100px; margin-bottom: 16px; }
.lp-wrapper .deflate-title{ font-size: 26px; font-weight: 900; line-height: 1.4; margin-bottom: 12px; color: var(--text); }
.lp-wrapper .deflate-desc{ font-size: 14px; color: var(--text-sub); line-height: 1.7; }
.lp-wrapper .air-features-grid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 48px; }
.lp-wrapper .air-feat-card{ background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 2px 16px rgba(0,0,0,.06); transition: transform .2s, box-shadow .2s; }
.lp-wrapper .air-feat-card:hover{ transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,.1); }
.lp-wrapper .air-feat-img{ width: 100%; height: 200px; object-fit: cover; display: block; }
.lp-wrapper .air-feat-body{ padding: 22px 20px 24px; }
.lp-wrapper .air-feat-icon{ width: 40px; height: 40px; background: rgba(0,113,227,.08); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }
.lp-wrapper .air-feat-icon svg{ width: 20px; height: 20px; stroke: var(--blue); }
.lp-wrapper .air-feat-stat{ font-size: 26px; font-weight: 900; color: var(--blue); line-height: 1; margin-bottom: 4px; letter-spacing: -.02em; }
.lp-wrapper .air-feat-label{ font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 8px; }
.lp-wrapper .air-feat-desc{ font-size: 13px; color: var(--text-sub); line-height: 1.6; }
/* 未所持の方への製品誘導（sec-features 末尾） */
.lp-wrapper .air-buy-cta{ margin-top: 56px; background: #fff; border: 1px solid rgba(65,105,35,.15); border-radius: 24px; padding: 40px; text-align: center; }
.lp-wrapper .air-buy-cta .abc-eyebrow{ display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: .12em; color: var(--text-sub); background: rgba(0,0,0,.05); border-radius: 100px; padding: 6px 16px; margin-bottom: 16px; }
.lp-wrapper .air-buy-cta .abc-title{ font-size: clamp(22px,3vw,32px); font-weight: 900; line-height: 1.3; color: var(--text); margin-bottom: 12px; }
.lp-wrapper .air-buy-cta .abc-title .abc-accent{ color: var(--air-green); }
.lp-wrapper .air-buy-cta .abc-sub{ font-size: 15px; color: var(--text-sub); line-height: 1.8; max-width: 540px; margin: 0 auto 28px; }
.lp-wrapper .btn-gold{ display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: linear-gradient(135deg, var(--air-green) 0%, var(--air-green-light) 100%); color: #fff; font-size: 18px; font-weight: 800; padding: 18px 48px; border-radius: 100px; min-height: 58px; letter-spacing: .02em; transition: opacity .2s, transform .15s; box-shadow: 0 8px 26px rgba(65,105,35,.35); }
.lp-wrapper .btn-gold:hover{ opacity: .92; transform: translateY(-2px); }
.lp-wrapper .air-buy-cta .abc-note{ font-size: 13px; color: var(--text-sub); margin-top: 16px; }
@media (max-width: 768px) {
  .lp-wrapper .air-buy-cta{ margin-top: 40px; padding: 36px 22px; border-radius: 20px; }
  .lp-wrapper .btn-gold{ width: 100%; padding: 18px 28px; }
}
@media (max-width: 768px) {
  .lp-wrapper .howto-grid{ grid-template-columns: 1fr; gap: 14px; }
  .lp-wrapper .howto-img{ height: 180px; }
  .lp-wrapper .deflate-card{ grid-template-columns: 1fr; }
  .lp-wrapper .deflate-video-wrap video{ min-height: 220px; }
  .lp-wrapper .deflate-body-wrap{ padding: 24px 20px; }
  .lp-wrapper .deflate-title{ font-size: 22px; }
  .lp-wrapper .air-features-grid{ grid-template-columns: repeat(2, 1fr); gap: 14px; margin-top: 32px; }
  .lp-wrapper .air-feat-img{ height: 160px; }
  .lp-wrapper .air-feat-stat{ font-size: 22px; }
}
@media (max-width: 480px) {
  .lp-wrapper .air-features-grid{ grid-template-columns: 1fr; }
}
.lp-wrapper #sec-steps{ background: #fff; }
.lp-wrapper .steps-inner{ display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
