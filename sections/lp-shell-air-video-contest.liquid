<script>
const GAS_URL = 'https://script.google.com/macros/s/AKfycby9-TZQr5l8jlqaq_Z5t4xbPADDjsus8hmkIkCezptNKgN_a8PqlpKtbfp6xoTPQwJM/exec';

/* カウントダウン */
(function(){
  var start = new Date('2026-06-10T00:00:00+09:00').getTime();
  var end   = new Date('2026-07-31T23:59:59+09:00').getTime();
  var el = document.getElementById('countdown-text');
  function upd(){
    var now = Date.now();
    if(now < start){
      /* 開始前: 投稿開始までカウントダウン */
      var diff = start - now;
      var d=Math.floor(diff/86400000), h=Math.floor((diff%86400000)/3600000),
          m=Math.floor((diff%3600000)/60000), s=Math.floor((diff%60000)/1000);
      el.innerHTML='投稿開始まで あと <span class="timer-val">'+d+'日 '+h+'時間 '+m+'分 '+s+'秒</span>';
    } else if(now <= end){
      /* 受付中 */
      var diff2 = end - now;
      var d=Math.floor(diff2/86400000), h=Math.floor((diff2%86400000)/3600000),
          m=Math.floor((diff2%3600000)/60000), s=Math.floor((diff2%60000)/1000);
      el.innerHTML='🎉 受付中！締切まで <span class="timer-val">'+d+'日 '+h+'時間 '+m+'分 '+s+'秒</span>';
    } else {
      /* 終了 */
      el.textContent='受付終了';
    }
  }
  upd(); setInterval(upd,1000);
})();

/* FAQ */
document.querySelectorAll('.faq-q').forEach(function(q){
  q.addEventListener('click',function(){
    var item=q.closest('.faq-item'), open=item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(function(i){i.classList.remove('open');});
    if(!open) item.classList.add('open');
  });
});


/* アニメーション */
(function(){
  var els=document.querySelectorAll('.fade-in,.slide-up,.slide-left,.slide-right');
  if(!('IntersectionObserver' in window)){els.forEach(function(el){el.classList.add('visible');});return;}
  var obs=new IntersectionObserver(function(entries){
    entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target);}});
  },{threshold:0.1});
  els.forEach(function(el){obs.observe(el);});
})();

/* スティッキーCTA */
(function(){
  var el=document.getElementById('sticky-cta'); if(!el) return;
  var shown=false, trigger=document.getElementById('sec-prizes'), final=document.getElementById('sec-cta-final');
  if(trigger&&'IntersectionObserver' in window){
    new IntersectionObserver(function(entries){entries.forEach(function(e){
      if(!e.isIntersecting&&!shown&&window.scrollY>trigger.offsetTop){el.style.display='block';shown=true;}
    });},{threshold:0}).observe(trigger);
  }
  if(final&&'IntersectionObserver' in window){
    new IntersectionObserver(function(entries){entries.forEach(function(e){
      el.style.display=e.isIntersecting?'none':(shown?'block':'none');
    });},{threshold:0.1}).observe(final);
  }
})();

/* ===== Firebase Storage アップロード ===== */
var FIREBASE_BUCKET  = 'panp-air-contest.firebasestorage.app';
var FIREBASE_API_KEY = 'AIzaSyBqJOJgVw_5s3N0Eyd_67nE0UEu8SFFIgY';
var uploadedVideoUrl = '';
var uploadState = 'idle'; /* idle | uploading | done */

function resetUpload() {
  uploadState = 'idle'; uploadedVideoUrl = '';
  document.getElementById('upload-idle').style.display = '';
  document.getElementById('upload-progress').style.display = 'none';
  document.getElementById('upload-done').style.display = 'none';
  document.getElementById('upload-error').style.display = 'none';
  document.getElementById('field-video-file').value = '';
}

document.getElementById('field-video-file').addEventListener('change', function(e) {
  var file = e.target.files[0]; if (!file) return;
  if (file.size > 2 * 1024 * 1024 * 1024) {
    document.getElementById('upload-error').textContent = 'ファイルサイズが2GBを超えています。2GB以下の動画を選択してください。';
    document.getElementById('upload-error').style.display = '';
    e.target.value = '';
    return;
  }
  uploadState = 'uploading';
  document.getElementById('upload-filename').textContent = file.name;
  document.getElementById('upload-idle').style.display = 'none';
  document.getElementById('upload-progress').style.display = '';
  document.getElementById('upload-error').style.display = 'none';
  document.getElementById('progress-bar').style.width = '0%';
  document.getElementById('upload-percent').textContent = '0%';

  var safeName   = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
  var filePath   = 'videos/' + Date.now() + '_' + safeName;
  var encoded    = encodeURIComponent(filePath);
  var uploadUrl  = 'https://firebasestorage.googleapis.com/v0/b/' + FIREBASE_BUCKET
                 + '/o?uploadType=media&name=' + encoded + '&key=' + FIREBASE_API_KEY;

  var xhr = new XMLHttpRequest();
  xhr.upload.addEventListener('progress', function(ev) {
    if (!ev.lengthComputable) return;
    var pct = Math.round(ev.loaded / ev.total * 100);
    document.getElementById('progress-bar').style.width = pct + '%';
    document.getElementById('upload-percent').textContent = pct + '%';
  });
  xhr.addEventListener('load', function() {
    if (xhr.status === 200) {
      uploadState = 'done';
      uploadedVideoUrl = 'https://firebasestorage.googleapis.com/v0/b/' + FIREBASE_BUCKET
                       + '/o/' + encoded + '?alt=media';
      document.getElementById('upload-progress').style.display = 'none';
      document.getElementById('upload-done').style.display = '';
    } else {
      uploadState = 'idle';
      document.getElementById('upload-progress').style.display = 'none';
      document.getElementById('upload-idle').style.display = '';
      document.getElementById('upload-error').textContent = 'アップロードに失敗しました（' + xhr.status + '）。もう一度お試しください。';
      document.getElementById('upload-error').style.display = '';
    }
  });
  xhr.addEventListener('error', function() {
    uploadState = 'idle';
    document.getElementById('upload-progress').style.display = 'none';
    document.getElementById('upload-idle').style.display = '';
    document.getElementById('upload-error').textContent = 'ネットワークエラーが発生しました。接続を確認してください。';
    document.getElementById('upload-error').style.display = '';
  });
  xhr.open('POST', uploadUrl);
  xhr.setRequestHeader('Content-Type', file.type || 'application/octet-stream');
  xhr.send(file);
});

/* フォーム送信 */
document.getElementById('contest-form').addEventListener('submit',function(e){
  e.preventDefault();
  var btn=document.getElementById('submit-btn'), errEl=document.getElementById('form-error');
  errEl.style.display='none';
  var pl=document.querySelector('input[name="platform"]:checked');
  var sn=document.querySelector('input[name="sns"]:checked');
  if(!pl){errEl.textContent='購入プラットフォームを選択してください。';errEl.style.display='block';return;}
  if(!sn){errEl.textContent='投稿SNSを選択してください。';errEl.style.display='block';return;}
  /* 動画ファイルは任意（アップロード途中の場合のみ完了を待つ） */
  if(uploadState==='uploading'){errEl.textContent='動画ファイルのアップロード中です。完了までお待ちください。';errEl.style.display='block';return;}
  if(!document.getElementById('field-tagcheck').checked){errEl.textContent='#PANPの夏 と公式アカウントへのメンションを付けて投稿したことをご確認ください。';errEl.style.display='block';return;}
  if(!document.getElementById('field-agree').checked){errEl.textContent='応募規約への同意が必要です。';errEl.style.display='block';return;}
  btn.disabled=true; btn.textContent='送信中...';
  fetch(GAS_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=UTF-8'},
    body:JSON.stringify({
      timestamp:new Date().toLocaleString('ja-JP',{timeZone:'Asia/Tokyo'}),
      name:document.getElementById('field-name').value,
      email:document.getElementById('field-email').value,
      platform:pl.value, sns:sn.value,
      videoUrl:document.getElementById('field-videoUrl').value,
      videoFileUrl:uploadedVideoUrl,
      message:document.getElementById('field-message').value
    })
  }).then(function(){
    document.getElementById('contest-form').style.display='none';
    document.getElementById('form-success').style.display='block';
    window.scrollTo({top:document.getElementById('sec-form').offsetTop-40,behavior:'smooth'});
  }).catch(function(){
    errEl.textContent='送信に失敗しました。しばらくしてから再度お試しください。';
    errEl.style.display='block'; btn.disabled=false; btn.textContent='今すぐ応募する →';
  });
});
</script>
<script>
/* ===== 動画コントロール ===== */
(function(){
  var vid    = document.getElementById('promo-video');
  var flash  = document.getElementById('vid-flash');
  var flashIcon = document.getElementById('vid-flash-icon');
  var muteBtn   = document.getElementById('vid-mute-btn');
  var iconMuted = document.getElementById('icon-muted');
  var iconSound = document.getElementById('icon-sound');
  var barFill   = document.getElementById('vid-bar-fill');
  if(!vid) return;

  /* 再生バー更新 */
  vid.addEventListener('timeupdate', function(){
    if(!vid.duration) return;
    barFill.style.width = (vid.currentTime / vid.duration * 100).toFixed(2) + '%';
  });

  /* 動画クリック → 再生/一時停止 */
  var flashTimer;
  document.getElementById('vid-container').addEventListener('click', function(e){
    if(e.target.closest('.vid-mute')) return; /* ミュートボタンは除外 */
    if(vid.paused){ vid.play(); } else { vid.pause(); }
    /* フラッシュ表示 */
    flashIcon.innerHTML = vid.paused
      ? '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>'
      : '<polygon points="5 3 19 12 5 21 5 3"/>';
    flash.classList.add('show');
    clearTimeout(flashTimer);
    flashTimer = setTimeout(function(){ flash.classList.remove('show'); }, 900);
  });

  /* ミュート切替 */
  muteBtn.addEventListener('click', function(e){
    e.stopPropagation();
    vid.muted = !vid.muted;
    iconMuted.style.display = vid.muted ? '' : 'none';
    iconSound.style.display = vid.muted ? 'none' : '';
  });
})();

