/* ===== VIDEO ===== */
.lp-wrapper #sec-video{ background: #0a0a0a; color: #fff; }
.lp-wrapper #sec-video .label{ color: rgba(255,255,255,.4); }
.lp-wrapper #sec-video .sec-sub{ color: rgba(255,255,255,.6); }
.lp-wrapper .video-wrap{ position: relative; border-radius: 20px; overflow: hidden; background: #000; max-width: 480px; margin: 0 auto; cursor: pointer; }
.lp-wrapper .video-wrap video{ width: 100%; height: auto; display: block; }
/* 再生/一時停止 フラッシュ */
.lp-wrapper .vid-flash{
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(.7);
  width: 72px; height: 72px; border-radius: 50%;
  background: rgba(255,255,255,.82); backdrop-filter: blur(6px);
  display: flex; align-items: center; justify-content: center;
  pointer-events: none; opacity: 0;
  transition: opacity .25s, transform .25s;
}
.lp-wrapper .vid-flash.show{ opacity: 1; transform: translate(-50%, -50%) scale(1); }
.lp-wrapper .vid-flash svg{ width: 30px; height: 30px; color: #0a0a0a; }
/* ミュート切替ボタン */
.lp-wrapper .vid-mute{
  position: absolute; bottom: 14px; right: 14px; z-index: 4;
  width: 38px; height: 38px; border-radius: 50%;
  background: rgba(0,0,0,.55); backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.18);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; color: #fff;
  transition: background .18s, transform .15s;
}
.lp-wrapper .vid-mute:hover{ background: rgba(0,0,0,.80); transform: scale(1.08); }
.lp-wrapper .vid-mute svg{ width: 18px; height: 18px; }
/* 再生バー */
.lp-wrapper .vid-bar{ position: absolute; bottom: 0; left: 0; right: 0; height: 3px; background: rgba(255,255,255,.18); }
.lp-wrapper .vid-bar-fill{ height: 100%; background: var(--blue); width: 0%; transition: width .25s linear; }
/* 動画3本 横一列（プロモ+UGC2本） */
.lp-wrapper .vid-row{ display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 16px; max-width: 920px; margin: 0 auto; }
.lp-wrapper .vid-row .video-wrap{ max-width: none; aspect-ratio: 9/16; }
.lp-wrapper .vid-row .video-wrap video{ height: 100%; object-fit: cover; }
.lp-wrapper .ugc-card{ position: relative; border-radius: 16px; overflow: hidden; background: #000; cursor: pointer; aspect-ratio: 9/16; }
.lp-wrapper .ugc-card video{ width: 100%; height: 100%; object-fit: cover; display: block; }
.lp-wrapper .ugc-card .vid-flash{ width: 56px; height: 56px; }
.lp-wrapper .ugc-card .vid-flash svg{ width: 24px; height: 24px; }
