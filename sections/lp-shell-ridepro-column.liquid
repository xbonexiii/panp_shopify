.lp-wrapper .viewer__control-item{ display: flex; flex-shrink: 0; width: fit-content; border-radius: 28px; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); background: rgb(232 232 237 / 0.72); box-shadow: inset 0 0 .5px 0 rgba(0,0,0,.11); transition: background-color 250ms linear; }
.lp-wrapper .viewer__control-item:hover:not(.is-expanded){ background: rgb(232 232 237 / 0.92); }
.lp-wrapper .viewer__control-trigger{ display: flex; align-items: center; background: none; border: none; cursor: pointer; color: var(--color-text); flex-shrink: 0; }
.lp-wrapper .viewer__control-label{ display: flex; align-items: center; white-space: nowrap; font-weight: 600; line-height: 1.235; letter-spacing: 0em; }
.lp-wrapper .viewer__plus-icon{ flex-shrink: 0; color: var(--color-text); }
.lp-wrapper .viewer__control-title{ font-weight: 600; line-height: 1.47; display: block; margin-bottom: 2px; color: var(--color-text); }
.lp-wrapper .viewer__control-body{ font-weight: 400; line-height: 1.55; color: var(--color-text); margin: 0; }
.lp-wrapper .viewer__control-content-mask{ overflow: hidden; }
.lp-wrapper .viewer__color-picker{ display: flex; padding: 0; }
.lp-wrapper .viewer__color-swatch{ cursor: pointer; display: flex; align-items: center; justify-content: center; }
.lp-wrapper .viewer__color-circle{ display: block; border-radius: 50%; border: 1px solid rgba(0,0,0,0.1); transition: box-shadow 200ms ease, transform 200ms ease; }
.lp-wrapper .viewer__color-swatch--active .viewer__color-circle{ box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--color-text, #1d1d1f); }
.lp-wrapper .viewer__close-btn{ display: none; }
.lp-wrapper .viewer__item-nav{ display: none; }

@media (prefers-reduced-motion: reduce) {
  .viewer__media-item, .viewer__media-item.is-active, .viewer__media-item.is-leaving,
  .viewer__control-trigger, .viewer__control-content, .viewer__control-content-inner,
  .lp-wrapper .viewer__control-item,  .lp-wrapper .viewer__heading{ transition-duration: 0ms !important; transition-delay: 0ms !important; }
}

/* ══════════════════════════════════════════════════
   PC版 (≥735px)
   カード内: 画像=absolute全面、コントロール=absolute左側
   ══════════════════════════════════════════════════ */
@media (min-width: 735px) {
  .lp-wrapper .viewer{ padding: var(--section-pad) 40px; }
  .lp-wrapper .viewer__heading{ font-size: 48px; font-weight: 600; line-height: 1.15; color: var(--color-text); margin-bottom: 40px; }
  .lp-wrapper .viewer__card{ height: 760px; max-width: 1440px; margin: 0 auto; border-radius: 28px; }
  .lp-wrapper .viewer__media{ position: absolute; inset: 0; z-index: 0; }
  .lp-wrapper .viewer__media-item img{ object-fit: cover; }
  .lp-wrapper .viewer__controls{ position: absolute; top: 0; left: 0; bottom: 0; z-index: 10; display: flex; align-items: center; padding-left: 6.25vw; }
  .lp-wrapper .viewer__control-list{ list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .lp-wrapper .viewer__control-item{ flex-direction: column; overflow: hidden; }

  /* StaggeredFadeIn（PC専用） */
  .lp-wrapper .viewer__control-item{ opacity: 0; transform: translateY(30px); }
  .lp-wrapper .viewer.is-visible .viewer__control-item{ opacity: 1; transform: translateY(0); transition: opacity 0.9s cubic-bezier(0.455, 0.03, 0.515, 0.955), transform 0.7s cubic-bezier(0.455, 0.03, 0.515, 0.955), background-color 250ms linear; }
  .lp-wrapper .viewer.is-visible .viewer__control-item:nth-child(1){ transition-delay: 0s, 0s, 0s; }
  .lp-wrapper .viewer.is-visible .viewer__control-item:nth-child(2){ transition-delay: 0.15s, 0.15s, 0s; }
  .lp-wrapper .viewer.is-visible .viewer__control-item:nth-child(3){ transition-delay: 0.3s, 0.3s, 0s; }
  .lp-wrapper .viewer.is-visible .viewer__control-item:nth-child(4){ transition-delay: 0.45s, 0.45s, 0s; }
  .lp-wrapper .viewer.is-visible .viewer__control-item:nth-child(5){ transition-delay: 0.6s, 0.6s, 0s; }
  .lp-wrapper .viewer.is-visible .viewer__control-item:nth-child(6){ transition-delay: 0.75s, 0.75s, 0s; }
  .lp-wrapper .viewer.is-visible .viewer__control-item:nth-child(7){ transition-delay: 0.9s, 0.9s, 0s; }
  .lp-wrapper .viewer.is-visible .viewer__control-item:nth-child(8){ transition-delay: 1.05s, 1.05s, 0s; }
  .lp-wrapper .viewer__heading{ opacity: 0; transform: translateY(30px); transition: opacity 0.9s cubic-bezier(0.455, 0.03, 0.515, 0.955), transform 0.7s cubic-bezier(0.455, 0.03, 0.515, 0.955); }
  .lp-wrapper .viewer.is-visible .viewer__heading{ opacity: 1; transform: translateY(0); }

  /* PC トリガー・展開 */
  .lp-wrapper .viewer__control-trigger{ height: 56px; padding: 0 32px 0 14px; transition: opacity 400ms ease-in-out 350ms; }
  .lp-wrapper .viewer__control-item.is-expanded .viewer__control-trigger{ opacity: 0; pointer-events: none; position: absolute; top: 0; left: 0; right: 0; transition: opacity 50ms ease-in-out 0ms; }
  .lp-wrapper .viewer__control-label{ font-size: 17px; }
  .lp-wrapper .viewer__plus-icon{ margin-right: 14px; }
  .lp-wrapper .viewer__control-content{ max-height: 0; overflow: hidden; transition: max-height 400ms var(--ease-apple); }
  .lp-wrapper .viewer__control-item.is-expanded .viewer__control-content{ max-height: 250px; }
  .lp-wrapper .viewer__control-content-inner{ max-width: 423px; padding: 28px; opacity: 0; transform: translateY(20px); transition: opacity 300ms ease-in-out 0ms, transform 400ms ease-in-out 0ms; }
  .lp-wrapper .viewer__control-item.is-expanded .viewer__control-content-inner{ opacity: 1; transform: translateY(0); transition: opacity 400ms ease-in-out 50ms, transform 400ms ease-in-out 100ms; }
  .lp-wrapper .viewer__control-title{ font-size: 17px; }
  .lp-wrapper .viewer__control-body{ font-size: 15px; }
  .lp-wrapper .viewer__color-picker{ gap: 16px; margin-top: 20px; }
  .lp-wrapper .viewer__color-circle{ width: 32px; height: 32px; }
}

/* PC タブレット (735px〜1068px) */
@media (min-width: 735px) and (max-width: 1068px) {
  .lp-wrapper .viewer{ padding: var(--section-pad) 24px; }
  .lp-wrapper .viewer__heading{ font-size: 36px; margin-bottom: 32px; }
  .lp-wrapper .viewer__card{ height: 720px; }
  .lp-wrapper .viewer__controls{ padding-left: 4vw; }
  .lp-wrapper .viewer__control-content-inner{ max-width: 340px; }
}

/* ═══════════════════════════════════════════════════════════
   モバイル版 プロダクトビューワー (≤734px)
   参照: Apple公式スクリーンショット 2026-04-01
   仕様: product-viewer-mobile-css.md
   ═══════════════════════════════════════════════════════════

   ■ レイヤー構造（通常状態）
     .viewer__card           position: relative  (コンテナ)
       .viewer__media        position: absolute   z:0  (背景: カード全面)
       .viewer__controls     position: absolute   z:10 (前面: 下部にpill)
       .viewer__close-btn    position: absolute   z:20 (非表示)
       .viewer__item-nav     position: absolute   z:15 (非表示)

   ■ レイヤー構造（展開状態）
     .viewer__card.has-expanded   position: relative (高さ auto)
       .viewer__media             position: relative (グレー角丸カード)
       .viewer__controls          position: relative (テキストカード)
       .viewer__close-btn         visibility: visible z:20 (右上)
       .viewer__item-nav          opacity: 1          z:15 (画像左右)
   ═══════════════════════════════════════════════════════════ */

@media (max-width: 734px) {

  /* StaggeredFadeInはPC専用(@media min-width:735px)に隔離済み。モバイルでは不要。 */

  .lp-wrapper .viewer{ padding: var(--section-pad) 0; }
  .lp-wrapper .viewer__heading{ font-size: 28px; font-weight: 600; line-height: 1.15; margin-bottom: 24px; padding: 0 16px; }

  /* ── カード（展開前後でサイズ固定） ── */
  .lp-wrapper .viewer__card{
    position: relative;
    height: 80vh;
    max-height: 680px;
    min-height: 480px;
    overflow: hidden;       /* テキスト展開もカード内に収める */
    border-radius: 0;
    background: #f5f5f7;
  }

  /* ── 画像: absolute で全面背景 ── */
  .lp-wrapper .viewer__media{
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .lp-wrapper .viewer__media-item{
    position: absolute;
    inset: 0;
  }
  .lp-wrapper .viewer__media-item img{
    width: 100%;
    height: 100%;
    object-fit: cover;      /* カード全面を埋める */
    padding: 0;
  }

  /* ── コントロール: 下部にオーバーレイ ── */
  .lp-wrapper .viewer__controls{
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    top: auto;
    z-index: 10;
    padding: 0;
    display: block;
  }

  .lp-wrapper .viewer__control-list{
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;         /* 1行横スクロール（Apple公式スクリーンショット準拠） */
    gap: 8px;
    padding: 0 16px 16px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .lp-wrapper .viewer__control-list::-webkit-scrollbar{ display: none; }

  .lp-wrapper .viewer__control-item{
    width: auto;
    flex-shrink: 0;
    min-height: 44px;
    border-radius: 28px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    background: rgb(232 232 237 / 0.72);
    box-shadow: inset 0 0 .5px 0 rgba(0,0,0,.11);
    overflow: hidden;
  }

  .lp-wrapper .viewer__control-item .viewer__control-content{
    max-height: 0;
    overflow: hidden;
    visibility: hidden;
    position: absolute;
    pointer-events: none;
  }

  .lp-wrapper .viewer__control-trigger{
    display: flex;
    align-items: center;
    height: 44px;
    padding: 0 20px 0 12px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    opacity: 1;
    pointer-events: auto;
    position: static;
  }
  .lp-wrapper .viewer__control-label{ font-size: 14px; font-weight: 600; line-height: 1.235; white-space: nowrap; }
  .lp-wrapper .viewer__plus-icon{ width: 20px; height: 20px; margin-right: 8px; flex-shrink: 0; }

  /* ── 閉じる: 通常時は非表示、展開時に右上フロストガラス丸ボタン ── */
  .lp-wrapper .viewer__close-btn{
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 20;
    width: 44px; height: 44px;
    border-radius: 50%; border: none;
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    background: rgb(232 232 237 / 0.72);
    box-shadow: inset 0 0 .5px 0 rgba(0,0,0,.11);
    color: var(--color-text);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    visibility: hidden;
    opacity: 0;
    transform: scale(0);
    transition: visibility 0ms linear 300ms, opacity 300ms ease-out, transform 300ms ease-out;
  }
  .lp-wrapper .viewer__close-btn svg{ width: 14px; height: 14px; }

  /* ── ナビ: 通常時は非表示 ── */
  .lp-wrapper .viewer__item-nav{
    position: absolute;
    bottom: 16px;
    left: 0;
    right: 0;
    z-index: 15;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .lp-wrapper .viewer__nav-btn{
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    background: none; border: none;
    cursor: pointer; color: var(--color-text);
    -webkit-tap-highlight-color: transparent;
    pointer-events: auto;
  }
  .lp-wrapper .viewer__nav-btn:disabled{ opacity: 0.3; cursor: default; }
  .lp-wrapper .viewer__nav-btn svg{ width: 20px; height: 20px; }

  /* ══════════════════════════════════════════════════
     展開状態（Apple公式スクリーンショット 2026-04-01 準拠）
     ─ 画像: 全幅フルブリード、上部60%を占める
     ─ テキストカード: 画像の下にフロストガラス
     ─ < > ナビ: テキストカード左右横に両方表示
     ─ × 閉じる: 右上フロストガラス丸ボタン
     ══════════════════════════════════════════════════ */

  /* 展開時もカードサイズは通常と同じ（固定） */
  .lp-wrapper .viewer__card.has-expanded{
    /* height, max-height, min-height は通常状態を継承 — 変更しない */
    overflow: hidden;       /* テキストもカード内に収める */
    background: #f5f5f7;
  }

  /* 画像: absolute維持 — カード全面の背景として残す */
  /* (通常状態と同じ position: absolute; inset: 0 をそのまま継承) */
  .lp-wrapper .viewer__card.has-expanded .viewer__media-item img{
    padding: 0;
    object-fit: cover;
  }

  /* コントロール: カード下部にオーバーレイ（画像の上に重なる） */
  .lp-wrapper .viewer__card.has-expanded .viewer__controls{
    position: absolute;
    bottom: 0;
    left: 44px;       /* ナビ矢印幅分の余白 */
    right: 44px;
    top: auto;
    padding: 0;
    z-index: 10;
  }

  .lp-wrapper .viewer__card.has-expanded .viewer__control-list{
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    gap: 0;
    padding: 0;
    overflow: visible;
  }

  .lp-wrapper .viewer__card.has-expanded .viewer__control-item:not(.is-expanded){
    display: none;
  }

  /* テキストカード */
  .lp-wrapper .viewer__card.has-expanded .viewer__control-item.is-expanded{
    width: 100%;
    margin: 5px;
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    background: rgb(232 232 237 / 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: inset 0 0 .5px 0 rgba(0,0,0,.11);
    overflow: visible;
  }

  .lp-wrapper .viewer__card.has-expanded .viewer__control-item.is-expanded .viewer__control-trigger{
    opacity: 0; pointer-events: none; height: 0; position: absolute; overflow: hidden;
  }

  .lp-wrapper .viewer__card.has-expanded .viewer__control-item.is-expanded .viewer__control-content{
    position: static;
    visibility: visible;
    max-height: none;
    overflow: visible;
    pointer-events: auto;
  }
  .lp-wrapper .viewer__card.has-expanded .viewer__control-item.is-expanded .viewer__control-content-mask{
    overflow: visible;
  }
  .lp-wrapper .viewer__card.has-expanded .viewer__control-item.is-expanded .viewer__control-content-inner{
    max-width: 100%;
    padding: 15px;
    font-size: 13px;
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: none;
  }

  .lp-wrapper .viewer__card.has-expanded .viewer__control-title{
    font-size: 13px; font-weight: 600; line-height: 1.47; display: inline;
  }
  .lp-wrapper .viewer__card.has-expanded .viewer__control-body{
    font-size: 13px; line-height: 1.47;
  }

  /* × 閉じる: 展開時に右上フロストガラス丸ボタン */
  .lp-wrapper .viewer__card.has-expanded .viewer__close-btn{
    visibility: visible;
    opacity: 1;
    transform: scale(1);
    transition: visibility 0ms linear 0ms, opacity 300ms var(--ease-spring), transform 300ms var(--ease-spring);
  }

  /* < > ナビ: テキストカードと同じ高さに左右配置 */
  .lp-wrapper .viewer__card.has-expanded .viewer__item-nav{
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    height: auto;
    opacity: 1;
    pointer-events: auto;
    z-index: 15;
  }

  /* カラーピッカー（モバイル） */
  .lp-wrapper .viewer__color-picker{ gap: 12px; margin-top: 16px; }
  .lp-wrapper .viewer__color-circle{ width: 28px; height: 28px; }
  .lp-wrapper .viewer__color-swatch--active .viewer__color-circle{
    box-shadow: 0 0 0 2px #fff, 0 0 0 3.5px var(--color-text, #1d1d1f);
  }
}

/* ─── 05: パフォーマンス ─────────────────────────────────────── */
