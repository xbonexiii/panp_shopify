/* ═══════════════════════════════════════════════════════════════
   セクション別レイアウト
   ═══════════════════════════════════════════════════════════════ */

/* ─── 01: ヒーロー ──────────────────────────────────────────── */
/* ─── 01: ヒーロー（Apple section-welcome 完全準拠）───── */
/* 構造: section.hero > .hero__marquee(テキスト中央) + .hero__asset(画像フルワイド) */
/* 全幅背景, 高さ100vh, 画像は中央寄せfit-content */
.lp-wrapper .hero{
  background: var(--color-bg-section);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: #000;
}

/* marquee: テキストブロック（中央揃え） */
.lp-wrapper .hero__marquee{
  text-align: center;
  width: 100%;
  padding: 66px 40px 27px;
  position: relative;
  z-index: 1;
}

/* eyebrow: Apple typography-marquee-eyebrow-base (ja)
   28px / 600 / 1.18 → 24px → 21px */
/* シリーズカラーライン（eyebrow上のアクセント） */
.lp-wrapper .hero__series-line{
  width: 40px; height: 3px;
  background: var(--color-ride-gold);
  border-radius: 2px;
  margin: 0 auto 12px;
}

.lp-wrapper .hero__eyebrow{
  font-size: 28px;
  font-weight: 600;
  line-height: 1.18;
  letter-spacing: 0.007em;
  color: var(--color-text);
}

/* headline: Apple typography-welcome-headline-elevated (ja)
   80px / 700 / 1.09 / 0em → 64px → 48px */
.lp-wrapper .hero__headline{
  font-size: 80px;
  font-weight: 700;
  line-height: 1.09;
  letter-spacing: 0em;
  color: var(--color-text);
  margin-top: -2px;
}

/* detail: ボタン + 価格 */
.lp-wrapper .hero__detail{
  margin-top: 13px;
}

.lp-wrapper .hero__btn{
  display: inline-block;
  min-height: 44px;
  padding: 11px 22px;
  font-size: 17px;
  font-weight: 400;
  line-height: 1.24;
  letter-spacing: -0.022em;
  color: #fff;
  background: var(--color-text);
  border-radius: var(--pill-radius);
  text-decoration: none;
  cursor: pointer;
  transition: background-color 100ms linear;
}
.lp-wrapper .hero__btn:hover{ background: rgba(29,29,31,0.72); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); text-decoration: none; }
.lp-wrapper .hero__btn:active{ background: #18181A; }

/* プライマリボタン（ブランドCTAカラー） */
.lp-wrapper .hero__btn--primary{
  background: var(--color-cta);
}
.lp-wrapper .hero__btn--primary:hover{ background: var(--color-cta-hover); backdrop-filter: none; }
.lp-wrapper .hero__btn--primary:active{ background: var(--color-cta-active); }

.lp-wrapper .hero__price{
  margin-top: 16px;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.29;
  letter-spacing: -0.016em;
  color: var(--color-text);
}

.lp-wrapper .hero__footnote-link{ display: inline-block; vertical-align: super; font-size: 9px; color: var(--color-text); margin-left: 1px; }
.lp-wrapper .hero__footnote-link:hover{ text-decoration: underline; }

/* asset-wrapper: 画像（fit-content中央寄せ・フルワイド） */
.lp-wrapper .hero__asset{
  position: relative;
  display: flex;
  justify-content: center;
  width: fit-content;
  margin-inline: auto;
}

.lp-wrapper .hero__img{
  display: block;
  width: 860px;
  height: auto;
  max-width: 100%;
}

/* ── Hero 初期表示アニメーション（Apple風） ── */
.lp-wrapper.js-active .hero__img{
  opacity: 0;
  transform: scale(0.92) translateY(20px);
  animation: heroReveal 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.3s forwards;
}

@keyframes heroReveal {
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.lp-wrapper.js-active .hero__marquee{
  opacity: 0;
  transform: translateY(12px);
  animation: heroTextReveal 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.1s forwards;
}

@keyframes heroTextReveal {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero__img,
  .lp-wrapper .hero__marquee{
    opacity: 1;
    transform: none;
    animation: none;
  }
}

/* ── Hero レスポンシブ ── */
@media (max-width: 1068px) {
  .lp-wrapper .hero__marquee{ padding: 49px 24px 26px; }
  .lp-wrapper .hero__eyebrow{ font-size: 24px; }
  .lp-wrapper .hero__headline{ font-size: 64px; margin-top: 6px; }
  .lp-wrapper .hero__detail{ margin-top: 15px; }
  .lp-wrapper .hero__img{ width: 1034px; }
}
@media (max-width: 734px) {
  .lp-wrapper .hero__marquee{ padding: 30px 16px 30px; }
  .lp-wrapper .hero__eyebrow{ font-size: 21px; }
  .lp-wrapper .hero__headline{ font-size: 48px; margin-top: 0; }
  .lp-wrapper .hero__detail{ margin-top: 12px; }
  .lp-wrapper .hero__btn{ font-size: 14px; padding: 9px 16px; min-height: 36px; }
  .lp-wrapper .hero__img{ width: 690px; }
  .lp-wrapper .hero__btn{ margin-top: 18px; font-size: 15px; padding: 8px 18px; }
  .lp-wrapper .hero__price{ font-size: 12px; }
}

/* ─── 02: ハイライトギャラリー ───────────────────────────────── */
/* ─── 02: ハイライトギャラリー（Apple section-highlights 完全準拠）── */
/* Apple実測: カードサイズ 1260x680(xl) → 934x628(m) → 400x480(s) */
/* padding: max(6.25vw, (100vw-maxW)/2) */
.lp-wrapper .highlights{ background: var(--color-bg); padding: 80px 0 48px; }
.lp-wrapper .highlights__heading{ font-size: 56px; font-weight: 700; line-height: 1.07; letter-spacing: -0.009em; color: var(--color-text); padding: 0 0 40px max(40px, calc((100vw - 1200px) / 2 + 40px)); }
.lp-wrapper .highlights__track-wrap{ overflow: hidden; }
.lp-wrapper .highlights__track{ display: flex; list-style: none; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding: 0 max(40px, calc((100vw - 1200px) / 2 + 40px)); scroll-padding-left: max(40px, calc((100vw - 1200px) / 2 + 40px)); }
.lp-wrapper .highlights__track::-webkit-scrollbar{ display: none; }
.lp-wrapper .highlights__slide{ position: relative; flex-shrink: 0; width: min(87.5vw, 1440px); min-height: 680px; border-radius: var(--tile-radius); overflow: hidden; scroll-snap-align: start; background: var(--color-text); scroll-snap-stop: always; }
.lp-wrapper .highlights__slide-img{ width: 100%; height: 100%; object-fit: cover; display: block; position: absolute; inset: 0; }
.lp-wrapper .highlights__slide-caption{ position: absolute; top: 48px; left: 50%; transform: translateX(-50%); width: 80%; max-width: 500px; text-align: center; font-size: 28px; font-weight: 600; line-height: 1.38; letter-spacing: -0.016em; color: #fff; pointer-events: none; z-index: 1; }
.lp-wrapper .highlights__slide-caption sup{ font-size: 11px; vertical-align: super; }
/* コントロールバー（Apple autoplay-progress 完全準拠）
   バブル: 56px高, rgba(232,232,237,0.72), blur 7px, border-radius 32px
   ドット: 8px → active 48px（プログレスバー）
   再生/一時停止: 56px, gap 16px */
.lp-wrapper .highlights__controls{ display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 32px; }
.lp-wrapper .highlights__progress{ display: flex; align-items: center; gap: 8px; height: 56px; padding: 0 16px; background: rgba(232,232,237,0.72); backdrop-filter: blur(7px); -webkit-backdrop-filter: blur(7px); border-radius: 32px; box-shadow: inset 0 0 0 0.5px rgba(0,0,0,0.11); }
.lp-wrapper .highlights__dot{ width: 8px; height: 8px; border-radius: 10px; background: rgba(29,29,31,0.28); cursor: pointer; flex-shrink: 0; transition: width 0.4s var(--ease-apple), background-color 250ms linear; }
.lp-wrapper .highlights__dot.is-active{ width: 48px; background: rgba(29,29,31,0.6); }
.lp-wrapper .highlights__dot:hover:not(.is-active){ background: rgba(0,0,0,0.54); }
.lp-wrapper .highlights__pause-btn{ width: 56px; height: 56px; border-radius: 32px; background: rgba(232,232,237,0.72); backdrop-filter: blur(7px); -webkit-backdrop-filter: blur(7px); border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; color: rgba(29,29,31,1); flex-shrink: 0; box-shadow: inset 0 0 0 0.5px rgba(0,0,0,0.11); transition: background-color 250ms linear; }
.lp-wrapper .highlights__pause-btn:hover{ background: rgba(223,223,227,0.698); }
.lp-wrapper .highlights__pause-btn:active{ background: rgba(193,193,198,0.654); }
.lp-wrapper .highlights__pause-btn svg{ width: 14px; height: 14px; }

@media (max-width: 1068px) {
  .lp-wrapper .highlights__heading{ font-size: 40px; padding-left: 24px; }
  .lp-wrapper .highlights__track{ padding: 0 24px; scroll-padding-left: 24px; gap: 16px; }
  .lp-wrapper .highlights__slide{ width: min(87.5vw, 980px); min-height: 628px; }
}
@media (max-width: 734px) {
  .lp-wrapper .highlights{ padding: 60px 0 36px; }
  .lp-wrapper .highlights__heading{ font-size: 28px; padding: 0 0 28px 20px; }
  .lp-wrapper .highlights__track{ padding: 0 20px; scroll-padding-left: 20px; gap: 12px; }
  /* Apple: モバイルカード 400x480（縦長に変化） */
  .lp-wrapper .highlights__slide{ width: calc(87.5vw); min-height: 480px; border-radius: var(--tile-radius); }
  .lp-wrapper .highlights__slide-caption{ font-size: 17px; top: 24px; }
  /* Apple: モバイル progress-bar-active-width: 32px */
  .lp-wrapper .highlights__dot.is-active{ width: 32px; }
  .lp-wrapper .highlights__progress{ height: 48px; padding: 0 12px; gap: 6px; }
  .lp-wrapper .highlights__pause-btn{ width: 48px; height: 48px; }
  .lp-wrapper .highlights__controls{ gap: 12px; margin-top: 24px; }
}

/* ─── 03: デザインストーリー ─────────────────────────────────── */
.lp-wrapper .design{ background: var(--color-bg-section); overflow: hidden; display: flex; flex-direction: column; }
.lp-wrapper .design__row{ display: grid; grid-template-columns: 1fr 1fr; width: 100%; }
.lp-wrapper .design__col{ display: flex; }
.lp-wrapper .design__col--left{ justify-content: flex-end; padding-right: 16px; padding-left: 40px; }
.lp-wrapper .design__col--right{ justify-content: flex-start; padding-left: 16px; padding-right: 40px; }
.lp-wrapper .design__row--top .design__col--left,  .lp-wrapper .design__row--top .design__col--right{ align-items: flex-start; }
.lp-wrapper .design__row--bottom .design__col--left,  .lp-wrapper .design__row--bottom .design__col--right{ align-items: flex-end; }
.lp-wrapper .design__img{ display: block; width: 100%; max-width: 500px; height: auto; }
.lp-wrapper .design__text{ width: 100%; text-align: center; padding: 56px 40px; display: flex; flex-direction: column; align-items: center; gap: 18px; }
.lp-wrapper .design__headline{ font-size: 64px; font-weight: 700; line-height: 1.07; letter-spacing: -0.009em; color: var(--color-text); }
.lp-wrapper .design__body{ font-size: 17px; font-weight: 400; line-height: 1.6; letter-spacing: -0.022em; color: var(--color-text); max-width: 680px; }
