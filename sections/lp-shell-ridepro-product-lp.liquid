<style>

    /* ===== Design Tokens ===== */
    :root {
      --gold: #A37729;
      --gold-light: #c49535;
      --blue: #0071e3;
      --text: #1d1d1f;
      --text-sub: #6e6e73;
      --bg-white: #ffffff;
      --bg-gray: #f5f5f7;
      --bg-dark: #1d1d1f;
    }

    /* ===== Reset & Base ===== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    .lp-wrapper{ scroll-behavior: smooth; overflow-x: hidden; }
    .lp-wrapper{
      font-family: Helvetica, Arial, sans-serif;
      color: var(--text);
      font-size: 17px;
      line-height: 1.7;
      overflow-x: hidden;
    }
    .lp-wrapper img{ max-width: 100%; height: auto; display: block; }
    .lp-wrapper a{ color: inherit; text-decoration: none; }
    .lp-wrapper section{ width: 100%; }
    .lp-wrapper .container{ max-width: 1200px; margin: 0 auto; padding-left: 40px; padding-right: 40px; }
    .lp-wrapper .section-padding{ padding-top: 100px; padding-bottom: 100px; }
    .lp-wrapper h2.section-title{
      font-size: clamp(28px, 3.5vw, 44px);
      font-weight: 700;
      line-height: 1.25;
      letter-spacing: -0.02em;
    }
    .lp-wrapper .eyebrow{
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 16px;
      display: block;
    }
    @media (max-width: 768px) {
      .lp-wrapper{ font-size: 16px; }
      .lp-wrapper .container{ padding-left: 20px; padding-right: 20px; }
      .lp-wrapper .section-padding{ padding-top: 64px; padding-bottom: 64px; }
    }

    /* ===== Animations ===== */
    .lp-wrapper.js-active .fade-in {
      opacity: 0; transform: translateY(24px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .lp-wrapper .fade-in.visible{ opacity: 1; transform: translateY(0); }
    .lp-wrapper .slide-left{ opacity: 0; transform: translateX(-48px); transition: opacity 0.8s ease, transform 0.8s ease; }
    .lp-wrapper .slide-right{ opacity: 0; transform: translateX(48px);  transition: opacity 0.8s ease, transform 0.8s ease; }
    .lp-wrapper .slide-up{ opacity: 0; transform: translateY(32px);  transition: opacity 0.7s ease, transform 0.7s ease; }
    .lp-wrapper .slide-left.visible,  .lp-wrapper .slide-right.visible,  .lp-wrapper .slide-up.visible{ opacity: 1; transform: none; }
    .lp-wrapper .delay-1{ transition-delay: 0.1s; }
    .lp-wrapper .delay-2{ transition-delay: 0.2s; }
    .lp-wrapper .delay-3{ transition-delay: 0.3s; }
    .lp-wrapper .delay-4{ transition-delay: 0.4s; }

    /* ===== Buttons ===== */
    .lp-wrapper .btn-primary{
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--gold); color: #fff;
      font-size: 17px; font-weight: 700; padding: 18px 44px;
      border-radius: 50px; cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      border: none; letter-spacing: 0.02em;
    }
    .lp-wrapper .btn-primary:hover{ background: var(--gold-light); transform: translateY(-2px); }
    .lp-wrapper .btn-secondary{
      display: inline-block; color: var(--gold); font-size: 15px; font-weight: 500;
      margin-top: 16px; border-bottom: 1px solid currentColor; padding-bottom: 2px;
    }

    /* ===== Hero ===== */
    .lp-wrapper #sec-hero{
      position: relative;
      min-height: 100svh;
      display: flex; align-items: center;
      overflow: hidden;
      background: #0a0a0a;
    }
    .lp-wrapper #sec-hero .hero-bg{
      position: absolute;
      top: -40px; bottom: -40px; left: 0; right: 0;
    }
    .lp-wrapper #sec-hero .hero-bg img{
      width: 100%; height: 100%;
      object-fit: cover;
      opacity: 0.6;
    }
    .lp-wrapper #sec-hero .hero-inner{
      position: relative; z-index: 2;
      max-width: 720px;
      padding: 120px 40px 100px;
    }
    .lp-wrapper #sec-hero .hero-eyebrow{
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 50px;
      padding: 6px 16px;
      font-size: 12px; font-weight: 600;
      letter-spacing: 0.08em;
      color: rgba(255,255,255,0.85);
      margin-bottom: 24px;
    }
    .lp-wrapper #sec-hero h1{
      font-size: clamp(32px, 5.5vw, 68px);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.03em;
      color: #fff;
      margin-bottom: 24px;
    }
    .lp-wrapper #sec-hero h1 em{ color: var(--gold); font-style: normal; }
    .lp-wrapper #sec-hero .hero-sub{
      font-size: clamp(16px, 2vw, 20px);
      color: rgba(255,255,255,0.75);
      line-height: 1.6;
      margin-bottom: 40px;
      max-width: 560px;
    }
    .lp-wrapper .hero-social-proof{
      display: flex; align-items: center; gap: 8px;
      margin-top: 16px; color: rgba(255,255,255,0.7); font-size: 13px;
    }
    .lp-wrapper .hero-social-proof .stars{ color: #f5c518; letter-spacing: 2px; }

    /* ===== Scroll Hint ===== */
    .lp-wrapper .scroll-hint{
      position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      color: rgba(255,255,255,0.45); font-size: 10px; letter-spacing: 0.15em;
      text-transform: uppercase; animation: scroll-bounce 2.2s infinite;
    }
    .lp-wrapper .scroll-hint svg{ width: 20px; height: 20px; }
    @keyframes scroll-bounce {
      0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.45; }
      50%       { transform: translateX(-50%) translateY(8px); opacity: 0.85; }
    }
    @media (max-width: 768px) {
      .lp-wrapper #sec-hero .hero-inner{ padding: 100px 20px 80px; }
    }

    /* ===== Empathy Block（損失の全体像） ===== */
    .lp-wrapper #sec-empathy{
      overflow: hidden;
    }
    .lp-wrapper .empathy-intro{
      padding: 100px 40px 72px;
      max-width: 720px;
      margin: 0 auto;
      text-align: center;
    }
    .lp-wrapper .empathy-intro .eyebrow{ display: block; margin-bottom: 16px; }
    .lp-wrapper .empathy-intro h2{ margin-bottom: 24px; }
    .lp-wrapper .empathy-intro .intro-body{ color: var(--text-sub); font-size: 18px; line-height: 1.85; }

    .lp-wrapper .loss-item{ padding: 80px 0; }
    .lp-wrapper .loss-item:nth-child(2){ background: var(--bg-white); }
    .lp-wrapper .loss-item:nth-child(3){ background: var(--bg-gray); }
    .lp-wrapper .loss-item:nth-child(4){ background: var(--bg-white); }

    .lp-wrapper .loss-item-inner{
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 40px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }
    .lp-wrapper #loss-safety .loss-stat-col{ order: 2; }
    .lp-wrapper #loss-safety .loss-text-col{ order: 1; }

    .lp-wrapper .loss-stat-col{
      background: var(--bg-gray);
      border-radius: 24px;
      padding: 48px 40px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .lp-wrapper #loss-safety .loss-stat-col{ background: var(--bg-white); }

    .lp-wrapper .loss-number{
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 20px;
    }
    .lp-wrapper .loss-stat-value{
      font-size: clamp(48px, 6vw, 72px);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1;
      color: var(--text);
      margin-bottom: 8px;
    }
    .lp-wrapper .loss-stat-value small{ font-size: 0.45em; font-weight: 700; vertical-align: 0.1em; }
    .lp-wrapper .loss-stat-unit{ font-size: 15px; color: var(--text-sub); font-weight: 500; }
    .lp-wrapper .loss-stat-note{ font-size: 11px; color: var(--text-sub); margin-top: 10px; opacity: 0.65; }

    .lp-wrapper .loss-item-badge{
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 18px;
    }
    .lp-wrapper .loss-item-badge::before{
      content: '';
      display: block;
      width: 28px;
      height: 2px;
      background: var(--gold);
    }
    .lp-wrapper .loss-text-col h3{
      font-size: clamp(22px, 2.6vw, 30px);
      font-weight: 700;
      line-height: 1.3;
      letter-spacing: -0.02em;
      color: var(--text);
      margin-bottom: 20px;
    }
    .lp-wrapper .loss-text-col p{
      color: var(--text-sub);
      line-height: 1.9;
      font-size: 16px;
    }
    .lp-wrapper .loss-highlight{
      color: var(--text);
      font-weight: 600;
      background: linear-gradient(to bottom, transparent 60%, rgba(163,119,41,0.18) 60%);
    }

    /* ===== LOSS 01 棒グラフ ===== */
    .lp-wrapper .fuel-bar-chart{
      margin-top: 28px;
      padding: 20px 24px;
      background: #fdf2f1;
      border-radius: 14px;
      border: 1px solid rgba(192,57,43,0.12);
    }
    .lp-wrapper .fuel-chart-title{
      font-size: 11px;
      font-weight: 600;
      color: var(--text-sub);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 14px;
    }
    .lp-wrapper .fuel-bar-row{
      display: grid;
      grid-template-columns: 76px 1fr 68px;
      gap: 10px;
      align-items: center;
      margin-bottom: 9px;
    }
    .lp-wrapper .fuel-bar-row:last-child{ margin-bottom: 0; }
    .lp-wrapper .fuel-bar-label{
      font-size: 12px;
      font-weight: 600;
      color: var(--text);
    }
    .lp-wrapper .fuel-bar-track{
      background: rgba(192,57,43,0.1);
      height: 22px;
      border-radius: 5px;
      overflow: hidden;
    }
    .lp-wrapper .fuel-bar-fill{
      height: 100%;
      width: 0;
      background: #c0392b;
      border-radius: 5px;
      transition: width 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .lp-wrapper .fuel-bar-value{
      font-size: 12px;
      font-weight: 700;
      color: #c0392b;
      text-align: right;
      font-feature-settings: "tnum";
    }
    .lp-wrapper .fuel-chart-note{
      font-size: 10px;
      color: var(--text-sub);
      margin-top: 10px;
      opacity: 0.7;
    }

    /* PANP Bridge */
    .lp-wrapper .panp-bridge{
      background: var(--bg-dark);
      color: #fff;
      position: relative;
      overflow: hidden;
      min-height: 600px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .lp-wrapper .panp-bridge-image{
      position: absolute;
      inset: 0;
      overflow: hidden;
    }
    .lp-wrapper .panp-bridge-image img{
      width: 100%;
      height: calc(100% + 160px);
      margin-top: -80px;
      object-fit: cover;
      object-position: center;
    }
    .lp-wrapper .panp-bridge::after{
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.58);
      pointer-events: none;
    }
    .lp-wrapper .panp-bridge-text{
      position: relative;
      z-index: 2;
      max-width: 640px;
      padding: 96px 40px;
      text-align: center;
    }
    .lp-wrapper .panp-bridge .bridge-lead{
      font-size: clamp(16px, 1.8vw, 19px);
      color: rgba(255,255,255,0.75);
      line-height: 1.8;
      margin-bottom: 24px;
    }
    .lp-wrapper .panp-bridge .bridge-main{
      font-size: clamp(26px, 3.4vw, 42px);
      font-weight: 700;
      color: #fff;
      line-height: 1.3;
      letter-spacing: -0.02em;
      margin-bottom: 44px;
    }
    .lp-wrapper .panp-bridge .bridge-main em{ color: var(--gold); font-style: normal; }

    @media (max-width: 768px) {
      .lp-wrapper .panp-bridge{ min-height: 480px; }
      .lp-wrapper .panp-bridge-text{ padding: 64px 20px; }
    }

    @media (max-width: 768px) {
      .lp-wrapper .empathy-intro{ padding: 64px 20px 48px; text-align: left; }
      .lp-wrapper .loss-item{ padding: 56px 0; }
      .lp-wrapper .loss-item-inner{ grid-template-columns: 1fr; gap: 32px; padding: 0 20px; }
      #loss-safety .loss-stat-col,
      .lp-wrapper #loss-safety .loss-text-col{ order: unset; }
      .lp-wrapper .loss-stat-col{ padding: 32px 24px; }
    }

    /* ===== Solution (full-bleed image + text overlay) ===== */
    .lp-wrapper #sec-solution{
      position: relative;
      overflow: hidden;
    }
    .lp-wrapper .solution-visual{
      position: relative;
      height: clamp(480px, 60vh, 680px);
      overflow: hidden;
      background: #000;
    }
    .lp-wrapper .solution-visual img{
      width: 100%;
      height: calc(100% + 80px);
      margin-top: -40px;
      object-fit: cover;
      transform-origin: center;
    }
    .lp-wrapper .solution-overlay{
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.2) 50%, transparent 100%);
    }
    .lp-wrapper .solution-text{
      position: absolute;
      bottom: 0; left: 0; right: 0;
      padding: 60px 80px;
      color: #fff;
    }
    .lp-wrapper .solution-text .eyebrow{ color: var(--gold); }
    .lp-wrapper .solution-text h2{ color: #fff; max-width: 640px; margin-bottom: 16px; }
    .lp-wrapper .solution-text p{ color: rgba(255,255,255,0.75); max-width: 540px; font-size: 16px; margin-bottom: 28px; }
    @media (max-width: 768px) {
      .lp-wrapper .solution-text{ padding: 40px 20px; }
    }

    /* ===== Mid CTA ===== */
    .lp-wrapper #sec-cta-mid{
      background: var(--bg-dark); color: #fff; padding: 72px 0; text-align: center;
    }
    .lp-wrapper #sec-cta-mid .mid-cta-inner{ max-width: 560px; margin: 0 auto; }
    .lp-wrapper #sec-cta-mid .mid-cta-title{ font-size: clamp(22px, 3vw, 30px); font-weight: 700; line-height: 1.4; margin-bottom: 10px; }
    .lp-wrapper #sec-cta-mid .mid-cta-sub{ font-size: 15px; opacity: 0.7; margin-bottom: 32px; }
    @media (max-width: 768px) { #sec-cta-mid { padding: 56px 0; } }

    /* ===== Accuracy (dark, image left | specs right) ===== */
    .lp-wrapper #sec-features-accuracy{
      background: var(--bg-dark);
      overflow: hidden;
    }
    .lp-wrapper .accuracy-split{
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 560px;
    }
    .lp-wrapper .accuracy-image-col{
      position: relative;
      overflow: hidden;
    }
    .lp-wrapper .accuracy-image-col img{
      width: 100%; height: 100%;
      object-fit: cover;
    }
    .lp-wrapper .accuracy-text-col{
      padding: 80px 64px;
      display: flex; flex-direction: column; justify-content: center;
      color: #fff;
    }
    .lp-wrapper .accuracy-text-col .eyebrow{ color: var(--gold); }
    .lp-wrapper .accuracy-text-col h2{ color: #fff; margin-bottom: 20px; }
    .lp-wrapper .accuracy-text-col p{ color: rgba(255,255,255,0.65); line-height: 1.8; margin-bottom: 32px; }
    .lp-wrapper .accuracy-number{
      font-size: clamp(56px, 8vw, 96px);
      font-weight: 800;
      letter-spacing: -0.04em;
      color: var(--gold);
      line-height: 1;
      margin-bottom: 8px;
    }
    .lp-wrapper .accuracy-number-label{ font-size: 14px; color: rgba(255,255,255,0.5); }
    .lp-wrapper .accuracy-points{ margin-top: 32px; display: flex; flex-direction: column; gap: 16px; }
    .lp-wrapper .accuracy-point{ display: flex; gap: 12px; align-items: flex-start; }
    /* accuracy-point-icon は accuracy-point-icon-wrap に置き換え済み */
    .lp-wrapper .accuracy-point-text strong{ display: block; color: #fff; font-size: 15px; }
    .lp-wrapper .accuracy-point-text span{ font-size: 13px; color: rgba(255,255,255,0.5); }
    @media (max-width: 768px) {
      .lp-wrapper .accuracy-split{ grid-template-columns: 1fr; }
      .lp-wrapper .accuracy-image-col{ height: 300px; }
      .lp-wrapper .accuracy-text-col{ padding: 48px 20px; }
    }

    /* ===== Power/Speed (light gray) ===== */
    .lp-wrapper #sec-features-power{
      background: var(--bg-gray);
    }
    .lp-wrapper .power-header{ text-align: center; margin-bottom: 56px; }
    .lp-wrapper .power-header h2{ margin-bottom: 12px; }
    .lp-wrapper .power-header p{ color: var(--text-sub); max-width: 480px; margin: 0 auto; }
    .lp-wrapper .power-stats{
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-bottom: 56px;
    }
    .lp-wrapper .power-stat-card{
      background: #fff;
      border-radius: 20px;
      padding: 36px 28px;
      text-align: center;
      box-shadow: 0 2px 20px rgba(0,0,0,0.06);
    }
    .lp-wrapper .power-stat-card .stat-number{
      font-size: clamp(36px, 4vw, 52px);
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.03em;
      line-height: 1;
      margin-bottom: 8px;
    }
    .lp-wrapper .power-stat-card .stat-number span{ font-size: 0.45em; font-weight: 500; vertical-align: super; }
    .lp-wrapper .power-stat-card .stat-label{ font-size: 14px; color: var(--text-sub); line-height: 1.5; }
    .lp-wrapper .power-image-wrap{
      border-radius: 24px;
      overflow: hidden;
      height: clamp(280px, 40vw, 440px);
    }
    .lp-wrapper .power-image-wrap img{
      width: 100%; height: 100%;
      object-fit: cover;
    }
    @media (max-width: 768px) {
      .lp-wrapper .power-stats{ grid-template-columns: 1fr; gap: 16px; }
    }

    /* ===== Compatible (3-col image cards) ===== */
    .lp-wrapper #sec-features-compatible{
      background: var(--bg-white);
    }
    .lp-wrapper .compatible-header{ text-align: center; margin-bottom: 48px; }
    .lp-wrapper .compatible-header h2{ margin-bottom: 12px; }
    .lp-wrapper .compatible-header p{ color: var(--text-sub); max-width: 480px; margin: 0 auto; }
    .lp-wrapper .compatible-grid{
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    .lp-wrapper .compatible-card{
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      aspect-ratio: 4/5;
      background: var(--bg-gray);
    }
    .lp-wrapper .compatible-card img{
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    .lp-wrapper .compatible-card:hover img{ transform: scale(1.04); }
    .lp-wrapper .compatible-card-overlay{
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.1) 50%, transparent 100%);
    }
    .lp-wrapper .compatible-card-label{
      position: absolute;
      bottom: 0; left: 0; right: 0;
      padding: 28px 24px;
      color: #fff;
    }
    .lp-wrapper .compatible-card-label .cat-name{
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .lp-wrapper .compatible-card-label .cat-detail{
      font-size: 12px;
      color: rgba(255,255,255,0.65);
      line-height: 1.5;
    }
    .lp-wrapper .compatible-note{
      margin-top: 32px;
      text-align: center;
      font-size: 13px;
      color: var(--text-sub);
    }
    @media (max-width: 768px) {
      .lp-wrapper .compatible-grid{ grid-template-columns: 1fr; gap: 16px; }
      .lp-wrapper .compatible-card{ aspect-ratio: 16/9; }
    }

    /* ===== Demo Video (full-bleed autoplay) ===== */
    .lp-wrapper #sec-demo-video{
      position: relative;
      overflow: hidden;
      background: #000;
      min-height: 580px;
    }
    .lp-wrapper .demo-video-bg{
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .lp-wrapper .demo-video-bg video{
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      pointer-events: none;
    }
    .lp-wrapper .demo-video-overlay{
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(
        to bottom,
        rgba(0,0,0,0.55) 0%,
        rgba(0,0,0,0.25) 50%,
        rgba(0,0,0,0.55) 100%
      );
    }
    .lp-wrapper .demo-video-content{
      position: relative;
      z-index: 2;
      min-height: 580px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 60px 40px;
    }
    .lp-wrapper .demo-video-content .eyebrow{ color: var(--gold); }
    .lp-wrapper .demo-video-content h2{ color: #fff; margin: 16px 0 12px; }
    .lp-wrapper .demo-video-content p{ color: rgba(255,255,255,0.72); font-size: 17px; }
    .lp-wrapper .demo-time-bar{
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      margin-top: 28px;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 14px;
      overflow: hidden;
      background: rgba(0,0,0,0.3);
      max-width: 400px;
      width: 100%;
    }
    .lp-wrapper .demo-time-item{
      padding: 16px 12px 14px;
      text-align: center;
      border-right: 1px solid rgba(255,255,255,0.12);
      border-bottom: 1px solid rgba(255,255,255,0.12);
    }
    .lp-wrapper .demo-time-item:nth-child(2n){ border-right: none; }
    .demo-time-item:nth-child(3),
    .lp-wrapper .demo-time-item:nth-child(4){ border-bottom: none; }
    .lp-wrapper .demo-time-label{
      font-size: 11px;
      font-weight: 600;
