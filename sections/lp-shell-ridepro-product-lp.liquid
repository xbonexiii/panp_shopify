<script>
(function () {
  var targets = document.querySelectorAll('.slide-left, .slide-right, .slide-up, .fade-in');
  if (!('IntersectionObserver' in window)) {
    targets.forEach(function (el) { el.classList.add('visible'); }); return;
  }
  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.12 });
  targets.forEach(function (el) { obs.observe(el); });
})();
</script>

<script>
(function () {
  if (window.matchMedia('(max-width: 768px)').matches) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var els = Array.prototype.slice.call(document.querySelectorAll('.parallax-bg'));
  var STRENGTH = 40; var ticking = false;
  function update() {
    var vh = window.innerHeight;
    els.forEach(function (img) {
      var section = img.parentElement;
      var rect = section.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > vh) return;
      var offset = (rect.top + rect.height / 2 - vh / 2) / (vh + rect.height) * STRENGTH * 2;
      img.style.transform = 'translateY(' + offset.toFixed(2) + 'px)';
    });
    ticking = false;
  }
  window.addEventListener('scroll', function () {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
  update();
})();
</script>

<script>
(function () {
  var el = document.getElementById('sticky-cta');
  if (!el) return;
  var trigger = document.getElementById('sec-solution');
  var finalCta = document.getElementById('sec-cta');
  if (!trigger) return;

  function updateSticky() {
    var triggerBottom = trigger.getBoundingClientRect().bottom;
    var pastTrigger = triggerBottom < 0;
    var atFinal = finalCta && finalCta.getBoundingClientRect().top < window.innerHeight * 0.9;
    el.style.display = (!atFinal && pastTrigger) ? 'block' : 'none';
  }

  window.addEventListener('scroll', updateSticky, { passive: true });
  updateSticky();
})();
</script>

