    }
    .lp-wrapper .stat-icon svg{ width: 26px; height: 26px; stroke: var(--gold); fill: none; }

    /* ===== Accuracy Icon (SEC 5) ===== */
    .lp-wrapper .accuracy-point-icon-wrap{
      width: 28px; height: 28px; flex-shrink: 0;
      background: rgba(163,119,41,0.15);
      border-radius: 7px;
      display: flex; align-items: center; justify-content: center;
      margin-top: 1px;
    }
    .lp-wrapper .accuracy-point-icon-wrap svg{ width: 15px; height: 15px; stroke: var(--gold); fill: none; }

    /* ===== Howto Icon Badge (SEC 8) ===== */
    .lp-wrapper .howto-step-badge{
      display: flex; align-items: center; gap: 10px;
      margin-bottom: 12px;
    }
    .lp-wrapper .howto-icon-circle{
      width: 40px; height: 40px; flex-shrink: 0;
      background: var(--gold);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
    }
    .lp-wrapper .howto-icon-circle svg{ width: 18px; height: 18px; stroke: #fff; fill: none;
