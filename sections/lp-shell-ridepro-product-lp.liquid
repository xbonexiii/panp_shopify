    }
    .lp-wrapper #sticky-cta .sticky-note{ text-align: center; font-size: 11px; color: rgba(255,255,255,0.55); margin-top: 6px; }
    @media (min-width: 769px) { #sticky-cta { display: none !important; } }
  

