<script>
/* デモ動画: autoplay が blocked された場合の強制再生フォールバック */
(function () {
  var v = document.getElementById('demo-video-player');
  if (!v) return;
  v.muted = true;
  function tryPlay() {
    var p = v.play();
    if (p && typeof p.catch === 'function') {
      p.catch(function () {
        /* ユーザーが最初にページに触れたら再生 */
        document.addEventListener('touchstart', function () { v.play(); }, { once: true });
        document.addEventListener('click',      function () { v.play(); }, { once: true });
      });
    }
  }
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    tryPlay();
  } else {
    document.addEventListener('DOMContentLoaded', tryPlay);
  }
})();
</script>


<script>
/* カウントダウンエフェクト（sec-demo-video 入場時） */
(function () {
  var section = document.getElementById('sec-demo-video');
  if (!section || !('IntersectionObserver' in window)) return;
  var fired = false;
  new IntersectionObserver(function (entries) {
    if (fired || !entries[0].isIntersecting) return;
    fired = true;
    var nums = section.querySelectorAll('.time-num');
    nums.forEach(function (el, i) {
      var target = parseInt(el.getAttribute('data-target'), 10);
      var duration = 1200;
      var delay = i * 120;
      var startTime = null;
      setTimeout(function () {
        function step(ts) {
          if (!startTime) startTime = ts;
          var elapsed = ts - startTime;
          var progress = Math.min(elapsed / duration, 1);
          /* ease-out cubic */
          var eased = 1 - Math.pow(1 - progress, 3);
          var current = Math.round(target * eased);
          el.textContent = current;
          if (progress < 1) requestAnimationFrame(step);
          else el.textContent = target;
        }
        requestAnimationFrame(step);
      }, delay);
    });
  }, { threshold: 0.4 }).observe(section);
})();
</script>

<script>
(function () {
  var bars = document.querySelectorAll('.fuel-bar-fill');
  if (!bars.length) return;
  var triggered = false;
  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting && !triggered) {
        triggered = true;
        bars.forEach(function (bar) {
          bar.style.width = bar.getAttribute('data-width') + '%';
        });
        obs.disconnect();
      }
    });
  }, { threshold: 0.3 });
  obs.observe(document.querySelector('.fuel-bar-chart'));
})();
</script>
