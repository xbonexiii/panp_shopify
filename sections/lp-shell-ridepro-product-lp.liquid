      .lp-wrapper .howto-connector{
        position: absolute; top: 20px; left: calc(25% - 0px); right: calc(25% - 0px);
        height: 2px; background: linear-gradient(to right, var(--gold), rgba(163,119,41,0.2));
        pointer-events: none; z-index: 0;
