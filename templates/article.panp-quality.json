        "heading_P7CWDH": {
          "type": "heading",
          "settings": {
            "heading": "なぜ今、“本物の品質”が求められるのか",
            "heading_size": "h1"
          }
        },
        "text_eEyyAp": {
          "type": "text",
          "settings": {
            "text": "<p>空気入れは、日常の移動やレジャーの安全・快適性に直結する重要な道具です。だからこそPANPは、価格や見た目ではなく、<strong>使った人にとって本当に信頼できる品質</strong>を最優先に設計・製造しています。本記事では、PANPの品質に関する取り組みを「管理」「証明」「評価」の3つの観点からご紹介します。</p>"
          }
        }
      },
      "block_order": [
        "heading_P7CWDH",
        "text_eEyyAp"
      ],
      "name": "t:sections.rich-text.presets.name",
      "settings": {
